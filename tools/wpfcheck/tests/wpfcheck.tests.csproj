<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType><IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CA1416;CS8002;NU1701;xUnit1031;xUnit1004;xUnit2013</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../tests/PokeCorner.App.Tests/**/*.cs" Exclude="../../../tests/PokeCorner.App.Tests/obj/**;../../../tests/PokeCorner.App.Tests/bin/**" />
    <Reference Include="$(NuGetPackageRoot)microsoft.windowsdesktop.app.ref/8.0.34/ref/net8.0/*.dll" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <Using Include="Xunit" />
    <ProjectReference Include="../wpfcheck.csproj" />
    <ProjectReference Include="../../../src/PokeCorner.Core/PokeCorner.Core.csproj" />
  </ItemGroup>
</Project>
