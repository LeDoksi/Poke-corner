<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Theme/ThemeRenderingTests.cs instantiates the real WPF views on a dedicated STA
       thread, so this project needs the WPF assemblies. A FrameworkReference is used rather
       than <UseWPF>true</UseWPF> deliberately: UseWPF also rewrites the project's implicit
       global usings (dropping System.IO and pulling in System.Windows.Shapes, whose Path
       collides with System.IO.Path), which would break existing test files. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PokeCorner.App\PokeCorner.App.csproj" />
  </ItemGroup>

</Project>
