<Window x:Class="PokeCorner.App.Onboarding.OnboardingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PokéCorner — знакомство" Width="840" Height="650" MinWidth="360" MinHeight="320"
 Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" PreviewKeyDown="Window_PreviewKeyDown">
 <Grid Margin="24,18">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock x:Name="StepCounterText" Style="{StaticResource StatLabelTextStyle}"/>
    <TextBlock x:Name="TitleText" Style="{StaticResource ScreenTitleTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <TextBlock x:Name="BodyText" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,18"/>
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="290"><StackPanel x:Name="Illustration" Orientation="Horizontal" HorizontalAlignment="Center"/></Viewbox>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="1" Margin="0,10,0,10">
   <StackPanel x:Name="StepDotsPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
   <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource DangerTextBrush}" AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0"/>
  </StackPanel>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
   <Button x:Name="SkipButton" Content="Позже" Click="SkipButton_Click" Margin="0,0,8,6" Style="{StaticResource SecondaryButtonStyle}"/>
   <Button x:Name="BackButton" Content="Назад" Click="BackButton_Click" Margin="0,0,8,6" Style="{StaticResource SecondaryButtonStyle}"/>
   <Button x:Name="NextButton" Content="Дальше" Click="NextButton_Click" Margin="0,0,0,6" Style="{StaticResource UiPrimaryButtonStyle}"/>
  </WrapPanel>
 </Grid>
</Window>
