<Window x:Class="PokeCorner.App.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokéCorner — обучение" Width="450" Height="380"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <!-- Fixed-size window; the body text sits in the star row, vertically centered, so short
         and long steps both read as deliberately composed. -->
    <Grid Margin="16">
        <Border Style="{StaticResource CardStyle}" Padding="20,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: the same pokéball glyph vocabulary the Pokédex header and the
                     collection's sprite placeholder already use, rather than a new icon. -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="38" Height="38" VerticalAlignment="Top" Margin="0,2,13,0">
                        <Ellipse Stroke="{StaticResource AccentRedBrush}" StrokeThickness="2.5" />
                        <Border Height="2.5" Background="{StaticResource AccentRedBrush}" VerticalAlignment="Center" />
                        <Ellipse Width="13" Height="13" Fill="{StaticResource CardBackgroundBrush}"
                                 Stroke="{StaticResource AccentRedBrush}" StrokeThickness="2.5"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StepCounterText" Style="{StaticResource StatLabelTextStyle}" />
                        <TextBlock x:Name="TitleText" Style="{StaticResource ScreenTitleTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource WellStyle}" Padding="14,12">
                    <TextBlock x:Name="BodyText" TextWrapping="Wrap" VerticalAlignment="Center"
                               LineHeight="19" LineStackingStrategy="BlockLineHeight"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <!-- Progress dots are built and re-tinted in code-behind from the same
                         Steps array that drives the text, so they can never disagree about
                         how many steps there are. -->
                    <StackPanel x:Name="StepDotsPanel" Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SkipButton" Content="Пропустить" Click="SkipButton_Click" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Name="BackButton" Content="Назад" Click="BackButton_Click" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Name="NextButton" Content="Далее" Click="NextButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
