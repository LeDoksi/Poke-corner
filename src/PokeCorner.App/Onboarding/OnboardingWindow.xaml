<Window x:Class="PokeCorner.App.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokéCorner — обучение" Width="420" Height="300"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="16">
        <Border Style="{StaticResource CardStyle}" Padding="18">
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource ScreenTitleTextStyle}" Margin="0,0,0,10"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="BodyText" TextWrapping="Wrap" Height="110"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button x:Name="SkipButton" Content="Пропустить" Click="SkipButton_Click" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Name="BackButton" Content="Назад" Click="BackButton_Click" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Name="NextButton" Content="Далее" Click="NextButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
