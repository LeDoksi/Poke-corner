<Window x:Class="PokeCorner.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="NoResize"
        SizeToContent="Manual">
    <Window.Resources>
        <!-- Shared "thought bubble" backing shape for the petting reaction and the mood cloud, so
             a bare glyph never has to read against a busy desktop on its own. -->
        <Style x:Key="ThoughtBubbleStyle" TargetType="Border">
            <Setter Property="Background" Value="#E6FFFFFF" />
            <Setter Property="BorderBrush" Value="#33000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Resources>
    <!-- The window is deliberately LARGER than the configured pet size (see
         OverlayWindow.SpriteScaleHeadroom) and the sprite is centred inside it. A WPF window
         clips its content to its own client area, so with the sprite filling the window
         exactly, every scale-up reaction — the pet bounce, the feed bounce, the evolution
         flash — was shaved off at the window edge. The surrounding headroom is transparent
         and has no hit-test surface, so it costs nothing but room to grow into. -->
    <Grid>
        <Image x:Name="SpriteImage" Stretch="Uniform"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               MouseLeftButtonDown="SpriteImage_MouseLeftButtonDown"
               MouseMove="SpriteImage_MouseMove"
               MouseLeftButtonUp="SpriteImage_MouseLeftButtonUp"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SpriteScaleTransform" ScaleX="1" ScaleY="1" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <Canvas x:Name="HeartEffects" HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False">
            <Path x:Name="HeartLeft" Fill="#FF6480" Opacity="0" Data="M 4,0 L 8,0 8,2 10,2 10,0 14,0 14,2 16,2 16,6 14,6 14,8 12,8 12,10 10,10 10,12 8,12 8,10 6,10 6,8 4,8 4,6 2,6 2,2 4,2 Z" />
            <Path x:Name="HeartMiddle" Fill="#FF6480" Opacity="0" Data="M 4,0 L 8,0 8,2 10,2 10,0 14,0 14,2 16,2 16,6 14,6 14,8 12,8 12,10 10,10 10,12 8,12 8,10 6,10 6,8 4,8 4,6 2,6 2,2 4,2 Z" />
            <Path x:Name="HeartRight" Fill="#FF6480" Opacity="0" Data="M 4,0 L 8,0 8,2 10,2 10,0 14,0 14,2 16,2 16,6 14,6 14,8 12,8 12,10 10,10 10,12 8,12 8,10 6,10 6,8 4,8 4,6 2,6 2,2 4,2 Z" />
        </Canvas>
        <Canvas x:Name="CrumbEffects" HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False">
            <Rectangle x:Name="CrumbLeft" Width="5" Height="5" Fill="#D39A5B" Opacity="0" />
            <Rectangle x:Name="CrumbMiddle" Width="4" Height="4" Fill="#E5B579" Opacity="0" />
            <Rectangle x:Name="CrumbRight" Width="5" Height="5" Fill="#D39A5B" Opacity="0" />
        </Canvas>
        <Border x:Name="ThoughtBubble" Style="{StaticResource ThoughtBubbleStyle}"
                HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
            <TextBlock x:Name="ThoughtStage" Foreground="#273447" FontSize="17" />
        </Border>

    </Grid>
</Window>
