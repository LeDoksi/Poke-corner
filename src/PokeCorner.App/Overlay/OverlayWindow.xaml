<Window x:Class="PokeCorner.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual">
    <Grid>
        <Image x:Name="SpriteImage" Stretch="Uniform" MouseLeftButtonDown="SpriteImage_MouseLeftButtonDown" />
    </Grid>
</Window>
