<Window x:Class="PokeCorner.App.Overlay.ProgressPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="60"
        SizeToContent="Height">
    <!-- Three filling CIRCLES stacked one above another, standing to the LEFT of the pet.

         This is the shape the panel had two revisions ago, restored on the user's own
         correction: an intervening redesign turned the gauges into three vertical bars in a
         horizontal row, which is not what was asked for. What IS new here is the arrangement —
         the gauges are a vertical COLUMN now, not a row, so the panel is a narrow strip beside
         the sprite rather than a wide block. The narrow footprint is what makes "to the left of
         the pet" work on a bottom-right-cornered pet without fighting the taskbar.

         Each ring carries its concept icon INSIDE it (CatchIconStyle / EvolutionIconStyle /
         TreatIconStyle from PokedexTheme.xaml — the same glyphs the in-app "Прогресс" card
         uses, which is the whole point of factoring them into the theme dictionary). A ring
         has a hole; putting the icon in it costs no extra space and makes each gauge
         self-identifying, which three anonymous rings would not be.

         The arcs are plain Ellipses driven by StrokeDashArray (see the code-behind) rather
         than Path/ArcSegment geometry rebuilt per update: same visual, no geometry math, and
         nothing to keep in sync when a size changes.

         SizeToContent stays Height-only with an explicit Width, as the prior fix established;
         the explicit number is what PositionLeftOf offsets against. -->
    <Border Background="#E60D1120" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="10,10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>

            <Grid Width="36" Height="36" Margin="0,0,0,9" ToolTip="Прогресс до следующей поимки">
                <Ellipse Stroke="{StaticResource CardHoverBackgroundBrush}" StrokeThickness="4.5" />
                <Ellipse x:Name="CatchArc" Stroke="{StaticResource AccentRedBrush}" StrokeThickness="4.5"
                         StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#E8384F" BlurRadius="7" ShadowDepth="0" Opacity="0.7" />
                    </Ellipse.Effect>
                </Ellipse>
                <ContentControl Style="{StaticResource CatchIconStyle}" Width="15" Height="15"
                                Foreground="{StaticResource AccentRedBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- Named + tooltip assigned from code-behind: this gauge has three readings, not
                 one (in-progress / never evolves / final form), and a ring has no room for the
                 words. The tooltip is where the distinction is spelled out on the desktop. -->
            <Grid x:Name="EvolutionGauge" Width="36" Height="36" Margin="0,0,0,9"
                  ToolTip="Прогресс до следующей эволюции">
                <Ellipse Stroke="{StaticResource CardHoverBackgroundBrush}" StrokeThickness="4.5" />
                <Ellipse x:Name="EvolutionArc" Stroke="{StaticResource RarityRareBrush}" StrokeThickness="4.5"
                         StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#5B9DFF" BlurRadius="7" ShadowDepth="0" Opacity="0.7" />
                    </Ellipse.Effect>
                </Ellipse>
                <ContentControl Style="{StaticResource EvolutionIconStyle}" Width="14" Height="14"
                                Foreground="{StaticResource RarityRareBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <Grid Width="36" Height="36" ToolTip="Прогресс до следующего лакомства">
                <Ellipse Stroke="{StaticResource CardHoverBackgroundBrush}" StrokeThickness="4.5" />
                <Ellipse x:Name="TreatArc" Stroke="{StaticResource RarityUncommonBrush}" StrokeThickness="4.5"
                         StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#4CD787" BlurRadius="7" ShadowDepth="0" Opacity="0.6" />
                    </Ellipse.Effect>
                </Ellipse>
                <ContentControl Style="{StaticResource TreatIconStyle}" Width="15" Height="15"
                                Foreground="{StaticResource RarityUncommonBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

        </StackPanel>
    </Border>
</Window>
