<Window x:Class="PokeCorner.App.Overlay.ProgressPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="134"
        SizeToContent="Height">
    <!-- Three radial mini-gauges in a row, not three stacked linear bars.
         The linear trio is right for the in-app Collection card, which has the width to let
         each bar breathe and room for a label beside it. Shrunk to a floating on-desktop HUD
         it just read as a cramped miniature of that card: three anonymous 8px slivers, no way
         to tell which was which, and a tall dark box hanging off the pet. Gauges are the
         native shape for a small always-on widget — they fill the square footprint the pet
         already occupies, each one carries its own glyph so the metric is identifiable, and
         the panel is half as tall.

         The arcs are plain Ellipses driven by StrokeDashArray (see the code-behind) rather
         than Path/ArcSegment geometry rebuilt per update: same visual, no geometry math, and
         nothing to keep in sync when a size changes.

         SizeToContent stays Height-only with an explicit Width, as the prior fix established.
         Unlike the old ProgressBars these gauges DO have an intrinsic width, so WidthAndHeight
         would no longer collapse the panel — but there is nothing to gain from measuring a
         fixed-size row, and the explicit number is what PositionBelow centres against. -->
    <Border Background="#E60D1120" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="11,9">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.5" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">

            <Grid Width="30" Height="30" Margin="0,0,10,0" ToolTip="Прогресс до следующей поимки">
                <Ellipse Stroke="{StaticResource CardHoverBackgroundBrush}" StrokeThickness="4.5" />
                <Ellipse x:Name="CatchArc" Stroke="{StaticResource AccentRedBrush}" StrokeThickness="4.5"
                         StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#E8384F" BlurRadius="7" ShadowDepth="0" Opacity="0.7" />
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="&#x25C9;" FontFamily="Segoe UI Symbol" FontSize="10"
                           Foreground="{StaticResource AccentRedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <Grid Width="30" Height="30" Margin="0,0,10,0" ToolTip="Прогресс до следующей эволюции">
                <Ellipse Stroke="{StaticResource CardHoverBackgroundBrush}" StrokeThickness="4.5" />
                <Ellipse x:Name="EvolutionArc" Stroke="{StaticResource RarityRareBrush}" StrokeThickness="4.5"
                         StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#5B9DFF" BlurRadius="7" ShadowDepth="0" Opacity="0.7" />
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="&#x25B2;" FontFamily="Segoe UI Symbol" FontSize="9"
                           Foreground="{StaticResource RarityRareBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <Grid Width="30" Height="30" ToolTip="Прогресс до следующего лакомства">
                <Ellipse Stroke="{StaticResource CardHoverBackgroundBrush}" StrokeThickness="4.5" />
                <Ellipse x:Name="TreatArc" Stroke="{StaticResource RarityUncommonBrush}" StrokeThickness="4.5"
                         StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#4CD787" BlurRadius="7" ShadowDepth="0" Opacity="0.7" />
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="&#x2764;" FontFamily="Segoe UI Symbol" FontSize="9"
                           Foreground="{StaticResource RarityUncommonBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

        </StackPanel>
    </Border>
</Window>
