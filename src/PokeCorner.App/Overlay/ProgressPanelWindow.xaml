<Window x:Class="PokeCorner.App.Overlay.ProgressPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        Width="60"
        SizeToContent="Height">
    <!-- Optional desktop strip beside the pet (Settings → «Показывать прогресс рядом с питомцем»).
         It mirrors the corner's three rows exactly: same icons (Assets/UiSystem), same order,
         same v2 values (care for the next evolution, next pokéball, next treat), Night Diary
         palette. Rings are Ellipses driven by StrokeDashArray from code-behind. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PokeCorner;component/Theme/NightDiary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="RingTrack" TargetType="Ellipse">
                <Setter Property="Stroke" Value="{StaticResource NdRaisedBrush}" />
                <Setter Property="StrokeThickness" Value="4" />
            </Style>
            <Style x:Key="RingArc" TargetType="Ellipse">
                <Setter Property="StrokeThickness" Value="4" />
                <Setter Property="StrokeDashCap" Value="Round" />
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="-90" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RingIcon" TargetType="Image">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{StaticResource NdSurfaceBrush}" BorderBrush="{StaticResource NdBorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="10">
        <StackPanel>
            <Grid x:Name="EvolutionGauge" Width="36" Height="36" Margin="0,0,0,9" ToolTip="Уход для эволюции">
                <Ellipse Style="{StaticResource RingTrack}" />
                <Ellipse x:Name="EvolutionArc" Style="{StaticResource RingArc}" Stroke="{StaticResource NdLavenderBrush}" />
                <Image Style="{StaticResource RingIcon}" Source="/PokeCorner;component/Assets/UiSystem/care.png" />
            </Grid>
            <Grid x:Name="CatchGauge" Width="36" Height="36" Margin="0,0,0,9" ToolTip="Следующий покебол">
                <Ellipse Style="{StaticResource RingTrack}" />
                <Ellipse x:Name="CatchArc" Style="{StaticResource RingArc}" Stroke="{StaticResource NdApricotBrush}" />
                <Image Style="{StaticResource RingIcon}" Source="/PokeCorner;component/Assets/UiSystem/catch-ball.png" />
            </Grid>
            <Grid x:Name="TreatGauge" Width="36" Height="36" ToolTip="Лакомства">
                <Ellipse Style="{StaticResource RingTrack}" />
                <Ellipse x:Name="TreatArc" Style="{StaticResource RingArc}" Stroke="{StaticResource NdSuccessBrush}" />
                <Image Style="{StaticResource RingIcon}" Source="/PokeCorner;component/Assets/UiSystem/treat.png" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
