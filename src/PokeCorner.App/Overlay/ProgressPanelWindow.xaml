<Window x:Class="PokeCorner.App.Overlay.ProgressPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="86"
        SizeToContent="Height">
    <!-- Three short VERTICAL bars standing side by side, sitting to the LEFT of the pet.
         This replaces the radial-gauge row that hung below it: the gauges read fine in
         isolation but a horizontal strip under the sprite fought the taskbar for the one
         piece of screen the pet's default bottom-right corner has least of, and an arc's
         fill level is genuinely harder to eyeball at 30px than a bar's height. Standing the
         bars up and moving the whole panel beside the pet uses the empty desktop the sprite
         has plenty of, and keeps the panel's footprint tall-and-narrow instead of wide.

         Each bar carries its concept icon (CatchIconStyle / EvolutionIconStyle /
         TreatIconStyle from PokedexTheme.xaml) ABOVE it rather than beside it: at this
         width there is no room alongside an 8px bar, and stacking keeps each column a
         self-contained icon-over-bar unit. They are the same glyphs the in-app "Прогресс"
         card uses, which is the entire point of factoring them into the theme dictionary.

         Fill is a bottom-anchored Border whose Height the code-behind sets — bars grow
         upward from the floor, the direction the metric itself reads as "filling up".

         SizeToContent stays Height-only with an explicit Width, as the prior fix
         established; the explicit number is what PositionLeftOf offsets against. -->
    <Border Background="#E60D1120" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="12,10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.5" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">

            <StackPanel Margin="0,0,10,0" ToolTip="Прогресс до следующей поимки">
                <ContentControl Style="{StaticResource CatchIconStyle}" Width="13" Height="13"
                                Foreground="{StaticResource AccentRedBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,5" />
                <Grid x:Name="CatchTrack" Width="9" Height="46">
                    <Border CornerRadius="4.5" Background="{StaticResource CardHoverBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" />
                    <Border x:Name="CatchFill" CornerRadius="4.5" VerticalAlignment="Bottom" Height="0"
                            Background="{StaticResource AccentRedBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="#E8384F" BlurRadius="7" ShadowDepth="0" Opacity="0.7" />
                        </Border.Effect>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Margin="0,0,10,0" ToolTip="Прогресс до следующей эволюции">
                <ContentControl Style="{StaticResource EvolutionIconStyle}" Width="13" Height="13"
                                Foreground="{StaticResource RarityRareBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,5" />
                <Grid x:Name="EvolutionTrack" Width="9" Height="46">
                    <Border CornerRadius="4.5" Background="{StaticResource CardHoverBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" />
                    <Border x:Name="EvolutionFill" CornerRadius="4.5" VerticalAlignment="Bottom" Height="0"
                            Background="{StaticResource RarityRareBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="#5B9DFF" BlurRadius="7" ShadowDepth="0" Opacity="0.7" />
                        </Border.Effect>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel ToolTip="Прогресс до следующего лакомства">
                <ContentControl Style="{StaticResource TreatIconStyle}" Width="13" Height="13"
                                Foreground="{StaticResource RarityUncommonBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,5" />
                <Grid x:Name="TreatTrack" Width="9" Height="46">
                    <Border CornerRadius="4.5" Background="{StaticResource CardHoverBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" />
                    <Border x:Name="TreatFill" CornerRadius="4.5" VerticalAlignment="Bottom" Height="0"
                            Background="{StaticResource RarityUncommonBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="#4CD787" BlurRadius="7" ShadowDepth="0" Opacity="0.6" />
                        </Border.Effect>
                    </Border>
                </Grid>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
