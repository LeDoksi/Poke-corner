<Window x:Class="PokeCorner.App.Popup.PokemonDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokéCorner" Width="360" SizeToContent="Height"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <!-- What a Pokédex card opens into. The grid card is deliberately small and uniform
         (sprite + dex number + rarity), so everything that does not fit there lives here:
         the catch date and nature the old roster rows carried, and the three actions that
         used to sit inline on every one of those rows — Выбрать, Отпустить and the favourite
         star. Moving them off the cards is what let the roster and the species grid collapse
         into one browsable list instead of two overlapping ones.

         Same modal shape and scale as ConfirmDialog: standard OS chrome (this is short-lived
         and its close button is a legitimate "never mind"), AppWindowStyle for the dark
         theme, and CardStyle/WellStyle inside so it reads as part of the app. -->
    <Grid Margin="16">
        <Border Style="{StaticResource CardStyle}" Padding="18,16">
            <StackPanel>

                <Grid Height="120" Margin="0,0,0,10">
                    <Ellipse Width="170" Height="112" Fill="{StaticResource SpotlightBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image x:Name="SpriteImage" Width="104" Height="104"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Grid x:Name="SpritePlaceholder" Width="64" Height="64"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5">
                        <Ellipse Stroke="{StaticResource MutedTextBrush}" StrokeThickness="3" />
                        <Border Height="3" Background="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <Ellipse Width="20" Height="20" Fill="{StaticResource WindowBackgroundBrush}"
                                 Stroke="{StaticResource MutedTextBrush}" StrokeThickness="3"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <Border x:Name="ShinyBadge" Style="{StaticResource PillStyle}" Visibility="Collapsed"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            BorderBrush="{StaticResource AccentGoldBrush}"
                            ToolTip="Шайни — редкая цветовая форма">
                        <TextBlock Text="✨ Shiny" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentGoldBrush}" />
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock x:Name="DexNumberText" Style="{StaticResource MetaTextStyle}"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock x:Name="SpeciesNameText" Style="{StaticResource ScreenTitleTextStyle}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Border x:Name="RarityPill" Style="{StaticResource PillStyle}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RarityDot" Width="6" Height="6"
                                     VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock x:Name="RarityText" FontSize="10" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="FavoriteBadge" Style="{StaticResource PillStyle}" Margin="0,0,6,0"
                            BorderBrush="{StaticResource AccentGoldBrush}" Visibility="Collapsed"
                            ToolTip="Избранный — всегда в начале списка">
                        <TextBlock Text="Избранное" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentGoldBrush}" />
                    </Border>
                    <Border x:Name="ActiveBadge" Style="{StaticResource PillStyle}" Margin="0,0,6,0"
                            BorderBrush="{StaticResource AccentGoldBrush}" Visibility="Collapsed"
                            ToolTip="Сейчас на рабочем столе">
                        <TextBlock Text="На столе" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentGoldBrush}" />
                    </Border>
                    <Border x:Name="UnavailableBadge" Style="{StaticResource PillStyle}"
                            BorderBrush="{StaticResource AccentRedBrush}" Visibility="Collapsed">
                        <TextBlock Text="Обиделся" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentRedBrush}" />
                    </Border>
                </WrapPanel>

                <Border Style="{StaticResource WellStyle}" Padding="13,10" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Характер" Style="{StaticResource MetaTextStyle}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="NatureText" Style="{StaticResource MetaTextStyle}"
                                       HorizontalAlignment="Right" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Поймана" Style="{StaticResource MetaTextStyle}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="CaughtAtText" Style="{StaticResource MetaTextStyle}"
                                       HorizontalAlignment="Right" FontWeight="SemiBold" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ContentControl Style="{StaticResource EvolutionIconStyle}" Width="12" Height="12"
                                            Foreground="{StaticResource RarityRareBrush}"
                                            VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="До эволюции" Style="{StaticResource MetaTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ProgressBar x:Name="EvolutionBar" Style="{StaticResource SlimProgressBarStyle}"
                                     Minimum="0" Maximum="1"
                                     ToolTip="Прогресс до следующей эволюции этого покемона" />
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The star pin, moved here off the roster rows. One Path with both Fill
                         and Stroke bound covers both states: gold-on-gold when pinned, hollow
                         with a muted outline when not. -->
                    <Button x:Name="FavoriteButton" Grid.Column="0" Style="{StaticResource FavoriteToggleStyle}"
                            Click="FavoriteButton_Click" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Path x:Name="FavoriteStar" Width="17" Height="17" Stretch="Uniform"
                              StrokeThickness="1.6" StrokeLineJoin="Round"
                              Data="M12,2 L15.09,8.26 L22,9.27 L17,14.14 L18.18,21.02 L12,17.77 L5.82,21.02 L7,14.14 L2,9.27 L8.91,8.26 Z" />
                    </Button>

                    <Button x:Name="SelectButton" Grid.Column="1" Content="Выбрать" Click="SelectButton_Click"
                            Padding="12,7" Margin="0,0,8,0"
                            ToolTip="Сделать этого покемона активным — он появится на рабочем столе" />

                    <Button x:Name="ReleaseButton" Grid.Column="2" Content="Отпустить" Click="ReleaseButton_Click"
                            Padding="12,7" Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Насовсем удалить этого покемона из коллекции" />
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>
