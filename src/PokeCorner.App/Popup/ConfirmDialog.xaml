<Window x:Class="PokeCorner.App.Popup.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokéCorner" Width="420" SizeToContent="Height"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False">
    <!-- A themed stand-in for MessageBox, whose stock light chrome would clash with the dark
         app at the one moment it asks to confirm something irreversible. DialogWindowStyle also
         replaces the OS title bar. No close (X) on purpose: Отмена is right there, and maps to
         Esc via IsCancel below. -->
    <Grid Margin="16">
        <Border Style="{StaticResource CardStyle}" Padding="20,18">
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource ScreenTitleTextStyle}"
                           TextWrapping="Wrap" Margin="0,0,0,10" />

                <Border Style="{StaticResource WellStyle}" Padding="14,12">
                    <TextBlock x:Name="BodyText" TextWrapping="Wrap"
                               LineHeight="19" LineStackingStrategy="BlockLineHeight"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="CancelButton" Content="Отмена" Click="CancelButton_Click"
                            IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <!-- Confirm gets the unkeyed (primary/red) button look and is deliberately
                         NOT IsDefault: nothing destructive should be one stray Enter away. -->
                    <Button x:Name="ConfirmButton" Click="ConfirmButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
