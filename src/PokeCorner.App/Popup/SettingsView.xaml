<UserControl x:Class="PokeCorner.App.Popup.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14">

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Режим ухода" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ComboBox x:Name="CareModeCombo" SelectionChanged="CareModeCombo_SelectionChanged">
                        <ComboBoxItem Content="Chill" />
                        <ComboBoxItem Content="Hardcore" />
                    </ComboBox>
                    <TextBlock Text="Chill — без последствий, если забыл покормить. Hardcore — питомец может &quot;обидеться&quot; и уйти со стола."
                               Style="{StaticResource CaptionTextStyle}" Margin="2,7,0,14" />

                    <!-- IsEnabled is driven from code-behind (LoadFromSettings and
                         CareModeCombo_SelectionChanged) to track the Hardcore selection: the
                         setting does nothing in Chill, and a checkbox that reads as live while
                         being inert is worse than one that visibly says "not applicable".
                         Still visible-but-disabled rather than collapsed, so it doesn't
                         appear and disappear as the combo changes. The disabled look comes
                         from the CheckBox style's own IsEnabled=False trigger in
                         PokedexTheme.xaml — nothing extra needed here. -->
                    <CheckBox x:Name="SuperHardcoreCheck" Content="Супер Хардкор"
                              Checked="SuperHardcoreCheck_Changed" Unchecked="SuperHardcoreCheck_Changed" />
                    <TextBlock Text="Только для Hardcore. Если забыть про питомца надолго, он не уйдёт со стола на час, а покинет коллекцию навсегда."
                               Style="{StaticResource CaptionTextStyle}" Margin="29,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <!-- Informational, not a toggle. Claude Code token tracking is gone, and
                         activity at the PC is the app's whole premise rather than an option, so
                         there is nothing left here to switch on or off. The card stays because
                         the privacy statement below is worth keeping visible: this app installs
                         a global keyboard hook, and the user is entitled to read, in Settings,
                         exactly what it does and does not record. -->
                    <TextBlock Text="Что растит питомца" Style="{StaticResource SectionHeaderTextStyle}" />

                    <TextBlock Text="Активность за компьютером — клики мышью, нажатия клавиш и кнопки геймпада."
                               Style="{StaticResource StatLabelTextStyle}" Margin="2,0,0,6" />
                    <TextBlock Text="Считается только количество кликов и нажатий — никогда не то, что именно нажато."
                               Style="{StaticResource CaptionTextStyle}" Margin="2,0,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Питомец на рабочем столе" Style="{StaticResource SectionHeaderTextStyle}" />

                    <CheckBox x:Name="FullscreenHideCheck" Content="Скрывать в полноэкранных приложениях"
                              Checked="FullscreenHideCheck_Changed" Unchecked="FullscreenHideCheck_Changed" />
                    <TextBlock Text="Питомец автоматически прячется, пока открыта игра или видео на весь экран."
                               Style="{StaticResource CaptionTextStyle}" Margin="29,4,0,12" />

                    <CheckBox x:Name="ShowProgressPanelCheck" Content="Показывать прогресс рядом с питомцем"
                              Checked="ShowProgressPanelCheck_Changed" Unchecked="ShowProgressPanelCheck_Changed" />
                    <TextBlock Text="Компактный виджет слева от питомца: три кружка — поимка, эволюция, лакомство."
                               Style="{StaticResource CaptionTextStyle}" Margin="29,4,0,14" />

                    <Grid>
                        <TextBlock Text="Размер питомца" Style="{StaticResource StatLabelTextStyle}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock x:Name="PetSizeValueText" Style="{StaticResource MetaTextStyle}"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="PetSizeSlider" Minimum="48" Maximum="384" ValueChanged="PetSizeSlider_ValueChanged"
                            ToolTip="Питомец на рабочем столе меняет размер сразу, пока тянешь ползунок" />

                    <!-- Lives in this card rather than in a "Звук" card of its own: the cry is
                         played by petting the pet on the desktop, so it belongs with the rest of
                         the desktop-pet settings, and one control does not fill a card. Same
                         markup shape as the pet-size slider above (implicit themed Slider style,
                         label/value header Grid), and applied live for the same reason — the
                         next pet click uses it, with no restart and no delayed tick. -->
                    <Grid Margin="0,14,0,0">
                        <TextBlock Text="Громкость крика питомца" Style="{StaticResource StatLabelTextStyle}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock x:Name="CrySoundVolumeValueText" Style="{StaticResource MetaTextStyle}"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="CrySoundVolumeSlider" Minimum="0" Maximum="100" ValueChanged="CrySoundVolumeSlider_ValueChanged"
                            ToolTip="Громкость звука, который издаёт питомец, когда его гладишь. 0 — совсем без звука." />
                    <TextBlock Text="Питомец подаёт голос, когда его гладишь. Поставь 0, если хочешь тишины."
                               Style="{StaticResource CaptionTextStyle}" Margin="2,5,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Система" Style="{StaticResource SectionHeaderTextStyle}" />
                    <CheckBox x:Name="AutostartCheck" Content="Запускать при входе в Windows"
                              Checked="AutostartCheck_Changed" Unchecked="AutostartCheck_Changed" />
                    <Button x:Name="ShowOnboardingButton" Content="Показать обучение" Click="ShowOnboardingButton_Click"
                            Margin="0,16,0,0" HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}" />

                    <!-- SecondaryButtonStyle with a red foreground/border rather than a whole
                         new "danger" button system for one button: the ghost shape keeps it
                         from competing with the real CTAs on other screens (it must not be
                         the most clickable thing in Settings), while the accent colour stops
                         it reading as just another routine action next to "Показать обучение".
                         The double confirmation, not the styling, is the actual safety net. -->
                    <Button x:Name="ResetDataButton" Content="Очистить сохранённые данные" Click="ResetDataButton_Click"
                            Margin="0,10,0,0" HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Foreground="{StaticResource AccentRedBrush}" />
                    <TextBlock Text="Удаляет коллекцию, прогресс и настройки, затем перезапускает приложение с самого начала — как после свежей установки."
                               Style="{StaticResource CaptionTextStyle}" Margin="2,7,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
