<UserControl x:Class="PokeCorner.App.Popup.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="8">
        <TextBlock Text="Режим ухода" FontWeight="Bold" />
        <ComboBox x:Name="CareModeCombo" SelectionChanged="CareModeCombo_SelectionChanged">
            <ComboBoxItem Content="Chill" />
            <ComboBoxItem Content="Hardcore" />
        </ComboBox>
        <TextBlock Text="Chill — без последствий, если забыл покормить. Hardcore — питомец может &quot;обидеться&quot; и уйти со стола." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0" />


        <CheckBox x:Name="TokenTrackingCheck" Content="Трекинг токенов Claude Code" Margin="0,10,0,0" Checked="TokenTrackingCheck_Changed" Unchecked="TokenTrackingCheck_Changed" />
        <TextBlock Text="Токены Claude Code тоже растят питомца, в дополнение к активности мышью/клавиатурой." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0" />

        <CheckBox x:Name="ActivityTrackingCheck" Content="Трекинг активности (клики/клавиши)" Margin="0,10,0,0" Checked="ActivityTrackingCheck_Changed" Unchecked="ActivityTrackingCheck_Changed" />
        <TextBlock Text="Считаются только количество кликов/нажатий — никогда не то, что именно нажато." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0" />

        <CheckBox x:Name="FullscreenHideCheck" Content="Скрывать в полноэкранных приложениях" Margin="0,10,0,0" Checked="FullscreenHideCheck_Changed" Unchecked="FullscreenHideCheck_Changed" />
        <TextBlock Text="Питомец автоматически прячется, пока открыта игра или видео на весь экран." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0" />

        <CheckBox x:Name="AutostartCheck" Content="Запускать при входе в Windows" Margin="0,10,0,0" Checked="AutostartCheck_Changed" Unchecked="AutostartCheck_Changed" />

        <TextBlock Text="Размер питомца" FontWeight="Bold" Margin="0,10,0,0" />
        <Slider x:Name="PetSizeSlider" Minimum="48" Maximum="384" ValueChanged="PetSizeSlider_ValueChanged" />

        <CheckBox x:Name="ShowProgressPanelCheck" Content="Показывать прогресс рядом с питомцем" Margin="0,10,0,0" Checked="ShowProgressPanelCheck_Changed" Unchecked="ShowProgressPanelCheck_Changed" />
        <TextBlock Text="Компактная панель под питомцем на рабочем столе с теми же тремя барами, что и в коллекции." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0" />
    </StackPanel>
</UserControl>
