<Window x:Class="PokeCorner.App.Popup.AppMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokéCorner" Width="580" Height="660"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Brand strip: gives the window an identity above the tab rail instead of
             starting straight into bare tab buttons. -->
        <Border Grid.Row="0" Background="{StaticResource WindowBackgroundBrush}" Padding="16,13,16,11">
            <StackPanel Orientation="Horizontal">
                <Grid Width="26" Height="26" Margin="0,0,10,0">
                    <Ellipse Stroke="{StaticResource AccentRedBrush}" StrokeThickness="2.5">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#E8384F" BlurRadius="12" ShadowDepth="0" Opacity="0.5" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Border Height="2.5" Background="{StaticResource AccentRedBrush}" VerticalAlignment="Center" />
                    <Ellipse Width="9" Height="9" Fill="{StaticResource WindowBackgroundBrush}"
                             Stroke="{StaticResource AccentRedBrush}" StrokeThickness="2.5"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold">
                    <Run Text="Poké" Foreground="{StaticResource AccentGoldBrush}" /><Run Text="Corner" Foreground="{StaticResource PrimaryTextBrush}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <TabControl x:Name="MenuTabControl" Grid.Row="1">
            <TabItem x:Name="CollectionTab" Header="Коллекция" />
            <TabItem x:Name="SettingsTab" Header="Настройки" />
            <TabItem x:Name="ShopTab" Header="Магазин" />
            <TabItem x:Name="CatchTab" Header="Поймать" />
        </TabControl>
    </Grid>
</Window>
