<Window x:Class="PokeCorner.App.Popup.AppMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokéCorner" Width="820" Height="660" MinWidth="640" MinHeight="480"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" PreviewKeyDown="Window_PreviewKeyDown">
    <!-- WindowChrome, not WindowStyle="None" + AllowsTransparency: the transparency route
         gives up hardware rendering, Aero Snap and correct maximized bounds, all of which
         WindowChrome keeps. CaptionHeight="0" routes every click to the content (the brand
         strip below does the dragging itself via DragMove); ResizeBorderThickness is what
         still lets the window be resized by its edges, since ResizeMode is CanResize. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Brand strip, doubling as the window's title bar (the OS one is gone) — hence the drag
             handler and the three chrome buttons. -->
        <Border Grid.Row="0" Background="{StaticResource WindowBackgroundBrush}" Padding="18,10,8,10"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="26" Height="26" Margin="0,0,10,0">
                    <Ellipse Stroke="{StaticResource AccentRedBrush}" StrokeThickness="2.5" />
                    <Border Height="2.5" Background="{StaticResource AccentRedBrush}" VerticalAlignment="Center" />
                    <Ellipse Width="9" Height="9" Fill="{StaticResource WindowBackgroundBrush}"
                             Stroke="{StaticResource AccentRedBrush}" StrokeThickness="2.5"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold">
                    <Run Text="Poké" Foreground="{StaticResource AccentGoldBrush}" /><Run Text="Corner" Foreground="{StaticResource PrimaryTextBrush}" />
                </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Content="Настройки" Click="SettingsButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                            AutomationProperties.Name="Открыть настройки" />
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Свернуть" AutomationProperties.Name="Свернуть" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="Развернуть" AutomationProperties.Name="Развернуть" />
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButtonStyle}"
                            Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Закрыть" AutomationProperties.Name="Закрыть" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{StaticResource WindowBackgroundBrush}">
        <TabControl x:Name="MenuTabControl">
            <TabItem x:Name="CornerTab" AutomationProperties.Name="Уголок">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Уголок" VerticalAlignment="Center" />
                        <Ellipse x:Name="CatchBadge" Width="7" Height="7" Margin="6,0,0,0"
                                 VerticalAlignment="Center" Fill="{StaticResource AccentRedBrush}"
                                 Visibility="Collapsed" />
                    </StackPanel>
                </TabItem.Header>
                <TabControl x:Name="CornerTabs">
                    <TabItem x:Name="CornerHomeTab" Header="Питомец" AutomationProperties.Name="Питомец">
                        <Grid Background="{StaticResource WindowBackgroundBrush}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24">
                                <TextBlock Text="Уголок питомца" Style="{StaticResource ScreenTitleTextStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Питомец живёт на рабочем столе. Здесь скоро появится его комната."
                                           Style="{StaticResource CaptionTextStyle}" TextAlignment="Center" Margin="0,12,0,0" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="CatchTab" Header="Поимка" AutomationProperties.Name="Поимка" />
                </TabControl>
            </TabItem>
            <TabItem x:Name="CollectionTab" Header="Покедекс" AutomationProperties.Name="Покедекс" />
            <TabItem x:Name="ShopTab" Header="Магазин" AutomationProperties.Name="Магазин" />
            <TabItem x:Name="ExpeditionsTab" Header="Экспедиции" AutomationProperties.Name="Экспедиции">
            </TabItem>
            <TabItem x:Name="NurseryTab" Header="Питомник" AutomationProperties.Name="Питомник">
            </TabItem>
        </TabControl>
        <ContentControl x:Name="SettingsContent" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
