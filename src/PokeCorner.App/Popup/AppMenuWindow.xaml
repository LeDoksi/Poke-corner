<Window x:Class="PokeCorner.App.Popup.AppMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PokeCorner.App.Popup"
        Title="PokéCorner" Width="1280" Height="760" MinWidth="1200" MinHeight="660"
        Style="{StaticResource AppWindowStyle}" Background="{DynamicResource NdBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" SizeChanged="Window_SizeChanged" PreviewKeyDown="Window_PreviewKeyDown" KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PokeCorner;component/Theme/NightDiary.xaml" /></ResourceDictionary.MergedDictionaries>
            <GridLength x:Key="NdRailWidth">136</GridLength>
        </ResourceDictionary>
    </Window.Resources>
    <!-- WindowChrome, not WindowStyle="None" + AllowsTransparency: the transparency route
         gives up hardware rendering, Aero Snap and correct maximized bounds, all of which
         WindowChrome keeps. CaptionHeight="0" routes every click to the content (the brand
         strip below does the dragging itself via DragMove); ResizeBorderThickness is what
         still lets the window be resized by its edges, since ResizeMode is CanResize. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
    <Grid x:Name="ShellContent" Background="{StaticResource NdBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Brand strip, doubling as the window's title bar (the OS one is gone) — hence the drag
             handler and the three chrome buttons. -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource NdSurfaceBrush}" BorderBrush="{StaticResource NdBorderBrush}" BorderThickness="0,0,0,1" Padding="18,0,6,0" Height="44" TextElement.FontFamily="Segoe UI"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="26" Height="26" Margin="0,0,10,0">
                    <Ellipse Stroke="{StaticResource NdApricotBrush}" StrokeThickness="2.5" />
                    <Border Height="2.5" Background="{StaticResource NdApricotBrush}" VerticalAlignment="Center" />
                    <Ellipse Width="9" Height="9" Fill="{StaticResource NdSurfaceBrush}"
                             Stroke="{StaticResource NdApricotBrush}" StrokeThickness="2.5"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold">
                    <Run Text="Poké" Foreground="{StaticResource NdTextBrush}" /><Run Text="Corner" Foreground="{StaticResource NdTextBrush}" />
                </TextBlock>
                <TextBlock x:Name="BrandSubtitle" Text="Ночной дневник тренера" Foreground="{StaticResource NdMutedBrush}" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
                        <Image Source="{StaticResource UiCoinImage}" Width="24" Height="24" Margin="0,0,6,0" />
                        <TextBlock x:Name="WalletText" Foreground="{StaticResource NdApricotBrush}" FontWeight="Bold" VerticalAlignment="Center" AutomationProperties.Name="Монеты" />
                    </StackPanel>
                    <Button x:Name="EncountersButton" Content="Встречи · 0" Click="EncountersButton_Click"
                            Style="{StaticResource NdHeaderButtonStyle}" Margin="0,0,10,0" AutomationProperties.Name="Встречи" />
                    <Button x:Name="MinimizeButton" Style="{StaticResource NdChromeButtonStyle}"
                            Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Свернуть" AutomationProperties.Name="Свернуть" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource NdChromeButtonStyle}"
                            Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="Развернуть" AutomationProperties.Name="Развернуть" />
                    <Button x:Name="CloseButton" Style="{StaticResource NdCloseButtonStyle}"
                            Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Закрыть" AutomationProperties.Name="Закрыть" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{StaticResource NdBackgroundBrush}">
        <TabControl x:Name="MenuTabControl" Style="{StaticResource NdShellTabsStyle}">
            <TabItem x:Name="CornerTab" AutomationProperties.Name="Уголок">
                <TabItem.Header>
                    <StackPanel Orientation="Vertical" TextElement.FontFamily="Segoe UI" VerticalAlignment="Center">
                        <Grid Width="26" Height="26" Margin="0,0,0,4" HorizontalAlignment="Center">
                            <Rectangle Width="26" Height="26" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"><Rectangle.OpacityMask><ImageBrush ImageSource="/PokeCorner;component/Assets/NightDiary/rail-icon-corner.png" Stretch="Uniform"/></Rectangle.OpacityMask></Rectangle>
                            <Ellipse x:Name="CatchBadge" Width="8" Height="8" Margin="0,-3,-5,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Fill="{StaticResource NdApricotBrush}" Stroke="{StaticResource NdRailBrush}" StrokeThickness="1.5" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock Text="Уголок" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <TabControl x:Name="CornerTabs" Style="{StaticResource UiContentTabsStyle}">
                    <TabItem x:Name="CornerHomeTab" Header="Питомец" AutomationProperties.Name="Питомец" />
                    <TabItem x:Name="CatchTab" Header="Поимка" AutomationProperties.Name="Поимка" />
                    <TabItem x:Name="AlbumTab" Header="Достижения" AutomationProperties.Name="Достижения" Visibility="Collapsed" />
                </TabControl>
            </TabItem>
            <TabItem x:Name="CollectionTab" AutomationProperties.Name="Покедекс"><TabItem.Header><StackPanel Orientation="Vertical" TextElement.FontFamily="Segoe UI"><Grid Width="26" Height="26" Margin="0,0,0,4" HorizontalAlignment="Center"><Rectangle Width="26" Height="26" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"><Rectangle.OpacityMask><ImageBrush ImageSource="/PokeCorner;component/Assets/NightDiary/rail-icon-pokedex.png" Stretch="Uniform"/></Rectangle.OpacityMask></Rectangle><Border x:Name="PokedexReadyBadge" Visibility="Collapsed" Background="{StaticResource NdApricotBrush}" BorderBrush="{StaticResource NdRailBrush}" BorderThickness="1.5" Width="8" Height="8" CornerRadius="4" Margin="0,-3,-5,0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Кто-то готов к эволюции" /></Grid><TextBlock Text="Покедекс" VerticalAlignment="Center" /></StackPanel></TabItem.Header></TabItem>
            <TabItem x:Name="ExpeditionsTab" AutomationProperties.Name="Экспедиции"><TabItem.Header><StackPanel Orientation="Vertical" TextElement.FontFamily="Segoe UI"><Grid Width="26" Height="26" Margin="0,0,0,4" HorizontalAlignment="Center"><Rectangle Width="26" Height="26" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"><Rectangle.OpacityMask><ImageBrush ImageSource="/PokeCorner;component/Assets/NightDiary/rail-icon-expeditions.png" Stretch="Uniform"/></Rectangle.OpacityMask></Rectangle><Border x:Name="ExpeditionReadyBadge" Visibility="Collapsed" Background="{StaticResource NdApricotBrush}" BorderBrush="{StaticResource NdRailBrush}" BorderThickness="1.5" Width="8" Height="8" CornerRadius="4" Margin="0,-3,-5,0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Команда вернулась — заберите находки" /></Grid><TextBlock Text="Экспедиции" FontSize="12" VerticalAlignment="Center" /></StackPanel></TabItem.Header></TabItem>
            <TabItem x:Name="NurseryTab" AutomationProperties.Name="Питомник"><TabItem.Header><StackPanel Orientation="Vertical" TextElement.FontFamily="Segoe UI"><Grid Width="26" Height="26" Margin="0,0,0,4" HorizontalAlignment="Center"><Rectangle Width="26" Height="26" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"><Rectangle.OpacityMask><ImageBrush ImageSource="/PokeCorner;component/Assets/NightDiary/rail-icon-nursery.png" Stretch="Uniform"/></Rectangle.OpacityMask></Rectangle><Border x:Name="NurseryReadyBadge" Visibility="Collapsed" Background="{StaticResource NdApricotBrush}" BorderBrush="{StaticResource NdRailBrush}" BorderThickness="1.5" Width="8" Height="8" CornerRadius="4" Margin="0,-3,-5,0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Малыш готов — можно вылупить" /></Grid><TextBlock Text="Питомник" VerticalAlignment="Center" /></StackPanel></TabItem.Header></TabItem>
            <TabItem x:Name="ShopTab" AutomationProperties.Name="Магазин"><TabItem.Header><StackPanel Orientation="Vertical" TextElement.FontFamily="Segoe UI"><Rectangle Width="26" Height="26" Margin="0,0,0,4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"><Rectangle.OpacityMask><ImageBrush ImageSource="/PokeCorner;component/Assets/NightDiary/rail-icon-shop.png" Stretch="Uniform"/></Rectangle.OpacityMask></Rectangle><TextBlock Text="Магазин" VerticalAlignment="Center" /></StackPanel></TabItem.Header></TabItem>
        </TabControl>
        <ContentControl x:Name="SettingsContent" Margin="136,0,0,0" Visibility="Collapsed" />
        <ContentControl x:Name="HostedContent" Margin="136,0,0,0" Visibility="Collapsed" />
        <StackPanel x:Name="RailSketch" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,0,0,0" IsHitTestVisible="False" Visibility="Collapsed">
            <!-- Section sketch by Astra (margins/*.png, D-25); the code-behind picks the one for the open section. -->
            <Image x:Name="RailSketchImage" Width="104" Height="104" Stretch="Uniform" Opacity="0.85" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><RotateTransform Angle="-7" /></Image.RenderTransform></Image>
            <TextBlock x:Name="RailSketchNote" Style="{StaticResource NdMarginNoteStyle}" Text="Компас старый, но не врёт." Margin="0,6,0,0" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform Angle="-2" /></TextBlock.RenderTransform></TextBlock>
        </StackPanel>
        <Button x:Name="SettingsButton" ContentTemplate="{StaticResource NdSettingsButtonTemplate}" Content="Настройки" ToolTip="Настройки" Click="SettingsButton_Click"
                Style="{StaticResource NdHeaderButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Width="120" Margin="8,0,0,12" AutomationProperties.Name="Открыть настройки" />
        </Grid>
    </Grid>
    <local:ConfirmationOverlay x:Name="ConfirmationHost" Visibility="Collapsed" Panel.ZIndex="10" />
    </Grid>
</Window>
