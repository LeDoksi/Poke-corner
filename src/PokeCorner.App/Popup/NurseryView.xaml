<UserControl x:Class="PokeCorner.App.Popup.NurseryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" MaxWidth="900">
            <TextBlock Text="Питомник" Style="{StaticResource ScreenTitleTextStyle}" />
            <TextBlock Text="Выберите двух конкретных покемонов. Спутник на рабочем столе не изменится."
                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,2,0,12" />
            <Border x:Name="MessagePanel" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,10">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <StackPanel x:Name="PreparationPanel">
                <Border Style="{StaticResource HeroCardStyle}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Гнездо ждёт родителей" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Text="Два разных экземпляра одного вида тоже могут стать родителями."
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Первый родитель" Style="{StaticResource SectionHeaderTextStyle}" />
                <WrapPanel x:Name="FirstParentsPanel" Margin="0,6,0,12" />
                <TextBlock Text="Совместимый второй родитель" Style="{StaticResource SectionHeaderTextStyle}" />
                <WrapPanel x:Name="SecondParentsPanel" Margin="0,6,0,12" />
                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Возможное потомство" FontWeight="Bold" />
                        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" Margin="0,5,0,6" AutomationProperties.LiveSetting="Polite" />
                        <WrapPanel x:Name="OutcomePanel" />
                        <TextBlock x:Name="CostText" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="ShortageText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Button x:Name="ShopButton" Content="Докупить ягоды" Style="{StaticResource SecondaryButtonStyle}"
                                Click="ShopButton_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Button x:Name="StartButton" Content="Начать ожидание" Click="StartButton_Click" />
            </StackPanel>
            <StackPanel x:Name="NestPanel" Visibility="Collapsed">
                <Border Style="{StaticResource HeroCardStyle}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="NestTitle" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock x:Name="NestParents" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock x:Name="NestTerms" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock x:Name="NestTime" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <ProgressBar x:Name="NestProgress" Minimum="0" Maximum="1" Height="8" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Button x:Name="HatchButton" Content="Встретить малыша" Click="HatchButton_Click" Visibility="Collapsed" />
            </StackPanel>
            <Border x:Name="ResultPanel" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Малыш появился" Style="{StaticResource SectionHeaderTextStyle}" />
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="OpenPokedexButton" Content="Открыть Покедекс" Click="OpenPokedexButton_Click" Margin="0,0,8,6" />
                        <Button x:Name="ActivateButton" Content="На рабочий стол" Style="{StaticResource SecondaryButtonStyle}"
                                Click="ActivateButton_Click" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
