<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PokeCorner.App.Popup" x:Class="PokeCorner.App.Popup.NurseryView">
 <UserControl.Resources>
  <Style x:Key="NdChipSelectedStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Background" Value="{StaticResource NdLavenderBrush}"/><Setter Property="Foreground" Value="{StaticResource NdOnApricotBrush}"/><Setter Property="FontWeight" Value="Bold"/></Style>
 </UserControl.Resources>
 <!-- Same frame as the expedition pilot: title, full-width scene with its caption, a 968 data column, and the
      primary action always bottom-right in the footer. Preparation is the "Книга пар" (Georgy 01.11): every pair
      the collection can breed, with its possible babies, on the left; the chosen pair's details on the right. -->
 <Grid Margin="0,16,0,16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <StackPanel x:Name="HeaderPanel" Margin="24,0" MaxWidth="968" HorizontalAlignment="Left">
   <TextBlock x:Name="ScreenTitle" Text="Питомник" Style="{StaticResource ScreenTitleTextStyle}" FontFamily="{StaticResource NdDisplayFont}" FontSize="26" Margin="0,0,0,10" />
   <Border x:Name="MessagePanel" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,10">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
   </Border>
  </StackPanel>
  <!-- The outer diary margin (Georgy 02.11): the column keeps left, sketches scatter in the free space on the right. -->
  <local:DiaryMargin x:Name="NurseryMargin" Grid.Row="1" HorizontalAlignment="Right" />
  <ScrollViewer x:Name="ScenePanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <!-- Night Diary 2.0: the greenhouse is a lit card on the page, like the corner and the route scene. -->
    <Border x:Name="SceneBorder" Margin="24,0,24,14" CornerRadius="18" BorderBrush="{StaticResource NdPanelLineBrush}" BorderThickness="1" Background="{StaticResource NdPanelBrush}" Effect="{StaticResource NdLiftShadow}">
     <Grid x:Name="SceneGrid" Height="236" ClipToBounds="True">
      <!-- Scene art is 2048x768: full width, clipped around its middle band where the nest sits. -->
      <Image x:Name="GreenhouseImage" Source="{StaticResource UiNurseryImage}" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
      <Rectangle IsHitTestVisible="False">
       <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.75,0.9">
         <GradientStop Color="#D0101426" />
         <GradientStop Color="#60101426" Offset="0.45" />
         <GradientStop Color="#00101426" Offset="1" />
        </LinearGradientBrush>
       </Rectangle.Fill>
      </Rectangle>
      <!-- The chosen parents stand on either side of the nest while the pair is being prepared. -->
      <Image x:Name="SceneFirstParent" Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False" />
      <Image x:Name="SceneSecondParent" Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
       <Image.RenderTransform><ScaleTransform ScaleX="-1" /></Image.RenderTransform>
      </Image>
      <Grid Margin="22,0" MaxWidth="968" HorizontalAlignment="Left">
       <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,16,40,18" MaxWidth="560">
        <TextBlock x:Name="SceneTitleText" Text="Будущие родители" Foreground="{StaticResource NdTextBrush}" FontFamily="{DynamicResource NdHandFont}" FontWeight="Bold" FontSize="42" RenderTransformOrigin="0,0.5" TextWrapping="Wrap"><TextBlock.RenderTransform><RotateTransform Angle="-1.5"/></TextBlock.RenderTransform></TextBlock>
        <Border Height="1" Background="{StaticResource NdMutedBrush}" Opacity="0.7" Margin="0,6,0,0" />
        <TextBlock x:Name="SubtitleText" Foreground="{StaticResource NdTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
       </StackPanel>
      </Grid>
      <Image x:Name="BabyImage" Width="120" Height="120" VerticalAlignment="Center" Visibility="Collapsed" />
     </Grid>
    </Border>
    <Grid x:Name="DataColumn" Margin="24,0" MaxWidth="968" HorizontalAlignment="Left">
     <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="DataLeftColumn" Width="3*" />
      <ColumnDefinition x:Name="DataRightColumn" Width="2*" />
     </Grid.ColumnDefinitions>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
     </Grid.RowDefinitions>
     <StackPanel x:Name="LeftStack">
      <Border x:Name="PairsSection" Style="{StaticResource NdPanelStyle}" Padding="12" Margin="0,0,0,12">
      <StackPanel>
       <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="Auto" />
         <ColumnDefinition Width="Auto" />
         <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="NewPairsButton" Click="NewPairs_Click" Padding="10,5" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Пары, у которых может родиться вид, которого ещё нет в покедексе" />
        <Button x:Name="AllPairsButton" Grid.Column="1" Click="AllPairs_Click" Padding="10,5" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" />
        <TextBox x:Name="PairSearchBox" Grid.Column="2" Tag="Найти по родителю или малышу" ToolTip="Имя или номер родителя, имя или номер малыша" AutomationProperties.Name="Найти по родителю или малышу" TextChanged="PairSearch_Changed" />
       </Grid>
       <StackPanel x:Name="PairListPanel" />
       <StackPanel x:Name="PairEmptyPanel" Visibility="Collapsed" Margin="0,8,0,0">
        <TextBlock x:Name="PairEmptyText" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
        <Button x:Name="ShowAllPairsButton" Content="Показать все пары" Click="AllPairs_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Style="{StaticResource SecondaryButtonStyle}" />
       </StackPanel>
       <DockPanel x:Name="PairPager" Margin="0,6,0,0">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
         <Button x:Name="PairPreviousButton" Content="‹" ToolTip="Предыдущая страница" AutomationProperties.Name="Предыдущая страница" MinWidth="40" Click="PairPrevious_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" />
         <TextBlock x:Name="PairPageText" VerticalAlignment="Center" />
         <Button x:Name="PairNextButton" Content="›" ToolTip="Следующая страница" AutomationProperties.Name="Следующая страница" MinWidth="40" Click="PairNext_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="PairCountText" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
       </DockPanel>
      </StackPanel>
      </Border>
      <StackPanel x:Name="NestPanel" Visibility="Collapsed" Margin="0,0,0,12">
       <TextBlock x:Name="NestTitle" Style="{StaticResource SectionHeaderTextStyle}" FontFamily="{StaticResource NdDisplayFont}" FontSize="16" />
       <WrapPanel x:Name="NestOutcomePanel" Margin="0,8,0,0" />
       <TextBlock x:Name="NestTerms" TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" />
       <TextBlock x:Name="NestTime" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,0" />
       <ProgressBar x:Name="NestProgress" Minimum="0" Maximum="1" Height="8" Margin="0,7,0,0" />
      </StackPanel>
      <StackPanel x:Name="NestParentPanel" Visibility="Collapsed" Margin="0,0,0,12">
       <TextBlock x:Name="NestParents" Style="{StaticResource SectionHeaderTextStyle}" TextWrapping="Wrap" />
       <UniformGrid Columns="2" Margin="0,8,0,0">
        <Border Style="{StaticResource NdPanelStyle}" Padding="10" Margin="0,0,6,0">
         <StackPanel x:Name="NestFirstSlot" />
        </Border>
        <Border Style="{StaticResource NdPanelStyle}" Padding="10" Margin="6,0,0,0">
         <StackPanel x:Name="NestSecondSlot" />
        </Border>
       </UniformGrid>
      </StackPanel>
      <Border x:Name="ResultPanel" Visibility="Collapsed" Style="{StaticResource NdPanelStyle}" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock x:Name="ResultTitle" Text="Добро пожаловать, малыш!" Style="{StaticResource SectionHeaderTextStyle}" FontFamily="{StaticResource NdDisplayFont}" FontSize="16" />
        <TextBlock x:Name="ResultNewText" Text="✦ Новый вид в покедексе!" Foreground="{StaticResource NdApricotBrush}" FontWeight="Bold" Visibility="Collapsed" Margin="0,4,0,0" />
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,6,0,0" />
       </StackPanel>
      </Border>
      <TextBlock x:Name="NurseryNote" Style="{StaticResource NdMarginNoteStyle}" TextAlignment="Left" HorizontalAlignment="Left" Margin="4,10,0,0" RenderTransformOrigin="0,0.5"><TextBlock.RenderTransform><RotateTransform Angle="-1.5" /></TextBlock.RenderTransform></TextBlock>
     </StackPanel>
     <StackPanel x:Name="RightStack" Grid.Column="1" Margin="16,0,0,0">
      <Border x:Name="PreviewPanel" Style="{StaticResource NdPanelStyle}" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock Text="Кто может родиться" Style="{StaticResource SectionHeaderTextStyle}" FontFamily="{StaticResource NdDisplayFont}" FontSize="15" />
        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" Margin="0,4,0,6" Style="{StaticResource CaptionTextStyle}" />
        <StackPanel x:Name="OutcomePanel" />
        <TextBlock x:Name="TraitsText" TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" />
       </StackPanel>
      </Border>
      <Border x:Name="LuckPanel" Style="{StaticResource NdPanelStyle}" Padding="14,10,14,12" Margin="0,0,0,8">
      <StackPanel>
       <DockPanel>
        <TextBlock Text="✦ Удача питомника" FontWeight="Bold" Foreground="{StaticResource NdShinyBrush}" />
        <TextBlock x:Name="LuckText" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0" />
       </DockPanel>
       <UniformGrid x:Name="LuckSegments" Rows="1" Columns="10" Height="8" Margin="0,5,0,0" AutomationProperties.Name="Деления удачи питомника" />
      </StackPanel>
      </Border>
     </StackPanel>
    </Grid>
   </StackPanel>
  </ScrollViewer>
  <Grid x:Name="FooterHost" Grid.Row="2" Margin="24,10,24,0" MaxWidth="968" HorizontalAlignment="Left">
   <Grid x:Name="PreparationFooter">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*" />
     <ColumnDefinition Width="218" />
    </Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0">
     <StackPanel x:Name="PreparationPanel">
      <Grid Margin="0,0,0,6">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
       </Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal">
        <StackPanel x:Name="FirstSlot" VerticalAlignment="Center" Margin="0,0,10,0" />
        <Button x:Name="ChooseFirstButton" Content="Выбрать" Click="ChooseFirst_Click" VerticalAlignment="Center" Padding="10,4" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Выбрать другого питомца первым родителем" />
       </StackPanel>
       <TextBlock Grid.Column="1" Text="+" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource NdMutedBrush}" />
       <StackPanel Orientation="Horizontal" Grid.Column="2">
        <StackPanel x:Name="SecondSlot" VerticalAlignment="Center" Margin="0,0,10,0" />
        <Button x:Name="ChooseSecondButton" Content="Выбрать" Click="ChooseSecond_Click" VerticalAlignment="Center" Padding="10,4" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Выбрать другого питомца вторым родителем" />
       </StackPanel>
      </Grid>
     </StackPanel>
     <WrapPanel x:Name="ResourcePricesPanel" />
     <TextBlock x:Name="CostText" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
     <DockPanel Margin="0,4,0,0">
      <Button x:Name="ShopButton" Content="Докупить" Click="ShopButton_Click" Visibility="Collapsed" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" />
      <TextBlock x:Name="ShortageText" TextWrapping="Wrap" VerticalAlignment="Center" />
     </DockPanel>
    </StackPanel>
    <Button x:Name="StartButton" Grid.Column="1" Content="Начать ожидание" Click="StartButton_Click" MinHeight="50" VerticalAlignment="Bottom" />
   </Grid>
   <Button x:Name="HatchButton" Content="Вылупить" Click="HatchButton_Click" Visibility="Collapsed" Width="218" MinHeight="50" HorizontalAlignment="Right" />
   <DockPanel x:Name="ResultFooter" Visibility="Collapsed" LastChildFill="False">
    <Button x:Name="OpenPokedexButton" Content="Карточка малыша" Click="OpenPokedexButton_Click" DockPanel.Dock="Right" Width="218" MinHeight="50" />
    <Button Content="Новое гнездо" Click="NewNest_Click" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Left" VerticalAlignment="Bottom" Margin="0,0,8,0" />
    <Button x:Name="AgainButton" Content="Ещё раз с этой парой" Click="Again_Click" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Left" VerticalAlignment="Bottom" Margin="0,0,8,0" ToolTip="Поставить тех же родителей снова" />
    <Button x:Name="ActivateButton" Content="На рабочий стол" Click="ActivateButton_Click" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,10,0" />
   </DockPanel>
  </Grid>
  <!-- Д2 (Georgy 01.11): what the nest is missing is bought right here, with the counts already filled in. -->
  <Border x:Name="CartPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="400" Margin="24,0,24,70"
          Background="{StaticResource NdRaisedBrush}" BorderBrush="{StaticResource NdLavenderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
   <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.6" Color="Black" /></Border.Effect>
   <StackPanel>
    <TextBlock Text="Докупить для гнезда" Style="{StaticResource SectionHeaderTextStyle}" />
    <StackPanel x:Name="CartRowsPanel" Margin="0,8,0,0" />
    <TextBlock x:Name="CartTotalText" TextWrapping="Wrap" Margin="0,8,0,0" />
    <DockPanel Margin="0,10,0,0" LastChildFill="False">
     <Button x:Name="CartShopButton" Content="Открыть магазин" Click="CartShop_Click" DockPanel.Dock="Left" Padding="8,4" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Перейти в магазин; кнопка там вернёт сюда" />
     <Button x:Name="CartBuyButton" Content="Купить" Click="CartBuy_Click" DockPanel.Dock="Right" MinWidth="120" MinHeight="40" />
     <Button x:Name="CartCancelButton" Content="Отмена" Click="CartCancel_Click" DockPanel.Dock="Right" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" />
    </DockPanel>
   </StackPanel>
  </Border>
  <Grid x:Name="PickerPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Margin="24,0">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="*" />
    <RowDefinition Height="Auto" />
   </Grid.RowDefinitions>
   <StackPanel>
    <TextBlock Text="Родители для малыша" Style="{StaticResource ScreenTitleTextStyle}" />
    <TextBlock Text="Выберите первого родителя, затем второго." Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,10" />
    <UniformGrid Columns="2">
     <Button x:Name="DraftFirstButton" Click="DraftFirst_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" />
     <Button x:Name="DraftSecondButton" Click="DraftSecond_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,6" />
    </UniformGrid>
   </StackPanel>
   <Grid Grid.Row="1" Margin="0,6,0,10">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*" />
     <ColumnDefinition Width="170" />
     <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBox x:Name="ParentSearchBox" Tag="Имя, кличка или номер" TextChanged="ParentFilter_Changed" ToolTip="Имя, кличка или номер" AutomationProperties.Name="Имя, кличка или номер" Margin="0,0,8,0" />
    <ComboBox x:Name="RarityBox" Grid.Column="1" SelectionChanged="ParentFilter_Changed" AutomationProperties.Name="Редкость" Margin="0,0,8,0" />
    <Button x:Name="ParentResetButton" Grid.Column="2" Content="Сбросить фильтры" Click="ParentReset_Click" Style="{StaticResource SecondaryButtonStyle}" />
   </Grid>
   <ScrollViewer x:Name="PickerScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <WrapPanel x:Name="PickerIndividualsPanel" />
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="3" Margin="0,10,0,0">
    <TextBlock x:Name="PickerCountText" TextWrapping="Wrap" Margin="0,0,0,6" />
    <DockPanel>
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
      <Button x:Name="PickerPreviousButton" Content="‹" ToolTip="Предыдущая страница" AutomationProperties.Name="Предыдущая страница" MinWidth="40" Click="PreviousPage_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" />
      <TextBlock x:Name="PickerPageText" VerticalAlignment="Center" />
      <Button x:Name="PickerNextButton" Content="›" ToolTip="Следующая страница" AutomationProperties.Name="Следующая страница" MinWidth="40" Click="NextPage_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" />
     </StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="PickerCancelButton" Content="Отмена" Click="PickerCancel_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,8,0" />
      <Button x:Name="PickerSaveButton" Content="Сохранить пару" Click="PickerSave_Click" />
     </StackPanel>
    </DockPanel>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
