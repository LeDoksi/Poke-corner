<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PokeCorner.App.Popup.NurseryView">
 <Grid Margin="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <Border x:Name="MessagePanel" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,8">
   <TextBlock x:Name="MessageText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  </Border>
  <ScrollViewer x:Name="ScenePanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock x:Name="SceneTitleText" Text="Питомник" Style="{StaticResource ScreenTitleTextStyle}" />
    <TextBlock x:Name="SubtitleText" Text="Здесь начинается новая маленькая история." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,10" />
    <Grid x:Name="CompositionGrid">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.45*" />
      <ColumnDefinition Width="*" />
     </Grid.ColumnDefinitions>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
     </Grid.RowDefinitions>
     <Border CornerRadius="12" ClipToBounds="True" x:Name="SceneBorder" Grid.Column="0" VerticalAlignment="Top">
      <Grid Height="210" x:Name="SceneGrid">
       <Image x:Name="GreenhouseImage" Source="{StaticResource UiNurseryImage}" Stretch="UniformToFill" />
       <Image x:Name="BabyImage" Width="120" Height="120" VerticalAlignment="Bottom" Margin="0,0,0,18" Visibility="Collapsed" />
       <Button x:Name="HatchButton" Content="Вылупить" Click="HatchButton_Click" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" />
      </Grid>
     </Border>
     <StackPanel x:Name="PreviewPanel" Grid.Column="1" Grid.RowSpan="2" Margin="12,0,0,0">
      <Border Style="{StaticResource CardStyle}" Padding="12">
       <StackPanel>
        <TextBlock Text="Возможные малыши" Style="{StaticResource SectionHeaderTextStyle}" />
        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" Margin="0,4,0,6" />
        <StackPanel x:Name="OutcomePanel" />
        <TextBlock x:Name="TraitsText" TextWrapping="Wrap" Margin="0,6,0,0" />
       </StackPanel>
      </Border>

     </StackPanel>
     <StackPanel x:Name="NestPanel" Visibility="Collapsed" Margin="12,0,0,0" Grid.Column="1" Grid.RowSpan="2">
      <TextBlock x:Name="NestTitle" Style="{StaticResource SectionHeaderTextStyle}" />
      <TextBlock x:Name="NestTerms" TextWrapping="Wrap" Margin="0,6,0,0" />
      <TextBlock x:Name="NestTime" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,0" />
      <ProgressBar x:Name="NestProgress" Minimum="0" Maximum="1" Height="8" Margin="0,7,0,14" />
      <Button x:Name="ReturnCornerButton" Content="Вернуться в уголок" Click="ReturnCorner_Click" Margin="0,12,0,0"/>
     </StackPanel>
     <StackPanel x:Name="NestParentPanel" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
      <TextBlock x:Name="NestParents" TextWrapping="Wrap" Margin="0,6,0,0" />
      <UniformGrid Columns="2" Margin="0,8,0,0">
       <Border Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,6,0">
        <StackPanel x:Name="NestFirstSlot" />
       </Border>
       <Border Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,6,0">
        <StackPanel x:Name="NestSecondSlot" />
       </Border>
      </UniformGrid>
     </StackPanel>
     <StackPanel x:Name="HatchAnimationPanel" Visibility="Collapsed" HorizontalAlignment="Center" Margin="12,0,0,0" Grid.Column="1" Grid.RowSpan="2">
      <TextBlock x:Name="HatchStageText" Text="Малыш появился!" Style="{StaticResource SectionHeaderTextStyle}" />
      <Button x:Name="HatchContinueButton" Content="Продолжить" Click="HatchContinueButton_Click" Margin="0,10,0,0" />
     </StackPanel>
     <Border x:Name="ResultPanel" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="12" Margin="12,0,0,0" Grid.Column="1" Grid.RowSpan="2">
      <StackPanel>
       <TextBlock Text="Добро пожаловать, малыш!" Style="{StaticResource SectionHeaderTextStyle}" />
       <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,6,0,0" />
       <WrapPanel Margin="0,10,0,0">
        <Button x:Name="OpenPokedexButton" Content="Карточка малыша" Click="OpenPokedexButton_Click" Margin="0,0,8,6" />
        <Button x:Name="ActivateButton" Content="На рабочий стол" Click="ActivateButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6" />
        <Button Content="Новое гнездо" Click="NewNest_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" />
       </WrapPanel>
      </StackPanel>
     </Border>
     <StackPanel Margin="12,10,0,0" x:Name="LuckPanel" Grid.Column="1" Grid.Row="2">
      <DockPanel>
       <TextBlock Text="Удача питомника" FontWeight="Bold" />
       <TextBlock x:Name="LuckText" HorizontalAlignment="Right" />
      </DockPanel>
      <ProgressBar x:Name="LuckBar" Minimum="0" Maximum="1" Height="7" Margin="0,5,0,0" />
     </StackPanel>
    </Grid>
   </StackPanel>
  </ScrollViewer>
  <DockPanel x:Name="PreparationFooter" Grid.Row="2" Margin="0,10,0,0">
   <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
    <Button x:Name="StartButton" Content="Начать ожидание" Click="StartButton_Click" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
    <StackPanel>
        <WrapPanel x:Name="ResourcePricesPanel" Margin="0,6,0,0" />
        <TextBlock x:Name="CostText" TextWrapping="Wrap" Margin="0,6,0,0" />
        <TextBlock x:Name="ShortageText" TextWrapping="Wrap" Margin="0,4,0,0" />
        <Button x:Name="ShopButton" Content="Докупить ягоды" Click="ShopButton_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,6,0,0" Style="{StaticResource SecondaryButtonStyle}" />
    </StackPanel>
   </DockPanel>
     <StackPanel x:Name="PreparationPanel">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
       </Grid.ColumnDefinitions>
       <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,6,10">
        <StackPanel>
         <TextBlock Text="Первый родитель" FontWeight="Bold" />
         <StackPanel x:Name="FirstSlot" Margin="0,6,0,6" />
         <Button x:Name="ChooseFirstButton" Content="Выбрать" Click="ChooseFirst_Click" Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
       </Border>
       <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10" Margin="6,0,0,10">
        <StackPanel>
         <TextBlock Text="Второй родитель" FontWeight="Bold" />
         <StackPanel x:Name="SecondSlot" Margin="0,6,0,6" />
         <Button x:Name="ChooseSecondButton" Content="Выбрать" Click="ChooseSecond_Click" Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
       </Border>
      </Grid>
     </StackPanel>
</DockPanel>
  <Grid x:Name="PickerPanel" Grid.Row="1" Visibility="Collapsed">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="*" />
    <RowDefinition Height="Auto" />
   </Grid.RowDefinitions>
   <StackPanel>
    <TextBlock Text="Родители для малыша" Style="{StaticResource ScreenTitleTextStyle}" />
    <TextBlock Text="Выберите первого родителя, затем второго." Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,10" />
    <UniformGrid Columns="2">
     <Button x:Name="DraftFirstButton" Click="DraftFirst_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" />
     <Button x:Name="DraftSecondButton" Click="DraftSecond_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,6" />
    </UniformGrid>
   </StackPanel>
   <Grid Grid.Row="1" Margin="0,6,0,10">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*" />
     <ColumnDefinition Width="150" />
     <ColumnDefinition Width="90" />
    </Grid.ColumnDefinitions>
    <TextBox x:Name="ParentSearchBox" Tag="Имя, кличка или номер" TextChanged="ParentFilter_Changed" ToolTip="Имя, кличка или номер" AutomationProperties.Name="Имя, кличка или номер" Margin="0,0,8,0" />
    <ComboBox x:Name="RarityBox" Grid.Column="1" SelectionChanged="ParentFilter_Changed" AutomationProperties.Name="Редкость" Margin="0,0,8,0" />
    <CheckBox x:Name="ShinyOnlyBox" Grid.Column="2" Content="Shiny" Checked="ParentFilter_Changed" Unchecked="ParentFilter_Changed" VerticalAlignment="Center" />
   </Grid>
   <ScrollViewer x:Name="PickerScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <WrapPanel x:Name="PickerIndividualsPanel" />
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="3" Margin="0,10,0,0">
    <TextBlock x:Name="PickerCountText" TextWrapping="Wrap" Margin="0,0,0,6" />
    <DockPanel>
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
      <Button x:Name="PickerPreviousButton" Content="Назад" Click="PreviousPage_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" />
      <TextBlock x:Name="PickerPageText" VerticalAlignment="Center" />
      <Button x:Name="PickerNextButton" Content="Далее" Click="NextPage_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" />
     </StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="PickerCancelButton" Content="Отмена" Click="PickerCancel_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,8,0" />
      <Button x:Name="PickerSaveButton" Content="Сохранить пару" Click="PickerSave_Click" />
     </StackPanel>
    </DockPanel>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
