<UserControl x:Class="PokeCorner.App.Popup.AchievementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="24,16,24,12">
            <Button Content="Назад в уголок" DockPanel.Dock="Right" Click="BackButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    AutomationProperties.Name="Вернуться в уголок" />
            <TextBlock Text="Мои маленькие победы" Style="{StaticResource ScreenTitleTextStyle}" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,0,24,20">
                <TextBlock Text="Три любимые награды можно поставить на полку."
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12" />
                <TextBlock Text="Моя полка" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,8" />
                <Border Background="{StaticResource NdBackgroundBrush}" BorderBrush="{StaticResource NdBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16,8" Margin="0,0,0,10">
                    <UniformGrid x:Name="ShelfPanel" Columns="3" />
                </Border>
                <TextBlock x:Name="MessageText" Text="Выберите открытую награду, затем место на полке. Нажмите занятое место без выбора, чтобы снять награду."
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,16" />
                <TextBlock Text="Альбом" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,8" />
                <WrapPanel x:Name="CardsPanel" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
