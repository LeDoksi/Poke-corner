<UserControl x:Class="PokeCorner.App.Popup.ConfirmationOverlay"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
 FocusManager.IsFocusScope="True" Background="#6626352D">
 <Grid Margin="24">
  <Border x:Name="ConfirmationCard" Background="{StaticResource UiPaperBrush}" CornerRadius="12" Padding="24"
          MaxWidth="490" HorizontalAlignment="Center" VerticalAlignment="Center">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel>
     <TextBlock x:Name="TitleText" FontSize="23" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,14" />
     <TextBlock x:Name="BodyText" FontSize="15" TextWrapping="Wrap" />
     <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="CancelButton" Content="Отмена" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" />
      <Button x:Name="ConfirmButton" Click="Confirm_Click" Style="{StaticResource UiPrimaryButtonStyle}" />
     </WrapPanel>
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
</UserControl>
