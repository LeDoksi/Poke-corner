<UserControl x:Class="PokeCorner.App.Popup.RoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="24,16,24,12">
            <Button x:Name="AchievementsButton" Content="☆  Достижения" DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButtonStyle}" Click="AchievementsButton_Click"
                    AutomationProperties.Name="Открыть достижения и мою полку" />
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Мой уголок" Style="{StaticResource ScreenTitleTextStyle}" />
                <TextBlock x:Name="PetCaption" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" MaxHeight="44" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="24,0"><Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                 SnapsToDevicePixels="True">
            <Canvas x:Name="Scene" Width="1448" Height="582" ClipToBounds="True">
                <Image x:Name="RoomBackground" Width="1448" Height="582" Stretch="Fill" />
                <Canvas x:Name="AwardLayer" Width="1448" Height="582" />
                <Image x:Name="ShelfFrontlip" />
                <Ellipse Canvas.Left="778" Canvas.Top="520" Width="46" Height="10" Fill="#422F1E" Opacity="0.26" />
                <Image x:Name="PetImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Canvas>
        </Viewbox>
            <TextBlock x:Name="MissingSpriteText" Text="Изображение питомца недоступно" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12"
                       Background="{StaticResource UiPaperBrush}" Padding="10" TextWrapping="Wrap" />
        </Grid>
        <UniformGrid Grid.Row="2" Columns="3" Margin="24,14,24,8">
            <StackPanel Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal"><Image Source="/PokeCorner;component/Assets/UiSystem/care.png" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Уход для эволюции" FontWeight="Bold" VerticalAlignment="Center" /></StackPanel>
                <TextBlock x:Name="CareText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                <ProgressBar x:Name="CareBar" Maximum="1" Height="7" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Опыт и следующий покебол" FontWeight="Bold" />
                <TextBlock x:Name="XpText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                <ProgressBar x:Name="CatchBar" Maximum="1" Height="7" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal"><Image Source="/PokeCorner;component/Assets/UiSystem/treat.png" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Лакомства" FontWeight="Bold" VerticalAlignment="Center" /></StackPanel>
                <TextBlock x:Name="TreatText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                <ProgressBar x:Name="TreatBar" Maximum="1" Height="7" Margin="0,6,0,0" />
            </StackPanel>
        </UniformGrid>
        <DockPanel Grid.Row="3" Margin="24,8,24,18" LastChildFill="False">
            <Button x:Name="DetailButton" Content="Карточка питомца" DockPanel.Dock="Left" Click="DetailButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
            <Button x:Name="FeedButton" Content="Покормить" DockPanel.Dock="Right" Click="FeedButton_Click"
                    Style="{StaticResource UiPrimaryButtonStyle}" Margin="8,0,0,0" />
            <Button x:Name="PetButton" Content="♡  Погладить" DockPanel.Dock="Right" Click="PetButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </DockPanel>
    </Grid>
</UserControl>
