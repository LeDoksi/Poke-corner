<UserControl x:Class="PokeCorner.App.Popup.ShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14">

            <!-- Wallet -->
            <Border Style="{StaticResource HeroCardStyle}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="36" Height="36" Margin="0,0,12,0">
                                <Ellipse Fill="{StaticResource ProgressGoldBrush}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#F5C542" BlurRadius="14" ShadowDepth="0" Opacity="0.55" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse Margin="4" Stroke="#8A6A12" StrokeThickness="1.5" />
                                <TextBlock Text="P" FontWeight="Bold" FontSize="15" Foreground="#5C460B"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="КОШЕЛЁК" Style="{StaticResource StatLabelTextStyle}" />
                                <TextBlock x:Name="CoinsText" Style="{StaticResource StatValueTextStyle}"
                                           Foreground="{StaticResource AccentGoldBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="CoinProgressBar" Style="{StaticResource GoldProgressBarStyle}"
                                 Minimum="0" Maximum="1" Margin="0,12,0,0"
                                 ToolTip="Прогресс до следующей монеты" />
                    <TextBlock Text="Монеты начисляются за активность за компьютером."
                               Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Consumables -->
            <TextBlock Text="Расходники" Style="{StaticResource SectionHeaderTextStyle}" />
            <WrapPanel Margin="-6,0,-6,8">

                <Border x:Name="TreatPackCard" Style="{StaticResource CardStyle}" Width="150" Margin="6" Padding="12">
                    <StackPanel>
                        <Border Style="{StaticResource WellStyle}" Height="58" Margin="0,0,0,9">
                            <Canvas Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M6,10 L34,10 L32,17 L8,17 Z" Fill="#A8703C" />
                                <Path Data="M8,17 L32,17 L29,36 L11,36 Z" Fill="#C98A4B" />
                                <Path Data="M11,17 L17,17 L15.5,36 L11,36 Z" Fill="#DDA469" />
                                <Ellipse Canvas.Left="19" Canvas.Top="23" Width="8" Height="6" Fill="#7A4A20" />
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="TreatPackNameText" FontWeight="SemiBold" FontSize="12" MinHeight="32"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                        <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Center" Margin="0,4,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Ellipse Fill="{StaticResource ProgressGoldBrush}" />
                                    <Ellipse Margin="2.5" Stroke="#8A6A12" StrokeThickness="1" />
                                </Grid>
                                <TextBlock x:Name="TreatPackPriceText" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentGoldBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="TreatPackButton" Content="Купить" Click="TreatPackButton_Click" Padding="0,7" />
                    </StackPanel>
                </Border>

                <Border x:Name="CarePointsBoosterCard" Style="{StaticResource CardStyle}" Width="150" Margin="6" Padding="12">
                    <StackPanel>
                        <Border Style="{StaticResource WellStyle}" Height="58" Margin="0,0,0,9">
                            <Canvas Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M23,3 L11,23 L18,23 L15,37 L30,16 L21,16 Z"
                                      Fill="{StaticResource ProgressGoldBrush}" />
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="CarePointsBoosterNameText" FontWeight="SemiBold" FontSize="12" MinHeight="32"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                        <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Center" Margin="0,4,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Ellipse Fill="{StaticResource ProgressGoldBrush}" />
                                    <Ellipse Margin="2.5" Stroke="#8A6A12" StrokeThickness="1" />
                                </Grid>
                                <TextBlock x:Name="CarePointsBoosterPriceText" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentGoldBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="CarePointsBoosterButton" Content="Купить" Click="CarePointsBoosterButton_Click" Padding="0,7" />
                    </StackPanel>
                </Border>

                <!-- The effect is exactly CatchRoller's shiny roll: the charm multiplies the
                     chance that the NEXT Pokémon — caught or hatched from an egg — is shiny
                     (base 1/512) by ShopService.CatchLuckyCharmShinyMultiplier, and is consumed
                     by that catch or hatch whatever it produces. It does NOT change which species or rarity is rolled. -->
                <Border x:Name="CatchLuckyCharmCard" Style="{StaticResource CardStyle}" Width="150" Margin="6" Padding="12"
                        ToolTip="В 4 раза повышает шанс, что следующий покемон — пойманный или вылупившийся из яйца — будет блестящим (шайни). Тратится на первую же поимку или вылупление, независимо от результата. На редкость и вид покемона не влияет.">
                    <StackPanel>
                        <Border Style="{StaticResource WellStyle}" Height="58" Margin="0,0,0,9">
                            <Canvas Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M20,22 L21,37 L17,37 Z" Fill="#2A8F55" />
                                <Ellipse Canvas.Left="6" Canvas.Top="6" Width="14" Height="14" Fill="#4CD787" />
                                <Ellipse Canvas.Left="20" Canvas.Top="6" Width="14" Height="14" Fill="#4CD787" />
                                <Ellipse Canvas.Left="6" Canvas.Top="18" Width="14" Height="14" Fill="#3FBF74" />
                                <Ellipse Canvas.Left="20" Canvas.Top="18" Width="14" Height="14" Fill="#3FBF74" />
                                <Ellipse Canvas.Left="16" Canvas.Top="16" Width="8" Height="8" Fill="#2A8F55" />
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="CatchLuckyCharmNameText" FontWeight="SemiBold" FontSize="12" MinHeight="32"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                        <TextBlock x:Name="CatchLuckyCharmDescriptionText" Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Center" Margin="0,4,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Ellipse Fill="{StaticResource ProgressGoldBrush}" />
                                    <Ellipse Margin="2.5" Stroke="#8A6A12" StrokeThickness="1" />
                                </Grid>
                                <TextBlock x:Name="CatchLuckyCharmPriceText" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentGoldBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="CatchLuckyCharmButton" Content="Купить" Click="CatchLuckyCharmButton_Click" Padding="0,7" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Eggs -->
            <TextBlock Text="Яйца" Style="{StaticResource SectionHeaderTextStyle}" Margin="2,6,0,2" />
            <TextBlock Text="Вылупляются через час после покупки — забирай их на вкладке «Мой покемон»."
                       Style="{StaticResource CaptionTextStyle}" Margin="2,0,0,8" />
            <WrapPanel Margin="-6,0,-6,0">

                <Border x:Name="EggCommonCard" Style="{StaticResource CardStyle}" Width="150" Margin="6" Padding="12">
                    <StackPanel>
                        <Border Style="{StaticResource WellStyle}" Height="58" Margin="0,0,0,9">
                            <Canvas Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M20,3 C28,3 34,16 34,25 C34,33 28,38 20,38 C12,38 6,33 6,25 C6,16 12,3 20,3 Z"
                                      Fill="{StaticResource RarityCommonBrush}" />
                                <Ellipse Canvas.Left="12" Canvas.Top="9" Width="7" Height="10" Fill="#4DFFFFFF" />
                                <Ellipse Canvas.Left="13" Canvas.Top="24" Width="7" Height="7" Fill="#33000000" />
                                <Ellipse Canvas.Left="23" Canvas.Top="19" Width="5" Height="5" Fill="#33000000" />
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="EggCommonNameText" FontWeight="SemiBold" FontSize="12" MinHeight="32"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                        <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Center" Margin="0,4,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Ellipse Fill="{StaticResource ProgressGoldBrush}" />
                                    <Ellipse Margin="2.5" Stroke="#8A6A12" StrokeThickness="1" />
                                </Grid>
                                <TextBlock x:Name="EggCommonPriceText" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentGoldBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="EggCommonButton" Content="Купить" Click="EggCommonButton_Click" Padding="0,7" />
                    </StackPanel>
                </Border>

                <Border x:Name="EggUncommonCard" Style="{StaticResource CardStyle}" Width="150" Margin="6" Padding="12">
                    <StackPanel>
                        <Border Style="{StaticResource WellStyle}" Height="58" Margin="0,0,0,9">
                            <Canvas Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M20,3 C28,3 34,16 34,25 C34,33 28,38 20,38 C12,38 6,33 6,25 C6,16 12,3 20,3 Z"
                                      Fill="{StaticResource RarityUncommonBrush}" />
                                <Ellipse Canvas.Left="12" Canvas.Top="9" Width="7" Height="10" Fill="#4DFFFFFF" />
                                <Ellipse Canvas.Left="13" Canvas.Top="24" Width="7" Height="7" Fill="#33000000" />
                                <Ellipse Canvas.Left="23" Canvas.Top="19" Width="5" Height="5" Fill="#33000000" />
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="EggUncommonNameText" FontWeight="SemiBold" FontSize="12" MinHeight="32"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                        <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Center" Margin="0,4,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Ellipse Fill="{StaticResource ProgressGoldBrush}" />
                                    <Ellipse Margin="2.5" Stroke="#8A6A12" StrokeThickness="1" />
                                </Grid>
                                <TextBlock x:Name="EggUncommonPriceText" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentGoldBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="EggUncommonButton" Content="Купить" Click="EggUncommonButton_Click" Padding="0,7" />
                    </StackPanel>
                </Border>

                <Border x:Name="EggRareCard" Style="{StaticResource CardStyle}" Width="150" Margin="6" Padding="12">
                    <StackPanel>
                        <Border Style="{StaticResource WellStyle}" Height="58" Margin="0,0,0,9">
                            <Canvas Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M20,3 C28,3 34,16 34,25 C34,33 28,38 20,38 C12,38 6,33 6,25 C6,16 12,3 20,3 Z"
                                      Fill="{StaticResource RarityRareBrush}" />
                                <Ellipse Canvas.Left="12" Canvas.Top="9" Width="7" Height="10" Fill="#4DFFFFFF" />
                                <Ellipse Canvas.Left="13" Canvas.Top="24" Width="7" Height="7" Fill="#33000000" />
                                <Ellipse Canvas.Left="23" Canvas.Top="19" Width="5" Height="5" Fill="#33000000" />
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="EggRareNameText" FontWeight="SemiBold" FontSize="12" MinHeight="32"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                        <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Center" Margin="0,4,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Ellipse Fill="{StaticResource ProgressGoldBrush}" />
                                    <Ellipse Margin="2.5" Stroke="#8A6A12" StrokeThickness="1" />
                                </Grid>
                                <TextBlock x:Name="EggRarePriceText" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentGoldBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="EggRareButton" Content="Купить" Click="EggRareButton_Click" Padding="0,7" />
                    </StackPanel>
                </Border>

                <Border x:Name="EggLegendaryCard" Style="{StaticResource CardStyle}" Width="150" Margin="6" Padding="12">
                    <StackPanel>
                        <Border Style="{StaticResource WellStyle}" Height="58" Margin="0,0,0,9">
                            <Canvas Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M20,3 C28,3 34,16 34,25 C34,33 28,38 20,38 C12,38 6,33 6,25 C6,16 12,3 20,3 Z"
                                      Fill="{StaticResource RarityLegendaryBrush}">
                                    <Path.Effect>
                                        <DropShadowEffect Color="#FFB020" BlurRadius="14" ShadowDepth="0" Opacity="0.7" />
                                    </Path.Effect>
                                </Path>
                                <Ellipse Canvas.Left="12" Canvas.Top="9" Width="7" Height="10" Fill="#4DFFFFFF" />
                                <Ellipse Canvas.Left="13" Canvas.Top="24" Width="7" Height="7" Fill="#33000000" />
                                <Ellipse Canvas.Left="23" Canvas.Top="19" Width="5" Height="5" Fill="#33000000" />
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="EggLegendaryNameText" FontWeight="SemiBold" FontSize="12" MinHeight="32"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                        <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Center" Margin="0,4,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Ellipse Fill="{StaticResource ProgressGoldBrush}" />
                                    <Ellipse Margin="2.5" Stroke="#8A6A12" StrokeThickness="1" />
                                </Grid>
                                <TextBlock x:Name="EggLegendaryPriceText" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentGoldBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="EggLegendaryButton" Content="Купить" Click="EggLegendaryButton_Click" Padding="0,7" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Purchase feedback -->
            <Border x:Name="MessagePanel" Style="{StaticResource CardStyle}" Visibility="Collapsed"
                    BorderBrush="{StaticResource AccentGoldBrush}" Padding="12,9" Margin="0,14,0,0">
                <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource PrimaryTextBrush}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
