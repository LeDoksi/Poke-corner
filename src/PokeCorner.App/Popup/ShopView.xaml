<UserControl x:Class="PokeCorner.App.Popup.ShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14">
            <Border Style="{StaticResource HeroCardStyle}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="КОШЕЛЁК" Style="{StaticResource StatLabelTextStyle}" />
                    <TextBlock x:Name="CoinsText" Style="{StaticResource StatValueTextStyle}" Foreground="{StaticResource AccentGoldBrush}" />
                    <ProgressBar x:Name="CoinProgressBar" Style="{StaticResource GoldProgressBarStyle}" Minimum="0" Maximum="1" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
            <Border x:Name="MessagePanel" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="Расходники" Style="{StaticResource SectionHeaderTextStyle}" />
            <StackPanel x:Name="ItemsPanel" Margin="0,4,0,12" />
            <TextBlock Text="Ягоды" Style="{StaticResource SectionHeaderTextStyle}" />
            <TextBlock Text="Выберите количество и купите одним нажатием. Все шесть ягод доступны ниже."
                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel x:Name="BerriesPanel" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
