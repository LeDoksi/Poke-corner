<UserControl x:Class="PokeCorner.App.Popup.CollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PokeCorner.App.Popup"
             PreviewKeyDown="CollectionView_PreviewKeyDown">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PokeCorner;component/Theme/NightDiary.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <!-- Two layers: the tabs, and the Pokédex detail card that overlays them (an in-view
         overlay rather than a second OS window). -->
    <Grid>
    <TabControl SelectedIndex="1"><TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
        <!-- ============================== HOME ==============================
             Only "what is happening right now": the active pet and its progress bars. Everything
             owned — incubating eggs and every individual — lives on the Pokédex tab. -->
        <TabItem Header="Мой покемон">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14">

                    <!-- Hero spotlight: the active Pokémon is the reason the app exists, so it
                         gets the largest element on the screen rather than a 48px corner thumb. -->
                    <Border Style="{StaticResource HeroCardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Height="144">
                                <Ellipse Width="210" Height="138" Fill="{StaticResource SpotlightBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="ActiveSpriteImage" Width="124" Height="124"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <!-- Pokéball silhouette shown until the sprite is cached on disk. -->
                                <Grid x:Name="ActiveSpritePlaceholder" Width="76" Height="76"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5">
                                    <Ellipse Stroke="{StaticResource MutedTextBrush}" StrokeThickness="3" />
                                    <Border Height="3" Background="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                    <Ellipse Width="24" Height="24" Fill="{StaticResource WindowBackgroundBrush}"
                                             Stroke="{StaticResource MutedTextBrush}" StrokeThickness="3"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <Border x:Name="ShinyBadge" Style="{StaticResource PillStyle}" Visibility="Collapsed"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        BorderBrush="{StaticResource AccentGoldBrush}"
                                        ToolTip="Шайни — редкая цветовая форма">
                                    <TextBlock Text="✨ Shiny" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentGoldBrush}" />
                                </Border>
                            </Grid>

                            <TextBlock x:Name="ActivePetNameText" Style="{StaticResource ScreenTitleTextStyle}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="ActivePetMetaText" Style="{StaticResource MetaTextStyle}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,3,0,7" />

                            <!-- Type badges for the active pet. Centered under the meta line so
                                 the hero reads name -> stats -> types top to bottom. -->
                            <ItemsControl x:Name="ActiveTypeBadges"
                                          HorizontalAlignment="Center" Margin="0,0,0,7"
                                          ItemsPanel="{StaticResource TypeBadgePanelTemplate}"
                                          ItemTemplate="{StaticResource TypeBadgeTemplate}" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource WellStyle}" Padding="12,9"
                                        ToolTip="CP активного питомца — растёт от активности за ПК">
                                    <StackPanel>
                                        <!-- "CP", not "очки роста": the shop's CP Booster already
                                             called it CP, and two names for one number read as two
                                             different stats. -->
                                        <TextBlock Text="CP" Style="{StaticResource StatLabelTextStyle}" />
                                        <TextBlock x:Name="CarePointsText" Style="{StaticResource StatValueTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource WellStyle}" Padding="12,9"
                                        ToolTip="Лакомства зарабатываются активностью и тратятся на кормление">
                                    <StackPanel>
                                        <TextBlock Text="ЛАКОМСТВА" Style="{StaticResource StatLabelTextStyle}" />
                                        <TextBlock x:Name="TreatsText" Style="{StaticResource StatValueTextStyle}"
                                                   Foreground="{StaticResource AccentGoldBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PetButton" Grid.Column="0" Click="PetButton_Click"
                                        ToolTip="Бесплатно, всегда доступно. Тот же эффект, что и клик по питомцу на рабочем столе.">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="15" Height="14" Stretch="Uniform" Fill="{StaticResource PrimaryTextBrush}"
                                              Margin="0,0,7,0" VerticalAlignment="Center"
                                              Data="M8,14 C8,14 1,9.5 1,5.2 C1,2.8 2.9,1 5.1,1 C6.4,1 7.5,1.7 8,2.6 C8.5,1.7 9.6,1 10.9,1 C13.1,1 15,2.8 15,5.2 C15,9.5 8,14 8,14 Z" />
                                        <TextBlock Text="Погладить" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FeedButton" Grid.Column="2" Click="FeedButton_Click"
                                        ToolTip="Требует одно лакомство, даёт больше CP, чем поглаживание.">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="15" Height="14" Stretch="Uniform" Fill="{StaticResource PrimaryTextBrush}"
                                              Margin="0,0,7,0" VerticalAlignment="Center"
                                              Data="M1,7 L15,7 C15,11.4 11.9,15 8,15 C4.1,15 1,11.4 1,7 Z M3,5 C3,3 5,1.5 8,1.5 C11,1.5 13,3 13,5 Z" />
                                        <TextBlock Text="Покормить" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Progress -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Прогресс" Style="{StaticResource SectionHeaderTextStyle}" />

                            <!-- Each row is led by its concept icon from the shared theme
                                 dictionary — the SAME glyph the desktop progress panel draws,
                                 so the compact indicator on the desktop is traceable to this
                                 full card. Tinted to match the bar underneath it. -->
                            <Grid Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <ContentControl Style="{StaticResource CatchIconStyle}"
                                                    Foreground="{StaticResource AccentRedBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="До поимки" Style="{StaticResource MetaTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="CatchPercentText" Style="{StaticResource MetaTextStyle}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar x:Name="CatchProgressBar" Style="{StaticResource CatchProgressBarStyle}"
                                         Minimum="0" Maximum="1" Margin="0,0,0,12"
                                         ToolTip="Прогресс до следующей поимки" />

                            <Grid Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <ContentControl Style="{StaticResource EvolutionIconStyle}"
                                                    Foreground="{StaticResource RarityRareBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="До эволюции" Style="{StaticResource MetaTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="EvolutionPercentText" Style="{StaticResource MetaTextStyle}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar x:Name="EvolutionProgressBar" Style="{StaticResource EvolutionProgressBarStyle}"
                                         Minimum="0" Maximum="1" Margin="0,0,0,8"
                                         ToolTip="Прогресс до следующей эволюции активного питомца" />
                            <!-- Evolution is the player's action, like "Вылупить!" on a ready egg. Collapsed (not
                                 merely disabled) while the bar fills, so the card never carries a dead control. -->
                            <!-- No explicit Style: the implicit Button style is the primary
                                 (gold gradient) one, same as the egg's "Вылупить!" button. -->
                            <Button x:Name="EvolveButton" Click="EvolveButton_Click"
                                    Visibility="Collapsed" Margin="0,0,0,12"
                                    ToolTip="Питомец накопил достаточно CP — эволюционируй его!">
                                <TextBlock Text="Эволюционировать!" VerticalAlignment="Center" />
                            </Button>

                            <Grid Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <ContentControl Style="{StaticResource TreatIconStyle}"
                                                    Foreground="{StaticResource RarityUncommonBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="До лакомства" Style="{StaticResource MetaTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TreatPercentText" Style="{StaticResource MetaTextStyle}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar x:Name="TreatProgressBar" Style="{StaticResource TreatProgressBarStyle}"
                                         Minimum="0" Maximum="1" />
                            <TextBlock x:Name="TreatHintText" Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================================= POKÉDEX =================================
             The "everything I own" screen: one card per owned individual, plus the incubating
             eggs. Clicking a card opens the detail overlay with the details and the actions. -->
         <TabItem Header="Покедекс">
            <ScrollViewer x:Name="PokedexScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14">
                    <StackPanel Margin="0,0,0,10"><TextBlock Text="Покедекс" Style="{StaticResource ScreenTitleTextStyle}"/><TextBlock x:Name="PokedexCountText" Style="{StaticResource MetaTextStyle}"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="IndividualsModeButton" Content="Мои покемоны" MinWidth="150"
                                Click="IndividualsMode_Click" Margin="0,0,6,0" Style="{StaticResource NdChoiceSelectedStyle}" />
                        <Button x:Name="SpeciesModeButton" Content="Все виды" MinWidth="150"
                                Click="SpeciesMode_Click" Style="{StaticResource NdChoiceStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="SpeciesPane" Visibility="Collapsed">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Поиск по имени, номеру или местности" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SpeciesSearchBox" Tag="Имя, номер или местность" Style="{StaticResource ThemedTextBoxStyle}" MaxLength="40" TextChanged="SpeciesFilters_Changed" AutomationProperties.Name="Поиск видов по имени, номеру или местности"/>
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Bottom">
                                <RadioButton x:Name="SpeciesNormalToggle" Content="Обычные" GroupName="SpeciesForm" IsChecked="True" Checked="SpeciesForm_Changed" Style="{StaticResource FilterPillStyle}"/>
                                <RadioButton x:Name="SpeciesShinyToggle" Content="Shiny" GroupName="SpeciesForm" Checked="SpeciesForm_Changed" Style="{StaticResource FilterPillStyle}"/>
                            </WrapPanel>
                        </Grid>
                        <WrapPanel Margin="0,0,0,8">
                            <ComboBox x:Name="SpeciesSortCombo" Width="140" Margin="0,0,8,4" SelectionChanged="SpeciesFilters_Changed"
                                      AutomationProperties.Name="Сортировка видов" SelectedIndex="0">
                                <ComboBoxItem Content="По номеру"/><ComboBoxItem Content="По дате"/><ComboBoxItem Content="По типу"/>
                            </ComboBox>
                            <ComboBox x:Name="SpeciesTypeCombo" Width="170" Margin="0,0,8,4" SelectionChanged="SpeciesFilters_Changed"
                                      AutomationProperties.Name="Тип вида" SelectedIndex="0">
                                <ComboBoxItem Content="Тип: любой"/>
                            </ComboBox>
                            <ComboBox x:Name="SpeciesRarityCombo" Width="178" Margin="0,0,8,4" SelectionChanged="SpeciesFilters_Changed"
                                      AutomationProperties.Name="Редкость вида" SelectedIndex="0">
                                <ComboBoxItem Content="Редкость: любая"/>
                                <ComboBoxItem Content="Обычный" Tag="Common"/><ComboBoxItem Content="Необычный" Tag="Uncommon"/>
                                <ComboBoxItem Content="Редкий" Tag="Rare"/><ComboBoxItem Content="Легендарный" Tag="Legendary"/>
                            </ComboBox>

                        </WrapPanel>
                        <TextBlock x:Name="SpeciesCountText" Style="{StaticResource MetaTextStyle}" Margin="0,0,0,7"/>
                        <ListBox x:Name="SpeciesGrid" SelectionChanged="SpeciesGrid_SelectionChanged" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource UiCardListItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Виды Покедекса">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Width="158" Margin="3" Padding="9"
                                            AutomationProperties.Name="{Binding AccessibleName}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Number}" Style="{StaticResource MetaTextStyle}"/>
                                            <Grid Height="76" Margin="0,3">
                                                <Image Source="{Binding SpriteImage}" Width="72" Height="72"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       Visibility="{Binding RevealedVisibility}"/>
                                                <Border Width="72" Height="72" Background="{StaticResource MutedTextBrush}"
                                                        Visibility="{Binding SilhouetteVisibility}" Opacity="0.7">
                                                    <Border.OpacityMask><ImageBrush ImageSource="{Binding SpriteImage}" Stretch="Uniform"/></Border.OpacityMask>
                                                </Border>
                                                <TextBlock Text="?" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding UnknownVisibility}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding NameText}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Bold" TextWrapping="Wrap" Height="40" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SubText}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Height="38" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="SpeciesPagination" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button x:Name="SpeciesPrevButton" Content="Назад" Click="SpeciesPrev_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            <TextBlock x:Name="SpeciesPageText" VerticalAlignment="Center" Margin="10,0"/>
                            <Button x:Name="SpeciesNextButton" Content="Вперёд" Click="SpeciesNext_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>

                    </StackPanel>

                    <StackPanel x:Name="IndividualsPane">

                    <Grid x:Name="PokedexFilterGrid" Margin="0,0,0,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="200"/><ColumnDefinition Width="*" MinWidth="130"/><ColumnDefinition Width="*" MinWidth="120"/><ColumnDefinition Width="*" MinWidth="140"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="PokedexSearchBox" Grid.Column="0" Margin="0,0,8,0" Tag="Имя, кличка или номер" Style="{StaticResource ThemedTextBoxStyle}" MaxLength="30" TextChanged="PokedexSearchBox_TextChanged" AutomationProperties.Name="Поиск своих покемонов"/>
                        <ComboBox x:Name="PokedexSortCombo" Grid.Column="1" Margin="0,0,8,0" SelectionChanged="PokedexSortCombo_SelectionChanged" AutomationProperties.Name="Сортировка питомцев">
                            <ComboBoxItem Content="По номеру" IsSelected="True"/><ComboBoxItem Content="По уровню"/><ComboBoxItem Content="По дате поимки"/><ComboBoxItem Content="По уходу для эволюции"/>
                        </ComboBox>
                        <ComboBox x:Name="IndividualTypeCombo" Grid.Column="2" Margin="0,0,8,0" SelectionChanged="IndividualType_Changed" AutomationProperties.Name="Тип питомца"><ComboBoxItem Content="Все типы" IsSelected="True"/></ComboBox>
                        <ComboBox x:Name="IndividualRarityCombo" Grid.Column="3" SelectionChanged="IndividualRarity_Changed" AutomationProperties.Name="Редкость питомца">
                            <ComboBoxItem x:Name="RarityFilterAll" Content="Редкость" IsSelected="True"/>
                            <ComboBoxItem x:Name="RarityFilterCommon" Tag="Common"/><ComboBoxItem x:Name="RarityFilterUncommon" Tag="Uncommon"/><ComboBoxItem x:Name="RarityFilterRare" Tag="Rare"/><ComboBoxItem x:Name="RarityFilterLegendary" Tag="Legendary"/>
                        </ComboBox>
                    </Grid>
                    <DockPanel Margin="0,0,0,10">
                        <Button x:Name="ResetIndividualFiltersButton" Content="Сбросить" DockPanel.Dock="Right" Click="ResetIndividualFilters_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5"/>
                        <WrapPanel VerticalAlignment="Center">
                            <CheckBox x:Name="EvolutionFilterToggle" Content="Есть куда расти" Checked="EvolutionFilter_Changed" Unchecked="EvolutionFilter_Changed"/>
                            <CheckBox x:Name="DuplicatesFilterToggle" Content="Дубли" Margin="12,0,0,0" Checked="IndividualExtraFilter_Changed" Unchecked="IndividualExtraFilter_Changed"/>
                            <CheckBox x:Name="FavoritesFilterToggle" Content="Избранные" Margin="12,0,0,0" Checked="IndividualExtraFilter_Changed" Unchecked="IndividualExtraFilter_Changed"/>
                            <CheckBox x:Name="ShinyFilterToggle" Content="Shiny" Margin="12,0,0,0" Checked="IndividualExtraFilter_Changed" Unchecked="IndividualExtraFilter_Changed"/>
                        </WrapPanel>
                    </DockPanel>
                    <TextBlock x:Name="PokedexEmptyText" Style="{StaticResource CaptionTextStyle}" Margin="2,0,0,0"
                               Text="Пока пусто — поймай первого покемона на вкладке «Поймать»." />

                    <ItemsControl x:Name="PokedexGrid" Margin="-4,0,-4,0" SizeChanged="PokedexGrid_SizeChanged">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- A mouse handler on the Border rather than wrapping the card in a Button, which would
                                     layer a second chrome and focus rect over the card's own hover/shadow. CardStyle's
                                     Background makes the whole face hit-testable.

                                     MouseLeftButtonDOWN, not Up, and that is load-bearing: the detail overlay dismisses on
                                     mouse-DOWN, so a card opening on Up split one physical click across two visual trees —
                                     the down-stroke dismissed the overlay and the up-stroke opened whatever card lay under
                                     the pointer. Open and dismiss fire on the same event, so the overlay eats the whole click. -->
                                <!-- D-17: a tile in the full-width grid; the pet's page slides in beside the grid. Date and
                                     types live on the page and in the tooltip, the tile keeps only what scanning 800 pets needs. -->
                                <Border Style="{StaticResource CardStyle}" Width="{DynamicResource PokedexCardWidth}" Margin="4" Padding="8"
                                        Cursor="Hand" Tag="{Binding IndividualId}" Focusable="True"
                                        MouseLeftButtonDown="PokedexCard_Click"
                                        KeyDown="PokedexCard_KeyDown"
                                        GotKeyboardFocus="PokedexCard_GotKeyboardFocus"
                                        LostKeyboardFocus="PokedexCard_LostKeyboardFocus"
                                        AutomationProperties.Name="{Binding AccessibleName}"
                                        ToolTip="{Binding AccessibleName}">
                                    <StackPanel>
                                        <Grid>
                                            <Border Style="{StaticResource WellStyle}" Height="76">
                                                <Grid>
                                                    <Image Width="64" Height="64" Source="{Binding SpriteImage}"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                           Loaded="PokedexSprite_Loaded" Unloaded="PokedexSprite_Unloaded" />
                                                    <Grid Width="26" Height="26" Opacity="0.45" Visibility="{Binding PlaceholderVisibility}">
                                                        <Ellipse Stroke="{StaticResource MutedTextBrush}" StrokeThickness="2" />
                                                        <Border Height="2" Background="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0">
                                                <Ellipse Width="9" Height="9" Margin="0,0,4,0" Fill="{StaticResource AccentGoldBrush}"
                                                         Visibility="{Binding ActiveBadgeVisibility}" ToolTip="Сейчас на рабочем столе" />
                                                <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,3,0"
                                                      Visibility="{Binding FavoriteBadgeVisibility}" Fill="{StaticResource AccentGoldBrush}"
                                                      Data="M12,2 L15.09,8.26 L22,9.27 L17,14.14 L18.18,21.02 L12,17.77 L5.82,21.02 L7,14.14 L2,9.27 L8.91,8.26 Z" />
                                                <TextBlock Text="✨" FontSize="10" Visibility="{Binding ShinyVisibility}" />
                                            </StackPanel>
                                            <Ellipse Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,0,0"
                                                     Fill="{Binding RarityBrush}" ToolTip="{Binding RarityName}" />
                                        </Grid>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Bold" FontSize="13"
                                                   Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding LevelText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding DexNumber, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Pagination. Collapsed outright while everything fits on one page — a
                         permanently-disabled Назад/Вперёд pair under a 3-card grid would read
                         as broken chrome. The page survives the once-a-second refresh tick and
                         resets only when the rarity filter or the search query changes. -->
                    <StackPanel x:Name="PokedexPagination" Orientation="Horizontal" Visibility="Collapsed"
                                HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="PokedexPrevPageButton" Content="Назад" Padding="12,5"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="PokedexPrevPage_Click" />
                        <TextBlock x:Name="PokedexPageText" Style="{StaticResource MetaTextStyle}"
                                   VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold" />
                        <Button x:Name="PokedexNextPageButton" Content="Вперёд" Padding="12,5"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="PokedexNextPage_Click" />
                    </StackPanel>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>

        <!-- ===================== POKÉDEX DETAIL OVERLAY =====================
             The dimmed backdrop closes the card: MouseLeftButtonDown on it hides the layer, and the
             card marks the event Handled so a click INSIDE the card never bubbles up here. ZIndex
             keeps it over the TabControl regardless of declaration order.

             Names are Detail*-prefixed because several (SpriteImage, ShinyBadge) would collide with
             the home tab's elements in the shared namescope. -->
        <Border x:Name="DetailOverlay" Panel.ZIndex="10" Visibility="Collapsed" Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" MouseLeftButtonDown="DetailOverlay_MouseLeftButtonDown">
            <Grid x:Name="DetailOverlayArea" Margin="24,14">
                <Border x:Name="DetailCard" Background="{StaticResource WindowBackgroundBrush}" MouseLeftButtonDown="DetailCard_MouseLeftButtonDown">
                    <DockPanel>
                        <DockPanel x:Name="DetailIdentityHeader" DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0">
                                <Button x:Name="DetailSelectButton" Content="На рабочий стол" Click="DetailSelectButton_Click" Style="{StaticResource UiPrimaryButtonStyle}" MinHeight="40" Padding="12,7" Margin="0,0,8,0"/>
                                <Button x:Name="DetailFavoriteButton" Style="{StaticResource FavoriteToggleStyle}" Click="DetailFavoriteButton_Click" Margin="0,0,8,0"><Path x:Name="DetailFavoriteStar" Width="19" Height="19" Stretch="Uniform" Data="M12,2 L15,8 22,9 17,14 18,21 12,18 6,21 7,14 2,9 9,8 Z"/></Button>
                                <Button x:Name="DetailBackButton" Content="К покедексу" Click="DetailBack_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                            <StackPanel>
                                <Button x:Name="DetailNameButton" Click="DetailName_Click" Style="{StaticResource UiHeaderButtonStyle}" HorizontalAlignment="Left" Padding="2,0" ToolTip="Изменить кличку">
                                    <DockPanel><Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource UiSecondaryInkBrush}" StrokeThickness="1.6" Data="M3 14L2 20 8 19 20 7 15 2Z M12 5L17 10" DockPanel.Dock="Right" Margin="8,0,2,0"/>
                                        <TextBlock x:Name="DetailSpeciesNameText" Style="{StaticResource ScreenTitleTextStyle}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Button>
                                <StackPanel x:Name="DetailNicknameEditor" Visibility="Collapsed">
                                    <TextBox x:Name="DetailNicknameBox" MaxLength="20" PreviewKeyDown="DetailNickname_KeyDown" Style="{StaticResource ThemedTextBoxStyle}" AutomationProperties.Name="Кличка питомца"/>
                                    <TextBlock Text="До 20 символов. Пустое поле вернёт имя вида." Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                    <WrapPanel><Button x:Name="DetailNicknameSaveButton" Content="Сохранить" Click="DetailNicknameSave_Click" Style="{StaticResource UiPrimaryButtonStyle}" MinHeight="40" Padding="10,7" Margin="0,0,8,0"/><Button x:Name="DetailNicknameCancelButton" Content="Отмена" Click="DetailNicknameCancel_Click" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel>
                                </StackPanel>
                                <WrapPanel><TextBlock x:Name="DetailSpeciesSubtitleText" Style="{StaticResource MetaTextStyle}" Margin="0,0,8,0"/><TextBlock x:Name="DetailDexNumberText" Style="{StaticResource MetaTextStyle}"/></WrapPanel>
                                <WrapPanel Margin="0,4,0,0"><TextBlock x:Name="DetailNatureText" Style="{StaticResource CaptionTextStyle}" Margin="0,0,12,0"/><TextBlock x:Name="DetailCaughtAtText" Style="{StaticResource CaptionTextStyle}"/></WrapPanel>
                                <TextBlock x:Name="DetailTrainerNote" FontFamily="{DynamicResource NdHandFont}" FontSize="22" Foreground="{StaticResource AccentRedBrush}" Opacity="0.85"
                                           TextWrapping="Wrap" Margin="0,6,0,0" Padding="0,3,0,0" IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                                    <TextBlock.RenderTransform><RotateTransform Angle="-1.5"/></TextBlock.RenderTransform></TextBlock>
                                <WrapPanel Margin="0,8,0,0">
                                    <Border x:Name="DetailActiveBadge" Visibility="Collapsed" Style="{StaticResource PillStyle}" BorderBrush="{StaticResource AccentGoldBrush}" Padding="9,2" Margin="0,0,6,0"><TextBlock Text="На рабочем столе" Foreground="{StaticResource AccentGoldBrush}" FontSize="12" FontWeight="SemiBold"/></Border>
                                    <Border x:Name="DetailFavoriteBadge" Visibility="Collapsed" Style="{StaticResource PillStyle}" Padding="9,2"><TextBlock Text="★ Избранный" FontSize="12"/></Border>
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="DetailErrorText" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                        <DockPanel x:Name="EvolutionFooter" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,12,0,0">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="EvolutionLaterButton" Content="Позже" Click="DetailConditionsBack_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/><Button x:Name="DetailEvolveButton" Content="Эволюционировать" Click="DetailEvolveButton_Click"/></StackPanel>
                                            <WrapPanel><Button x:Name="DetailEvolutionShopButton" Content="В магазин" Click="DetailEvolutionShopButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button x:Name="DetailEvolutionRouteButton" Content="В поход" Click="DetailEvolutionRouteButton_Click" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel>
                                        </DockPanel>
                        <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid x:Name="DetailPersonalGrid">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <Grid Height="155">
                                            <Ellipse Width="160" Height="155" Fill="{StaticResource SpotlightBrush}"/>
                                            <Image x:Name="DetailSpriteImage" Width="140" Height="140" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            <TextBlock x:Name="DetailSpritePlaceholder" Text="Изображение формы&#10;пока недоступно" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                                            <Border x:Name="DetailShinyBadge" Style="{StaticResource PillStyle}" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="Shiny"/></Border>
                                        </Grid>
                                        <WrapPanel HorizontalAlignment="Center" Margin="0,5">
                                            <ItemsControl x:Name="DetailTypeBadges" ItemsPanel="{StaticResource TypeBadgePanelTemplate}" ItemTemplate="{StaticResource TypeBadgeTemplate}" Margin="0,0,8,0"/>
                                            <Border x:Name="DetailRarityPill" Style="{StaticResource PillStyle}" BorderThickness="1.4" CornerRadius="5" Padding="6,1.5" Margin="0,0,4,3"><StackPanel Orientation="Horizontal"><Ellipse x:Name="DetailRarityDot" Width="6" Height="6" Margin="0,0,5,0"/><TextBlock x:Name="DetailRarityText" FontSize="9.5" FontWeight="SemiBold"/></StackPanel></Border>
                                        </WrapPanel>
                                        <Border x:Name="DetailEvolutionChainSection" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <StackPanel>
                                                <DockPanel><Button x:Name="DetailConditionsButton" Content="Условия" DockPanel.Dock="Right" Click="DetailConditions_Click" Style="{StaticResource SecondaryButtonStyle}"/><TextBlock Text="Эволюция" Style="{StaticResource SectionHeaderTextStyle}"/></DockPanel>
                                                <ItemsControl x:Name="DetailEvolutionChainStrip" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="DetailFactSection" Padding="0,10">
                                            <StackPanel><TextBlock Text="О виде" Style="{StaticResource SectionHeaderTextStyle}"/><TextBlock x:Name="DetailDescriptionText" TextWrapping="Wrap"/></StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="DetailLevelText" FontWeight="Bold"/>
                                        <TextBlock x:Name="DetailXpText" TextWrapping="Wrap" Margin="0,4,0,4"/>
                                        <ProgressBar x:Name="DetailXpBar" Style="{StaticResource UiGreenProgressBarStyle}" Minimum="0" Maximum="1"/>
                                        <TextBlock Text="Уход для эволюции" FontWeight="Bold" Margin="0,12,0,2"/>
                                        <TextBlock x:Name="DetailEvolutionText" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                                        <ProgressBar x:Name="DetailEvolutionBar" Style="{StaticResource UiGreenProgressBarStyle}" Minimum="0" Maximum="1"/>
                                        <TextBlock x:Name="DetailTraitsText" TextWrapping="Wrap" Margin="0,14,0,10"/>
                                        <Border x:Name="DetailRetrainingSection" Padding="0,0,0,12" Visibility="Collapsed"><StackPanel>
                                            <Button x:Name="DetailRetrainingToggle" Content="Переобучение" Click="DetailRetrainingToggle_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/>
                                            <StackPanel x:Name="DetailRetrainingEditor" Visibility="Collapsed" Margin="0,8,0,0">
                                                <ComboBox x:Name="DetailRetrainingSlotPicker" SelectionChanged="DetailRetrainingSlotPicker_SelectionChanged" AutomationProperties.Name="Особенность для переобучения"/>
                                                <TextBlock x:Name="DetailRetrainingCostText" TextWrapping="Wrap" Margin="0,6,0,4"/><TextBlock x:Name="DetailRetrainingOutcomesText" TextWrapping="Wrap"/><TextBlock x:Name="DetailRetrainingReasonText" TextWrapping="Wrap"/>
                                                <WrapPanel Margin="0,8,0,0"><Button x:Name="DetailRetrainButton" Content="Переобучить" Click="DetailRetrainButton_Click" Margin="0,0,8,0"/><Button x:Name="DetailRetrainingShopButton" Content="В магазин" Click="DetailRetrainingShopButton_Click" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel>
                                            </StackPanel>
                                        </StackPanel></Border>
                                        <Border x:Name="DetailItemsSection" Style="{StaticResource CardStyle}" Padding="12" Margin="0,4,0,10"><StackPanel>
                                            <TextBlock Text="Помочь питомцу" Style="{StaticResource SectionHeaderTextStyle}"/>
                                            <DockPanel Margin="0,8,0,0"><Button x:Name="DetailCareBoosterButton" Content="Применить" Tag="care-booster" Click="DetailItem_Click" DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Image x:Name="DetailCareBoosterImage" Source="/PokeCorner;component/Assets/UiSystem/care-booster.png" Width="32" Height="40" DockPanel.Dock="Left" Margin="0,0,8,0"/><TextBlock x:Name="DetailCareBoosterText" TextWrapping="Wrap"/></DockPanel>
                                        <DockPanel Margin="0,12,0,0"><Button x:Name="DetailXpPotionButton" Content="Применить" Tag="xp-potion" Click="DetailItem_Click" DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Image x:Name="DetailXpPotionImage" Source="/PokeCorner;component/Assets/UiSystem/xp-potion.png" Width="32" Height="40" DockPanel.Dock="Left" Margin="0,0,8,0"/><TextBlock x:Name="DetailXpPotionText" TextWrapping="Wrap"/></DockPanel>
                                        </StackPanel></Border>
                                        <TextBlock x:Name="DetailBusyText" Style="{StaticResource MetaTextStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="EvolutionSurface" Visibility="Collapsed">
                                    <Border x:Name="DetailEvolutionActionSection" Padding="0" Visibility="Collapsed"><StackPanel>
                                        <DockPanel Margin="0,0,0,10"><Button Content="← К питомцу" Click="DetailConditionsBack_Click" DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}"/><StackPanel><TextBlock Text="Время расти" Style="{StaticResource ScreenTitleTextStyle}"/><TextBlock Text="Помоги питомцу сделать следующий шаг." Style="{StaticResource MetaTextStyle}"/></StackPanel></DockPanel>
                                        <ItemsControl x:Name="DetailEvolutionTargets" Margin="0,0,0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,8,0"><StackPanel>
                                                <TextBlock Text="Забота помогает ему вырасти" Style="{StaticResource SectionHeaderTextStyle}"/>
                                                <DockPanel Margin="0,10,0,5"><TextBlock x:Name="EvolutionCareStateText" DockPanel.Dock="Right" FontWeight="Bold"/><TextBlock Text="Уход для эволюции"/></DockPanel>
                                                <ProgressBar x:Name="EvolutionCareBar" Style="{StaticResource UiGreenProgressBarStyle}" Minimum="0" Maximum="1"/>
                                                <TextBlock Text="Уровень, кличка и особенности сохранятся." TextWrapping="Wrap" Margin="0,12,0,0" Style="{StaticResource CaptionTextStyle}"/>
                                            </StackPanel></Border>
                                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14" Margin="8,0,0,0"><StackPanel>
                                                <TextBlock Text="Понадобится" Style="{StaticResource SectionHeaderTextStyle}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8"><Image x:Name="EvolutionBerryImage" Width="34" Height="34"/><TextBlock x:Name="DetailEvolutionCostText" VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap"/><Image x:Name="EvolutionRequiredStoneImage" Source="/PokeCorner;component/Assets/UiSystem/evolution-stone.png" Width="34" Height="34"/><TextBlock x:Name="EvolutionRequiredStoneText" VerticalAlignment="Center" Margin="6,0"/></StackPanel>
                                                <CheckBox x:Name="DetailEvolutionStoneToggle" Checked="EvolutionStone_Changed" Unchecked="EvolutionStone_Changed" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Использовать камень выбора">
                                                    <CheckBox.Template><ControlTemplate TargetType="CheckBox"><Border x:Name="StoneSurface" Background="#FBF9F1" BorderBrush="{StaticResource UiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter/><TextBlock x:Name="StoneCheck" Grid.Column="1" Text="✓" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource UiForestBrush}"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="StoneSurface" Property="Background" Value="#E1EDD8"/><Setter TargetName="StoneSurface" Property="BorderBrush" Value="{StaticResource UiForestBrush}"/><Setter TargetName="StoneCheck" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="StoneSurface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></CheckBox.Template>
                                                    <StackPanel Orientation="Horizontal"><Image Source="/PokeCorner;component/Assets/UiSystem/evolution-stone.png" x:Name="DetailStoneImage" Width="44" Height="44" Margin="0,0,10,0"/><StackPanel><TextBlock Text="Камень эволюции" FontWeight="Bold"/><TextBlock x:Name="DetailStoneStockText"/><TextBlock Text="Выбрать будущую форму" Style="{StaticResource CaptionTextStyle}"/></StackPanel></StackPanel>
                                                </CheckBox>
                                                <ComboBox x:Name="DetailEvolutionBranchPicker" Margin="0,8,0,0" SelectionChanged="DetailEvolutionBranchPicker_SelectionChanged" AutomationProperties.Name="Ветвь эволюции"/>
                                                <TextBlock x:Name="DetailEvolutionBlockedText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                <TextBlock x:Name="DetailEvolutionReasonText" Foreground="{StaticResource AccentRedBrush}" TextWrapping="Wrap" Margin="0,4"/>
                                            </StackPanel></Border>
                                        </Grid>



                                    </StackPanel></Border>
                                </Border>
                                <DockPanel x:Name="DetailRehomeSection" Margin="0,14,0,0">
                                    <Button x:Name="DetailRehomeButton" Content="Найти новый дом" Click="DetailRehomeButton_Click" DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/>
                                    <TextBlock x:Name="DetailRehomeReasonText" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"/>
                                </DockPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
        <!-- D-20: the species page slides in on the right like a pet's page; the species grid narrows beside it. -->
        <Border x:Name="SpeciesDialog" Panel.ZIndex="15" Visibility="Collapsed" Background="{StaticResource WindowBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel Margin="24,14,16,14">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button x:Name="SpeciesBackButton" Content="✕" Click="SpeciesBack_Click" DockPanel.Dock="Right" VerticalAlignment="Top"
                            Style="{StaticResource SecondaryButtonStyle}" ToolTip="Закрыть" AutomationProperties.Name="Закрыть страницу вида"/>
                    <StackPanel>
                        <TextBlock x:Name="SpeciesDetailName" Style="{StaticResource ScreenTitleTextStyle}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SpeciesDetailTypes" Style="{StaticResource MetaTextStyle}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
                <ScrollViewer x:Name="SpeciesPageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SpeciesDetail" Margin="0,0,8,0">
                        <UniformGrid x:Name="SpeciesForms" Columns="2" Margin="0,0,0,12"/>
                        <TextBlock x:Name="SpeciesDetailDescription" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock x:Name="SpeciesPathsHeader" Text="Где найти" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,6"/>
                        <StackPanel x:Name="SpeciesPathsPanel"/>
                        <TextBlock x:Name="SpeciesPathsMessage" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource DangerTextBrush}" Margin="0,2,0,8"/>
                        <TextBlock x:Name="SpeciesDetailOwnedLabel" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,14,0,6"/>
                        <ItemsControl x:Name="SpeciesOwnedList">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Tag="{Binding IndividualId}" Click="SpeciesOwned_Click" Style="{StaticResource SecondaryButtonStyle}"
                                        Width="132" Margin="0,0,6,6" Padding="8" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Label}">
                                    <StackPanel>
                                        <Image Source="{Binding Sprite}" Width="48" Height="48" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <local:ConfirmationOverlay x:Name="LocalConfirmationHost" Panel.ZIndex="20" Visibility="Collapsed"/>
    </Grid>
</UserControl>
