<UserControl x:Class="PokeCorner.App.Popup.CollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Two layers: the tabs, and the Pokédex detail card that overlays them. The card used to
         be a separate top-level Window (PokemonDetailWindow) opened with ShowDialog(); the user
         found a second OS window spawning out of a card "foreign", so it is an in-view overlay
         now. Same content, same callbacks — only the hosting changed. -->
    <Grid>
    <TabControl>
        <!-- ============================== HOME ==============================
             Deliberately only "what is happening right now": the active pet and its three
             progress bars. The full collection — incubating eggs and every owned individual —
             lives one tab over in the Pokédex, which is the "everything I have" screen.

             The "Мои покемоны" roster list used to sit under the Pokédex tab alongside the
             species grid. It is gone: the two showed the same name, rarity and sprite in two
             parallel lists, and the grid now covers both jobs (see its own comment). -->
        <TabItem Header="Мой покемон">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14">

                    <!-- Hero spotlight: the active Pokémon is the reason the app exists, so it
                         gets the largest element on the screen rather than a 48px corner thumb. -->
                    <Border Style="{StaticResource HeroCardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Height="144">
                                <Ellipse Width="210" Height="138" Fill="{StaticResource SpotlightBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="ActiveSpriteImage" Width="124" Height="124"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <!-- Pokéball silhouette shown until the sprite is cached on disk. -->
                                <Grid x:Name="ActiveSpritePlaceholder" Width="76" Height="76"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5">
                                    <Ellipse Stroke="{StaticResource MutedTextBrush}" StrokeThickness="3" />
                                    <Border Height="3" Background="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                    <Ellipse Width="24" Height="24" Fill="{StaticResource WindowBackgroundBrush}"
                                             Stroke="{StaticResource MutedTextBrush}" StrokeThickness="3"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <Border x:Name="ShinyBadge" Style="{StaticResource PillStyle}" Visibility="Collapsed"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        BorderBrush="{StaticResource AccentGoldBrush}"
                                        ToolTip="Шайни — редкая цветовая форма">
                                    <TextBlock Text="✨ Shiny" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentGoldBrush}" />
                                </Border>
                            </Grid>

                            <TextBlock x:Name="ActivePetNameText" Style="{StaticResource ScreenTitleTextStyle}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="ActivePetMetaText" Style="{StaticResource MetaTextStyle}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,3,0,7" />

                            <!-- Type badges for the active pet. Centered under the meta line so
                                 the hero reads name -> stats -> types top to bottom. -->
                            <ItemsControl x:Name="ActiveTypeBadges"
                                          HorizontalAlignment="Center" Margin="0,0,0,7"
                                          ItemsPanel="{StaticResource TypeBadgePanelTemplate}"
                                          ItemTemplate="{StaticResource TypeBadgeTemplate}" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource WellStyle}" Padding="12,9"
                                        ToolTip="CP активного питомца — растёт от активности за ПК">
                                    <StackPanel>
                                        <!-- "CP", not "очки роста": the shop's CP Booster already
                                             called it CP, and two names for one number read as two
                                             different stats. -->
                                        <TextBlock Text="CP" Style="{StaticResource StatLabelTextStyle}" />
                                        <TextBlock x:Name="CarePointsText" Style="{StaticResource StatValueTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource WellStyle}" Padding="12,9"
                                        ToolTip="Лакомства зарабатываются активностью и тратятся на кормление">
                                    <StackPanel>
                                        <TextBlock Text="ЛАКОМСТВА" Style="{StaticResource StatLabelTextStyle}" />
                                        <TextBlock x:Name="TreatsText" Style="{StaticResource StatValueTextStyle}"
                                                   Foreground="{StaticResource AccentGoldBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PetButton" Grid.Column="0" Click="PetButton_Click"
                                        ToolTip="Бесплатно, всегда доступно. Тот же эффект, что и клик по питомцу на рабочем столе.">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="15" Height="14" Stretch="Uniform" Fill="{StaticResource PrimaryTextBrush}"
                                              Margin="0,0,7,0" VerticalAlignment="Center"
                                              Data="M8,14 C8,14 1,9.5 1,5.2 C1,2.8 2.9,1 5.1,1 C6.4,1 7.5,1.7 8,2.6 C8.5,1.7 9.6,1 10.9,1 C13.1,1 15,2.8 15,5.2 C15,9.5 8,14 8,14 Z" />
                                        <TextBlock Text="Погладить" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FeedButton" Grid.Column="2" Click="FeedButton_Click"
                                        ToolTip="Требует одно лакомство, даёт больше CP, чем поглаживание.">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="15" Height="14" Stretch="Uniform" Fill="{StaticResource PrimaryTextBrush}"
                                              Margin="0,0,7,0" VerticalAlignment="Center"
                                              Data="M1,7 L15,7 C15,11.4 11.9,15 8,15 C4.1,15 1,11.4 1,7 Z M3,5 C3,3 5,1.5 8,1.5 C11,1.5 13,3 13,5 Z" />
                                        <TextBlock Text="Покормить" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Progress -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Прогресс" Style="{StaticResource SectionHeaderTextStyle}" />

                            <!-- Each row is led by its concept icon from the shared theme
                                 dictionary — the SAME glyph the desktop progress panel draws,
                                 so the compact indicator on the desktop is traceable to this
                                 full card. Tinted to match the bar underneath it. -->
                            <Grid Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <ContentControl Style="{StaticResource CatchIconStyle}"
                                                    Foreground="{StaticResource AccentRedBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="До поимки" Style="{StaticResource MetaTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="CatchPercentText" Style="{StaticResource MetaTextStyle}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar x:Name="CatchProgressBar" Style="{StaticResource CatchProgressBarStyle}"
                                         Minimum="0" Maximum="1" Margin="0,0,0,12"
                                         ToolTip="Прогресс до следующей поимки" />

                            <Grid Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <ContentControl Style="{StaticResource EvolutionIconStyle}"
                                                    Foreground="{StaticResource RarityRareBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="До эволюции" Style="{StaticResource MetaTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="EvolutionPercentText" Style="{StaticResource MetaTextStyle}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar x:Name="EvolutionProgressBar" Style="{StaticResource EvolutionProgressBarStyle}"
                                         Minimum="0" Maximum="1" Margin="0,0,0,8"
                                         ToolTip="Прогресс до следующей эволюции активного питомца" />
                            <!-- Evolution no longer fires by itself the moment the bar fills:
                                 the player presses this, exactly like "Вылупить!" on a ready egg.
                                 Collapsed (not merely disabled) while the bar is still filling, so
                                 the card doesn't carry a permanently greyed-out control. -->
                            <!-- No explicit Style: the implicit Button style is the primary
                                 (gold gradient) one, same as the egg's "Вылупить!" button. -->
                            <Button x:Name="EvolveButton" Click="EvolveButton_Click"
                                    Visibility="Collapsed" Margin="0,0,0,12"
                                    ToolTip="Питомец накопил достаточно CP — эволюционируй его!">
                                <TextBlock Text="Эволюционировать!" VerticalAlignment="Center" />
                            </Button>

                            <Grid Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <ContentControl Style="{StaticResource TreatIconStyle}"
                                                    Foreground="{StaticResource RarityUncommonBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="До лакомства" Style="{StaticResource MetaTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TreatPercentText" Style="{StaticResource MetaTextStyle}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar x:Name="TreatProgressBar" Style="{StaticResource TreatProgressBarStyle}"
                                         Minimum="0" Maximum="1" />
                            <TextBlock x:Name="TreatHintText" Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================================= POKÉDEX =================================
             The "everything I own" screen, and now the ONLY list of owned Pokémon: one card
             per owned individual (not per distinct species), plus the incubating eggs.
             Clicking a card opens PokemonDetailWindow for the details and the actions. -->
        <TabItem Header="Pokédex">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Pokédex" Style="{StaticResource ScreenTitleTextStyle}" />
                                <TextBlock x:Name="PokedexCountText" Style="{StaticResource MetaTextStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Grid Width="46" Height="46" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Stroke="{StaticResource AccentRedBrush}" StrokeThickness="3" />
                                <Border Height="3" Background="{StaticResource AccentRedBrush}" VerticalAlignment="Center" />
                                <Ellipse Width="15" Height="15" Fill="{StaticResource CardBackgroundBrush}"
                                         Stroke="{StaticResource AccentRedBrush}" StrokeThickness="3"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Search. Filters on the SPECIES name and the player's own nickname, so
                         "sparky" finds a nicknamed Pikachu and "pika" finds it too. ANDs with
                         the rarity pills below, and resets the page to 1 on every keystroke —
                         staying on page 4 of a two-page result would look like an empty grid. -->
                    <TextBlock Text="Поиск" Style="{StaticResource SectionHeaderTextStyle}" />
                    <TextBox x:Name="PokedexSearchBox" Style="{StaticResource ThemedTextBoxStyle}"
                             Margin="2,0,2,10" MaxLength="30"
                             TextChanged="PokedexSearchBox_TextChanged"
                             ToolTip="Фильтр по имени вида или по прозвищу" />

                    <!-- Rarity filter. RadioButtons sharing a GroupName give exactly-one-active
                         for free; each carries its tier's theme brush in Tag, which FilterPillStyle
                         renders as the dot and the checked-state ring. Tag on the buttons is also
                         what the code-behind reads back to know which tier is selected. -->
                    <TextBlock Text="Редкость" Style="{StaticResource SectionHeaderTextStyle}" />
                    <WrapPanel Margin="2,0,0,4">
                        <RadioButton x:Name="RarityFilterAll" Style="{StaticResource FilterPillStyle}"
                                     GroupName="PokedexRarity" Content="Все" IsChecked="True"
                                     Tag="{StaticResource PrimaryTextBrush}"
                                     Checked="RarityFilter_Checked"
                                     ToolTip="Показать все открытые виды" />
                        <RadioButton x:Name="RarityFilterCommon" Style="{StaticResource FilterPillStyle}"
                                     GroupName="PokedexRarity" Content="Обычные"
                                     Tag="{StaticResource RarityCommonBrush}"
                                     Checked="RarityFilter_Checked" />
                        <RadioButton x:Name="RarityFilterUncommon" Style="{StaticResource FilterPillStyle}"
                                     GroupName="PokedexRarity" Content="Необычные"
                                     Tag="{StaticResource RarityUncommonBrush}"
                                     Checked="RarityFilter_Checked" />
                        <RadioButton x:Name="RarityFilterRare" Style="{StaticResource FilterPillStyle}"
                                     GroupName="PokedexRarity" Content="Редкие"
                                     Tag="{StaticResource RarityRareBrush}"
                                     Checked="RarityFilter_Checked" />
                        <RadioButton x:Name="RarityFilterLegendary" Style="{StaticResource FilterPillStyle}"
                                     GroupName="PokedexRarity" Content="Легендарные"
                                     Tag="{StaticResource RarityLegendaryBrush}"
                                     Checked="RarityFilter_Checked" />
                    </WrapPanel>

                    <!-- Independent (non-exclusive) filter pill, ANDed with rarity + search
                         exactly like they AND with each other — a CheckBox rather than the
                         rarity RadioButtons since it toggles on/off instead of picking one of a
                         set. FilterPillCheckBoxStyle mirrors FilterPillStyle's look. -->
                    <WrapPanel Margin="2,0,0,4">
                        <CheckBox x:Name="EvolutionFilterToggle" Style="{StaticResource FilterPillCheckBoxStyle}"
                                  Content="Не завершившие эволюцию" Tag="{StaticResource PrimaryTextBrush}"
                                  Checked="EvolutionFilter_Changed" Unchecked="EvolutionFilter_Changed"
                                  ToolTip="Показать только тех, кто ещё не достиг финальной стадии" />
                    </WrapPanel>

                    <!-- Sort choice. Default leaves GetEntries' own active/favorites/dex banding
                         alone; the other two options re-order the (already filtered) list — see
                         CollectionViewModel.ApplySort. -->
                    <TextBlock Text="Сортировка" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ComboBox x:Name="PokedexSortCombo" Margin="2,0,2,10" HorizontalAlignment="Left" MinWidth="170"
                              SelectionChanged="PokedexSortCombo_SelectionChanged">
                        <ComboBoxItem Content="По умолчанию" IsSelected="True" />
                        <ComboBoxItem Content="По алфавиту" />
                        <ComboBoxItem Content="По дате поимки" />
                    </ComboBox>

                    <TextBlock x:Name="PokedexEmptyText" Style="{StaticResource CaptionTextStyle}" Margin="2,0,0,0"
                               Text="Пока пусто — поймай первого покемона на вкладке «Поймать»." />

                    <ItemsControl x:Name="PokedexGrid" Margin="-5,0,-5,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- One card per OWNED INDIVIDUAL now, not per distinct species,
                                     so two Pikachus are two cards. Clicking one opens
                                     PokemonDetailWindow with the catch date, nature and the
                                     Выбрать/Отпустить/star actions that used to sit inline on
                                     the separate roster list this grid absorbed.

                                     A mouse handler on the Border rather than wrapping the card
                                     in a Button: the card is already a styled Border with its
                                     own hover/shadow treatment, and a Button around it would
                                     layer a second chrome and focus rect over that. The Border
                                     has a Background from CardStyle, so it is hit-testable
                                     across its whole face, not just on its glyphs.

                                     MouseLeftButtonDOWN, not Up, and that is load-bearing: the
                                     detail overlay dismisses on mouse-DOWN, so a card that
                                     opened on Up got the two halves of one physical click split
                                     across two different visual trees. Clicking the backdrop to
                                     dismiss hid the overlay on the down-stroke, and the up-
                                     stroke then hit-tested straight through to whatever grid
                                     card happened to sit under the pointer — dismissing the
                                     card and instantly opening a DIFFERENT one in a single
                                     click. Open and dismiss must fire on the same event, so
                                     that the overlay (which is on top while it is open) eats
                                     the whole click. -->
                                <Border Style="{StaticResource CardStyle}" Width="112" Margin="5" Padding="9"
                                        Cursor="Hand" Tag="{Binding IndividualId}"
                                        MouseLeftButtonDown="PokedexCard_Click"
                                        ToolTip="Открыть карточку — характер, дата поимки и действия">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Border Style="{StaticResource PillStyle}" Padding="6,1"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding DexNumber}" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                            </Border>
                                            <!-- Per-individual markers. Without them two cards of
                                                 the same species would be indistinguishable now
                                                 that the grid no longer dedupes. -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,3,0"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding FavoriteBadgeVisibility}"
                                                      Fill="{StaticResource AccentGoldBrush}"
                                                      ToolTip="Избранный — всегда в начале списка"
                                                      Data="M12,2 L15.09,8.26 L22,9.27 L17,14.14 L18.18,21.02 L12,17.77 L5.82,21.02 L7,14.14 L2,9.27 L8.91,8.26 Z" />
                                                <TextBlock Text="✨" FontSize="10" VerticalAlignment="Center"
                                                           Visibility="{Binding ShinyVisibility}"
                                                           ToolTip="Шайни — редкая цветовая форма" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Style="{StaticResource WellStyle}" Height="80" Margin="0,0,0,7">
                                            <Grid>
                                                <!-- ~21% larger than the 56px it was. The Loaded/
                                                     Unloaded pair is what drives the animation:
                                                     the code-behind attaches a SpriteAnimator per
                                                     realized Image, which is how a DataTemplate
                                                     gets the same treatment the named hero Image
                                                     already had. -->
                                                <Image Width="68" Height="68" Source="{Binding SpriteImage}"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       Loaded="PokedexSprite_Loaded" Unloaded="PokedexSprite_Unloaded" />
                                                <Grid Width="30" Height="30" Opacity="0.45"
                                                      Visibility="{Binding PlaceholderVisibility}">
                                                    <Ellipse Stroke="{StaticResource MutedTextBrush}" StrokeThickness="2" />
                                                    <Border Height="2" Background="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                                    <Ellipse Width="10" Height="10" Fill="{StaticResource WindowBackgroundBrush}"
                                                             Stroke="{StaticResource MutedTextBrush}" StrokeThickness="2"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <Border Style="{StaticResource PillStyle}" Padding="5,1"
                                                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                        Margin="0,0,0,2"
                                                        BorderBrush="{StaticResource AccentGoldBrush}"
                                                        Visibility="{Binding ActiveBadgeVisibility}"
                                                        ToolTip="Сейчас на рабочем столе">
                                                    <TextBlock Text="На столе" FontSize="8.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentGoldBrush}" />
                                                </Border>
                                                <Border Style="{StaticResource PillStyle}" Padding="5,1"
                                                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                        Margin="0,0,0,2"
                                                        BorderBrush="{StaticResource AccentRedBrush}"
                                                        Visibility="{Binding UnavailableBadgeVisibility}"
                                                        ToolTip="{Binding AvailabilityToolTip}">
                                                    <TextBlock Text="Обиделся" FontSize="8.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentRedBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Nickname as the headline, species name as the line
                                             under it — BOTH always on the card. With no
                                             nickname DisplayName IS the species name and the
                                             subtitle collapses, so an un-nicknamed card looks
                                             exactly as it did before. -->
                                        <StackPanel Margin="0,0,0,7">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12"
                                                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding SpeciesSubtitle}" Style="{StaticResource CaptionTextStyle}"
                                                       Visibility="{Binding SpeciesSubtitleVisibility}"
                                                       TextAlignment="Center" HorizontalAlignment="Center"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Center"
                                                BorderBrush="{Binding RarityBrush}" Padding="7,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{Binding RarityBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding RarityName}" FontSize="9.5"
                                                           Foreground="{Binding RarityBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Types, under the rarity tag. Centred and wrapping:
                                             a two-type species stacks its second badge on a
                                             second row rather than clipping it at the 112px
                                             card edge. Collapses when the catalog in use has
                                             no type data, so the card doesn't grow a gap. -->
                                        <ItemsControl Margin="0,5,0,0" HorizontalAlignment="Center"
                                                      Visibility="{Binding TypeBadgesVisibility}"
                                                      ItemsSource="{Binding TypeBadges}"
                                                      ItemsPanel="{StaticResource TypeBadgePanelTemplate}"
                                                      ItemTemplate="{StaticResource TypeBadgeTemplate}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Pagination. Collapsed outright while everything fits on one page — a
                         permanently-disabled Назад/Вперёд pair under a 3-card grid would read
                         as broken chrome. The page survives the once-a-second refresh tick and
                         resets only when the rarity filter or the search query changes. -->
                    <StackPanel x:Name="PokedexPagination" Orientation="Horizontal" Visibility="Collapsed"
                                HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="PokedexPrevPageButton" Content="Назад" Padding="12,5"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="PokedexPrevPage_Click" />
                        <TextBlock x:Name="PokedexPageText" Style="{StaticResource MetaTextStyle}"
                                   VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold" />
                        <Button x:Name="PokedexNextPageButton" Content="Вперёд" Padding="12,5"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="PokedexNextPage_Click" />
                    </StackPanel>

                    <!-- Incubating eggs -->
                    <TextBlock Text="Яйца в инкубации" Style="{StaticResource SectionHeaderTextStyle}" Margin="2,14,0,6" />
                    <TextBlock x:Name="EggsEmptyText" Style="{StaticResource CaptionTextStyle}" Margin="2,0,0,12"
                               Text="Пока пусто — яйца покупаются в Магазине и вылупляются через час." />
                    <ItemsControl x:Name="PendingEggsList" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource WellStyle}" Width="46" Height="46"
                                                Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Path Width="24" Height="30" Stretch="Uniform" VerticalAlignment="Center"
                                                  HorizontalAlignment="Center" Fill="{Binding TierBrush}"
                                                  Data="M20,4 C28,4 34,16 34,25 C34,33 28,39 20,39 C12,39 6,33 6,25 C6,16 12,4 20,4 Z" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Яйцо: " FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TierName}" FontWeight="SemiBold"
                                                           Foreground="{Binding TierBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MetaTextStyle}"
                                                       Margin="0,1,0,6" />
                                            <ProgressBar Style="{StaticResource GoldProgressBarStyle}" Height="8"
                                                         Value="{Binding HatchFraction, Mode=OneWay}" Minimum="0" Maximum="1" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Вылупить!" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Tag="{Binding EggId}" Click="HatchButton_Click" IsEnabled="{Binding IsReady}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>

        <!-- ===================== POKÉDEX DETAIL OVERLAY =====================
             The dimmed backdrop is what closes the card: MouseLeftButtonDown on it hides the
             layer, and the card itself marks the event Handled so a click INSIDE the card
             never bubbles up here. ZIndex keeps it over the TabControl regardless of
             declaration order.

             Content is PokemonDetailWindow's, moved verbatim: sprite + dex number + rarity,
             the catch date and nature the old roster rows carried, and the three actions that
             used to sit inline on every card — Выбрать, Отпустить and the favourite star.
             Names are Detail*-prefixed because several of them (SpriteImage, ShinyBadge)
             collide with the home tab's own elements now that both live in one namescope. -->
        <Border x:Name="DetailOverlay" Panel.ZIndex="10" Visibility="Collapsed"
                Background="#B2000000" MouseLeftButtonDown="DetailOverlay_MouseLeftButtonDown">
            <!-- This Grid exists purely to be a MEASURING STICK for the card's MaxHeight below.
                 It stretches, so its ActualHeight is always the overlay's height minus the 18px
                 margin at each end — the tallest the card may grow while still leaving a strip
                 of dimmed backdrop visible above and below it (which is what reads as "this is
                 a popup" rather than "the screen changed"). Binding the card straight to the
                 overlay's own ActualHeight instead would leave no room for that margin: the
                 card would be capped at the FULL overlay height and then pushed 18px past both
                 edges by its own margin, clipping the very buttons this is here to protect. -->
            <Grid x:Name="DetailOverlayArea" Margin="0,18">
            <Border x:Name="DetailCard" Style="{StaticResource CardStyle}" Padding="18,16" Width="360"
                    MaxHeight="{Binding ActualHeight, ElementName=DetailOverlayArea}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="DetailCard_MouseLeftButtonDown">
                <!-- The card's content is as tall as the individual makes it: a shiny, pinned,
                     currently-active two-type Pokémon mid-way through a 3-stage line carries
                     four badge pills, two type badges AND the whole evolution strip, which
                     measured taller than the app window. With no scroller and no height cap the
                     StackPanel simply grew, the card was arranged centred at that full height,
                     and Выбрать/Отпустить rendered BELOW the bottom edge of the window with no
                     way to reach them short of resizing the whole app. MaxHeight above bounds
                     the card; the ScrollViewer below is what makes the overflow reachable.

                     The action row is docked to the BOTTOM of this DockPanel instead of living
                     inside the ScrollViewer's own content — added first, ahead of the
                     ScrollViewer, so LastChildFill gives the scroller the rest. That keeps
                     Отпустить's on-screen position immune to anything that reflows the
                     scrollable content above it (evolution-chain length, badge count, the
                     MaxHeight binding above settling across a layout pass or two — all of
                     which visibly shook the row when it sat inside the same StackPanel), and
                     as a bonus the buttons are reachable without scrolling in the common case. -->
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- The star pin, moved here off the roster rows. One Path with both Fill
                             and Stroke bound covers both states: gold-on-gold when pinned, hollow
                             with a muted outline when not. -->
                        <Button x:Name="DetailFavoriteButton" Grid.Column="0" Style="{StaticResource FavoriteToggleStyle}"
                                Click="DetailFavoriteButton_Click" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Path x:Name="DetailFavoriteStar" Width="17" Height="17" Stretch="Uniform"
                                  StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M12,2 L15.09,8.26 L22,9.27 L17,14.14 L18.18,21.02 L12,17.77 L5.82,21.02 L7,14.14 L2,9.27 L8.91,8.26 Z" />
                        </Button>

                        <Button x:Name="DetailSelectButton" Grid.Column="1" Content="Выбрать" Click="DetailSelectButton_Click"
                                Padding="12,7" Margin="0,0,8,0"
                                ToolTip="Сделать этого покемона активным — он появится на рабочем столе" />

                        <Button x:Name="DetailReleaseButton" Grid.Column="2" Content="Отпустить" Click="DetailReleaseButton_Click"
                                Padding="12,7" Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Насовсем удалить этого покемона из коллекции" />
                    </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <Grid Height="120" Margin="0,0,0,10">
                        <Ellipse Width="170" Height="112" Fill="{StaticResource SpotlightBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="DetailSpriteImage" Width="104" Height="104"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Grid x:Name="DetailSpritePlaceholder" Width="64" Height="64"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5">
                            <Ellipse Stroke="{StaticResource MutedTextBrush}" StrokeThickness="3" />
                            <Border Height="3" Background="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <Ellipse Width="20" Height="20" Fill="{StaticResource WindowBackgroundBrush}"
                                     Stroke="{StaticResource MutedTextBrush}" StrokeThickness="3"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <Border x:Name="DetailShinyBadge" Style="{StaticResource PillStyle}" Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                BorderBrush="{StaticResource AccentGoldBrush}"
                                ToolTip="Шайни — редкая цветовая форма">
                            <TextBlock Text="✨ Shiny" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentGoldBrush}" />
                        </Border>
                    </Grid>

                    <!-- Headline = the nickname when there is one. The species line right below
                         is what keeps the dex identity visible in that case; it collapses when
                         the headline already IS the species name. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                        <TextBlock x:Name="DetailDexNumberText" Style="{StaticResource MetaTextStyle}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock x:Name="DetailSpeciesNameText" Style="{StaticResource ScreenTitleTextStyle}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="DetailSpeciesSubtitleText" Style="{StaticResource MetaTextStyle}"
                               HorizontalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"
                               Margin="0,0,0,4" />

                    <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Border x:Name="DetailRarityPill" Style="{StaticResource PillStyle}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="DetailRarityDot" Width="6" Height="6"
                                         VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock x:Name="DetailRarityText" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="DetailFavoriteBadge" Style="{StaticResource PillStyle}" Margin="0,0,6,0"
                                BorderBrush="{StaticResource AccentGoldBrush}" Visibility="Collapsed"
                                ToolTip="Избранный — всегда в начале списка">
                            <TextBlock Text="Избранное" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentGoldBrush}" />
                        </Border>
                        <Border x:Name="DetailActiveBadge" Style="{StaticResource PillStyle}" Margin="0,0,6,0"
                                BorderBrush="{StaticResource AccentGoldBrush}" Visibility="Collapsed"
                                ToolTip="Сейчас на рабочем столе">
                            <TextBlock Text="На столе" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentGoldBrush}" />
                        </Border>
                        <Border x:Name="DetailUnavailableBadge" Style="{StaticResource PillStyle}"
                                BorderBrush="{StaticResource AccentRedBrush}" Visibility="Collapsed">
                            <TextBlock Text="Обиделся" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentRedBrush}" />
                        </Border>
                    </WrapPanel>

                    <!-- Types on their own row rather than mixed into the badge row above: those
                         badges are per-INDIVIDUAL state (shiny, pinned, on the desktop), these
                         are per-SPECIES facts, and interleaving them made both harder to scan. -->
                    <ItemsControl x:Name="DetailTypeBadges" HorizontalAlignment="Center" Margin="0,0,0,10"
                                  ItemsPanel="{StaticResource TypeBadgePanelTemplate}"
                                  ItemTemplate="{StaticResource TypeBadgeTemplate}" />

                    <!-- Nickname editor. Commits on every keystroke rather than behind a
                         Save/Cancel pair: the headline above and the grid card behind both
                         update live, which is its own confirmation, and there is nothing
                         destructive to undo. Clearing the box clears the nickname (the
                         sanitizing setter on PokemonIndividual turns "" and "   " into null),
                         which is why no separate "reset" button is needed either. -->
                    <Border Style="{StaticResource WellStyle}" Padding="13,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Прозвище" Style="{StaticResource MetaTextStyle}" Margin="0,0,0,5" />
                            <TextBox x:Name="DetailNicknameBox" Style="{StaticResource ThemedTextBoxStyle}"
                                     MaxLength="20" TextChanged="DetailNicknameBox_TextChanged"
                                     ToolTip="Придумай своё имя — до 20 символов. Имя вида никуда не денется." />
                            <TextBlock Text="Необязательно. Оставишь пустым — покажем просто имя вида."
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WellStyle}" Padding="13,10" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Характер" Style="{StaticResource MetaTextStyle}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="DetailNatureText" Style="{StaticResource MetaTextStyle}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Пойман" Style="{StaticResource MetaTextStyle}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="DetailCaughtAtText" Style="{StaticResource MetaTextStyle}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <!-- The right-hand TextBlock is new: this row used to be a bare bar
                                 with no readout at all, which made a full bar indistinguishable
                                 between "99% there" and "has no further evolution". It carries
                                 the percentage OR "Не эволюционирует" / "Финальная форма". -->
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <ContentControl Style="{StaticResource EvolutionIconStyle}" Width="12" Height="12"
                                                    Foreground="{StaticResource RarityRareBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="До эволюции" Style="{StaticResource MetaTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="DetailEvolutionText" Style="{StaticResource MetaTextStyle}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar x:Name="DetailEvolutionBar" Style="{StaticResource SlimProgressBarStyle}"
                                         Minimum="0" Maximum="1"
                                         ToolTip="Прогресс до следующей эволюции этого покемона" />
                        </StackPanel>
                    </Border>

                    <!-- ============== EVOLUTION CHAIN PREVIEW (spoiler-safe) ==============
                         The individual's whole line, left to right, joined by arrows. Stages
                         this individual has REACHED show their sprite and name; everything
                         beyond its current stage is a silhouette + "?" — enough to say "there
                         is more to this line" without spoiling what it becomes.

                         The mask is enforced in the MODEL, not here: CollectionViewModel never
                         puts an unreached stage's id or name into the card, so there is nothing
                         for this template to accidentally bind. The silhouette itself is the
                         same outline-pokéball the grid cards use for "sprite not cached yet".

                         Collapsed entirely for a single-stage species — see ShowDetail. -->
                    <Border x:Name="DetailEvolutionChainSection" Style="{StaticResource WellStyle}"
                            Padding="10,10" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Цепочка эволюции" Style="{StaticResource MetaTextStyle}"
                                       Margin="0,0,0,8" />
                            <ItemsControl x:Name="DetailEvolutionChainStrip" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">

                                            <!-- 84, not the 92 this shipped with. The detail card
                                                 is 360 wide with 18px padding and sits inside a
                                                 well with 10px more, leaving 300 for the strip;
                                                 three 92px stages plus two arrows measured 316,
                                                 so a real 3-stage line (Shinx -> Luxio -> ???)
                                                 had its outer two cards cut off at both edges.
                                                 84 + tighter arrows measures 282. Three is the
                                                 hard maximum — PokeApiClient.CollectStages keeps
                                                 only the longest branch — so this is the widest
                                                 case, not a lucky one. -->
                                            <!-- MouseLeftButtonDown, not Up — same reasoning as
                                                 PokedexCard_Click. Clicking a stage picks it as
                                                 the cosmetic display override (or resets it, if
                                                 it's already the one shown); a masked stage is
                                                 harmless to click since the handler no-ops on an
                                                 unrevealed one (see DetailEvolutionStage_Click). -->
                                            <Border Width="84" Padding="4,6" CornerRadius="10"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{Binding BorderBrush}"
                                                    Opacity="{Binding Opacity}"
                                                    Background="{StaticResource CardBackgroundBrush}"
                                                    ToolTip="{Binding ToolTip}"
                                                    Cursor="Hand"
                                                    MouseLeftButtonDown="DetailEvolutionStage_Click">
                                                <StackPanel>
                                                    <Grid Height="52">
                                                        <Image Width="46" Height="46" Source="{Binding SpriteImage}"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />

                                                        <!-- Same pokéball silhouette the grid
                                                             cards use for an uncached sprite. -->
                                                        <Grid Width="26" Height="26" Opacity="0.45"
                                                              Visibility="{Binding PlaceholderVisibility}">
                                                            <Ellipse Stroke="{StaticResource MutedTextBrush}" StrokeThickness="2" />
                                                            <Border Height="2" Background="{StaticResource MutedTextBrush}"
                                                                    VerticalAlignment="Center" />
                                                            <Ellipse Width="9" Height="9" Fill="{StaticResource WindowBackgroundBrush}"
                                                                     Stroke="{StaticResource MutedTextBrush}" StrokeThickness="2"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>

                                                        <!-- The "?" marks a MYSTERY specifically,
                                                             which an uncached-but-known sprite is
                                                             not — that one keeps its real name
                                                             under the silhouette. -->
                                                        <TextBlock Text="?" FontSize="20" FontWeight="Bold"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding MysteryVisibility}" />
                                                    </Grid>

                                                    <TextBlock Text="{Binding NameText}" FontSize="10" FontWeight="SemiBold"
                                                               TextAlignment="Center" TextWrapping="Wrap"
                                                               Margin="0,3,0,0" />

                                                    <!-- "You are here". -->
                                                    <Border Style="{StaticResource PillStyle}" Padding="5,1" CornerRadius="5"
                                                            HorizontalAlignment="Center" Margin="0,4,0,0"
                                                            BorderBrush="{StaticResource AccentGoldBrush}"
                                                            Visibility="{Binding CurrentBadgeVisibility}"
                                                            ToolTip="Текущая форма этого покемона">
                                                        <TextBlock Text="Сейчас" FontSize="8.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AccentGoldBrush}" />
                                                    </Border>

                                                    <!-- Only shown when it differs from "Сейчас"
                                                         (see DisplayedBadgeVisibility) — this is
                                                         the stage cosmetically shown on the
                                                         sprite/card instead of the real one. -->
                                                    <Border Style="{StaticResource PillStyle}" Padding="5,1" CornerRadius="5"
                                                            HorizontalAlignment="Center" Margin="0,4,0,0"
                                                            BorderBrush="{StaticResource RarityRareBrush}"
                                                            Visibility="{Binding DisplayedBadgeVisibility}"
                                                            ToolTip="Отображается вместо текущей формы">
                                                        <TextBlock Text="Показано" FontSize="8.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource RarityRareBrush}" />
                                                    </Border>

                                                    <ItemsControl Margin="0,4,0,0" HorizontalAlignment="Center"
                                                                  Visibility="{Binding TypeBadgesVisibility}"
                                                                  ItemsSource="{Binding TypeBadges}"
                                                                  ItemsPanel="{StaticResource TypeBadgePanelTemplate}"
                                                                  ItemTemplate="{StaticResource TypeBadgeTemplate}" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="→" FontSize="13" Margin="2,0,2,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding ArrowVisibility}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
                </ScrollViewer>
                </DockPanel>
            </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
