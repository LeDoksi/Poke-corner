<UserControl x:Class="PokeCorner.App.Popup.CatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PokeCorner.App.Popup">
    <Grid Margin="24,14,24,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <!-- The free page under the scene is the diary margin (D-43): sketches and a note or two, more as the window grows. -->
        <local:DiaryMargin x:Name="CatchMargin" Grid.Row="2" Margin="0,14,0,0"/>
        <!-- The page to the right of the heading is margin as well (Georgy 13.11). -->
        <local:DiaryMargin x:Name="HeadMargin" Margin="600,0,0,10"/>
        <StackPanel Margin="0,0,0,16" MaxWidth="580" HorizontalAlignment="Left">
            <!-- Catch is a page inside «Уголок»; the rail tab is already selected, so the way back must be on the page. -->
            <Button x:Name="BackToCornerButton" Content="← В уголок" Click="BackToCornerButton_Click" HorizontalAlignment="Left" Margin="-10,-6,0,4"
                    Style="{StaticResource NdLinkButtonStyle}"/>
            <TextBlock x:Name="EncounterTitleText" FontFamily="{StaticResource NdDisplayFont}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource NdLavenderBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="SubtitleText" Foreground="{StaticResource UiSecondaryInkBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <!-- The scene sits right under the heading: centring it left an empty band between them. -->
        <Grid Grid.Row="1" VerticalAlignment="Top">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="VisualPanel" Margin="0,0,20,0">
                <!-- The scene never gets wider than its picture at 250 px high: wider, UniformToFill would crop the floor
                     off the bottom and the ball and the Pokémon would hang in the air (Georgy 04.11, a 150% laptop). -->
                <!-- Night Diary 2.0: the scene is a lit card, like the corner. -->
                <Border x:Name="SceneFrame" CornerRadius="18" Background="{StaticResource NdPanelBrush}" BorderBrush="{StaticResource NdPanelLineBrush}" BorderThickness="1" Effect="{StaticResource NdLiftShadow}" MaxWidth="750">
                    <Grid x:Name="CaptureScene" Height="250" ClipToBounds="True" SizeChanged="CaptureScene_SizeChanged">
                        <Image x:Name="SceneImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                        <Image x:Name="RevealSpriteImage" Width="144" Height="144" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,-32,0,0" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform><TransformGroup>
                                <ScaleTransform x:Name="PetScale"/>
                                <TranslateTransform x:Name="PetHop"/>
                            </TransformGroup></Image.RenderTransform>
                        </Image>
                        <!-- The 40 px pixel ball at ×2: smaller than the Pokémon. Squash and wobble pivot on its contact point (y 77), the spin on its centre (39,52). -->
                        <Grid x:Name="PokeBallCanvas" Width="80" Height="80">
                            <Grid.RenderTransform><TransformGroup>
                                <ScaleTransform x:Name="BallSquash" CenterX="39" CenterY="77"/>
                                <RotateTransform x:Name="PokeBallSpin" CenterX="39" CenterY="52"/>
                                <RotateTransform x:Name="PokeBallRotate" CenterX="39" CenterY="77"/>
                                <TranslateTransform x:Name="PokeBallThrow"/>
                            </TransformGroup></Grid.RenderTransform>
                            <Image x:Name="CatchBallImage" Source="{StaticResource UiBallClosedImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Grid>
                        <Canvas x:Name="SparkLayer" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" TextAlignment="Center" Margin="6,12,6,0"
                           Foreground="{StaticResource UiSecondaryInkBrush}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="CatchNote" Style="{StaticResource NdMarginNoteStyle}" FontSize="24" Margin="6,8,6,0" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform Angle="-1.5"/></TextBlock.RenderTransform></TextBlock>
            </StackPanel>
            <Border x:Name="DetailPanel" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource NdPanelStyle}" Padding="18,16,18,18">
            <StackPanel>
                <TextBlock x:Name="SceneHeadingText" Text="Твой ещё один друг" FontFamily="{StaticResource NdDisplayFont}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="RevealNameText" FontFamily="{StaticResource NdDisplayFont}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock x:Name="RevealRarityText" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" Foreground="{StaticResource UiSecondaryInkBrush}"/>
                <TextBlock x:Name="ResultDetailText" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,12,0,0"/>
                <StackPanel x:Name="CharmPanel" Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal"><Image x:Name="CharmImage" Width="40" Height="40" Margin="0,0,8,0"/><TextBlock Text="Талисман удачи" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
                    <TextBlock x:Name="CatchCharmText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                    <Button x:Name="CharmButton" Content="Активировать" Click="CharmButton_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel x:Name="ProgressPanel" Margin="0,16,0,0">
                    <TextBlock Text="До следующего покебола за активность" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <ProgressBar x:Name="CatchProgressBar" Style="{StaticResource CatchProgressBarStyle}" Minimum="0" Maximum="1"/>
                </StackPanel>
                <Button x:Name="CatchButton" Content="Бросить покебол" Click="CatchButton_Click" Style="{StaticResource UiPrimaryButtonStyle}" Margin="0,20,0,0"/>
            </StackPanel>
            </Border>
            <Button x:Name="SkipButton" Grid.Row="1" Grid.ColumnSpan="2" Content="Сразу к результату" Click="SkipButton_Click"
                    Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        </Grid>
    </Grid>
</UserControl>
