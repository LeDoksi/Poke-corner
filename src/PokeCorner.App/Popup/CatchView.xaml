<UserControl x:Class="PokeCorner.App.Popup.CatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="EncounterTitleText" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource UiInkBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="SubtitleText" Foreground="{StaticResource UiSecondaryInkBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="VisualPanel" Margin="0,0,20,0">
                <Border CornerRadius="12" Background="{StaticResource SurfaceBackgroundBrush}" ClipToBounds="True">
                    <Grid x:Name="CaptureScene" Height="250">
                        <Image x:Name="SceneImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                        <Image x:Name="RevealSpriteImage" Width="144" Height="144" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,-32,0,0" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform><ScaleTransform x:Name="PetScale"/></Image.RenderTransform>
                        </Image>
                        <Grid x:Name="PokeBallCanvas" Width="144" Height="144" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><TransformGroup>
                                <RotateTransform x:Name="PokeBallRotate"/>
                                <TranslateTransform x:Name="PokeBallThrow"/>
                            </TransformGroup></Grid.RenderTransform>
                            <Image x:Name="CatchBallImage" Source="{StaticResource UiBallClosedImage}" Stretch="Uniform"/>
                        </Grid>
                    </Grid>
                </Border>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" TextAlignment="Center" Margin="6,12,6,0"
                           Foreground="{StaticResource UiSecondaryInkBrush}" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <StackPanel x:Name="DetailPanel" Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="SceneHeadingText" Text="Твой ещё один друг" FontSize="21" FontWeight="ExtraBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="RevealNameText" FontSize="25" FontWeight="ExtraBold" TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock x:Name="RevealRarityText" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" Foreground="{StaticResource UiSecondaryInkBrush}"/>
                <TextBlock x:Name="ResultDetailText" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,12,0,0"/>
                <StackPanel x:Name="CharmPanel" Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal"><Image x:Name="CharmImage" Width="40" Height="40" Margin="0,0,8,0"/><TextBlock Text="Талисман удачи" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
                    <TextBlock x:Name="CatchCharmText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                    <Button x:Name="CharmButton" Content="Активировать" Click="CharmButton_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel x:Name="ProgressPanel" Margin="0,16,0,0">
                    <TextBlock Text="До следующего покебола за активность" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <ProgressBar x:Name="CatchProgressBar" Style="{StaticResource CatchProgressBarStyle}" Minimum="0" Maximum="1"/>
                </StackPanel>
                <Button x:Name="CatchButton" Content="Бросить покебол" Click="CatchButton_Click" Style="{StaticResource UiPrimaryButtonStyle}" Margin="0,20,0,0"/>
            </StackPanel>
            <Button x:Name="SkipButton" Grid.Row="1" Grid.ColumnSpan="2" Content="Сразу к результату" Click="SkipButton_Click"
                    Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        </Grid>
    </Grid>
</UserControl>
