<UserControl x:Class="PokeCorner.App.Popup.ExpeditionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PokeCorner.App.Popup" FontSize="14">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PokeCorner;component/Theme/NightDiary.xaml"/></ResourceDictionary.MergedDictionaries>
   <BitmapImage x:Key="NdMapImage" UriSource="/PokeCorner;component/Assets/NightDiary/sketch-exp-map.png"/>
   <BitmapImage x:Key="NdBackpackImage" UriSource="/PokeCorner;component/Assets/NightDiary/backpack.png"/>
   <SolidColorBrush x:Key="CardBorderBrush" Color="#35304F"/>
   <SolidColorBrush x:Key="CardBackgroundBrush" Color="#16192B"/>
   <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#24223B"/>
   <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#101426"/>
   <SolidColorBrush x:Key="UiForestBrush" Color="#C4ABF0"/>
   <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource NdTextBrush}"/><Setter Property="FontSize" Value="14"/></Style>
   <Style x:Key="ScreenTitleTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource NdLavenderBrush}"/><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="Bold"/></Style>
   <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource NdLavenderBrush}"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
   <Style x:Key="CaptionTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource NdMutedBrush}"/><Setter Property="FontSize" Value="12"/></Style>
   <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource NdSurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource NdBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/></Style>
   <!-- Buttons (D-38): the app's key cap for actions, a flat body for links, tiles and outlines. -->
   <Style x:Key="SecondaryButtonStyle" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource NdTextBrush}"/><Setter Property="Background" Value="{StaticResource NdRaisedFaceBrush}"/>
    <Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="38"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template" Value="{StaticResource NdKeycapTemplate}"/>
   </Style>
   <Style x:Key="UiPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
    <Setter Property="Background" Value="{StaticResource NdApricotFaceBrush}"/><Setter Property="Foreground" Value="{StaticResource NdOnApricotBrush}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="MinHeight" Value="48"/>
   </Style>
   <Style TargetType="Button" BasedOn="{StaticResource UiPrimaryButtonStyle}"/>
   <Style x:Key="NdFlatButtonStyle" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource NdTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="30"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Grid>
      <Border x:Name="Surface" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
      <Border x:Name="Light" CornerRadius="11" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
      <Border x:Name="FocusRing" CornerRadius="11" BorderThickness="2" BorderBrush="{StaticResource NdTextBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Light" Property="Opacity" Value="0.07"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Light" Property="Opacity" Value="0.14"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="NdLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource NdFlatButtonStyle}"><Setter Property="Foreground" Value="{StaticResource NdLavenderBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
   <Style x:Key="NdTileButtonStyle" TargetType="Button" BasedOn="{StaticResource NdFlatButtonStyle}"><Setter Property="Background" Value="#1A1D36"/><Setter Property="BorderBrush" Value="{StaticResource NdBorderBrush}"/></Style>
   <Style x:Key="NdDangerOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource NdFlatButtonStyle}"><Setter Property="BorderBrush" Value="{StaticResource NdDangerLineBrush}"/><Setter Property="Foreground" Value="{StaticResource NdDangerTextBrush}"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="16,6"/></Style>
   <Style x:Key="NdGlyphStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="Foreground" Value="{StaticResource NdMutedBrush}"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,7,0"/></Style>
   <Style x:Key="NdPlanLabelStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource NdMutedBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="2,0,0,5"/></Style>
   <!-- One choice out of a few: a single track, the chosen segment raised in lavender. -->
   <Style x:Key="UiChoiceListStyle" TargetType="ListBox">
    <Setter Property="FontSize" Value="13"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border CornerRadius="12" Background="#14172B" BorderBrush="{StaticResource NdBorderBrush}" BorderThickness="1" Padding="3"><ItemsPresenter/></Border></ControlTemplate></Setter.Value></Setter>
    <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
     <Setter Property="Foreground" Value="{StaticResource NdTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="2,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Choice" CornerRadius="9" BorderThickness="1" BorderBrush="Transparent" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#262A4A"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource NdLavenderFaceBrush}"/><Setter Property="Foreground" Value="{StaticResource NdOnApricotBrush}"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{StaticResource NdTextBrush}"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value></Setter>
    </Style></Setter.Value></Setter>
   </Style>
   <!-- Filter chip: a check box that looks like a pill. -->
   <Style x:Key="NdChipCheckStyle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource NdTextBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
     <Border x:Name="Pill" CornerRadius="15" MinHeight="30" Padding="13,5" Background="{StaticResource NdRaisedFaceBrush}" BorderBrush="{StaticResource NdBorderBrush}" BorderThickness="1"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource NdLavenderBrush}"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Pill" Property="Background" Value="{StaticResource NdLavenderFaceBrush}"/><Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource NdLavenderBrush}"/><Setter Property="Foreground" Value="{StaticResource NdOnApricotBrush}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource NdTextBrush}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{StaticResource NdLavenderFaceBrush}"/><Setter Property="Background" Value="#14172B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid><Border x:Name="PART_Track" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{StaticResource NdBorderBrush}" BorderThickness="1"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="5" Background="{TemplateBinding Foreground}"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
   <Style TargetType="ScrollBar" BasedOn="{StaticResource NdScrollBarStyle}"/>
   <Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource NdSurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource NdTextBrush}"/><Setter Property="CaretBrush" Value="{StaticResource NdApricotBrush}"/><Setter Property="BorderBrush" Value="{StaticResource NdBorderBrush}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><Grid><ScrollViewer x:Name="PART_ContentHost"/><TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource NdMutedBrush}" Visibility="Collapsed" IsHitTestVisible="False"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource NdApricotBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource NdTextBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Foreground and Padding are template-bound onto the ToggleButton on purpose: the stock
                             ButtonBase style sets Foreground to SystemColors.ControlText (black), and that setter
                             outranks the inherited value, so the closed box showed its selection in near-black on
                             the card. -->
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Foreground="{TemplateBinding Foreground}"
                                      Padding="{TemplateBinding Padding}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ClosedBox" Background="{StaticResource NdSurfaceBrush}"
                                            BorderBrush="{StaticResource NdBorderBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                               VerticalAlignment="Center" />
                                            <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="{StaticResource NdMutedBrush}"
                                                  Margin="8,0,2,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ClosedBox" Property="Background" Value="{StaticResource NdRaisedBrush}" />
                                            <Setter TargetName="ClosedBox" Property="BorderBrush" Value="{StaticResource NdMutedBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <Border Background="{StaticResource NdSurfaceBrush}" BorderBrush="{StaticResource NdBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="0,3" Margin="0,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="4" Opacity="0.5" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
   <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource NdTextBrush}"/><Setter Property="Background" Value="{StaticResource NdSurfaceBrush}"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="10,5"/></Style>
   <Style TargetType="CheckBox" BasedOn="{StaticResource NdCheckBoxStyle}"/> 
  </ResourceDictionary>
 </UserControl.Resources>
 <!-- D-38: the scene is the page, the plan sits beside it and never scrolls away; the team is picked in place of the scene. -->
 <Grid Margin="24,14,24,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10">
   <Image x:Name="HeaderSketch" DockPanel.Dock="Right" Source="/PokeCorner;component/Assets/NightDiary/sketch-exp-map.png" Opacity="0.8" RenderOptions.BitmapScalingMode="HighQuality" Width="88" Height="42" Margin="12,0,0,0" IsHitTestVisible="False" Focusable="False"/>
   <TextBlock Text="Экспедиции" Style="{StaticResource ScreenTitleTextStyle}" FontFamily="{StaticResource NdDisplayFont}" FontSize="26" VerticalAlignment="Center"/>
   <StackPanel VerticalAlignment="Center" Margin="16,4,0,0">
    <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionTextStyle}" FontSize="13" TextWrapping="Wrap"/>
    <TextBlock x:Name="ContributionsText" Style="{StaticResource CaptionTextStyle}" FontSize="13" TextWrapping="Wrap"/>
   </StackPanel>
  </DockPanel>
  <StackPanel Grid.Row="1">
   <Border x:Name="MessagePanel" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,10">
    <DockPanel><TextBlock x:Name="MessageGlyph" Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource NdDangerTextBrush}" Margin="0,1,10,0" VerticalAlignment="Top" Visibility="Collapsed"/><StackPanel><TextBlock x:Name="MessageText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="MessageDetailText" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0" Visibility="Collapsed"/></StackPanel></DockPanel>
   </Border>
   <Border x:Name="EncounterPanel" Visibility="Collapsed" Style="{StaticResource NdPanelStyle}" Padding="14,10" Margin="0,0,0,10"><DockPanel>
    <Button x:Name="OpenEncounterButton" Content="Открыть встречу" Click="OpenEncounterButton_Click" DockPanel.Dock="Right" Visibility="Collapsed" MinHeight="40" Padding="18,6"/>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="В пути команда кого-то встретила" FontWeight="Bold"/><TextBlock Text="Кто это, узнаете во встрече" Style="{StaticResource CaptionTextStyle}"/></StackPanel>
   </DockPanel></Border>
  </StackPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PlanColumn" Width="340"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <!-- The scene -->
   <Border x:Name="Landscape" Margin="0,0,14,0" CornerRadius="14" BorderBrush="{StaticResource NdPanelLineBrush}" BorderThickness="1">
    <Grid x:Name="SceneFrame" MinHeight="96">
     <Rectangle Fill="#14172B"/>
     <Image x:Name="LandscapeImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Пейзаж выбранного маршрута"/>
     <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#330C0F1F" Offset="0"/><GradientStop Color="#000C0F1F" Offset="0.35"/><GradientStop Color="#000C0F1F" Offset="0.55"/><GradientStop Color="#E60C0F1F" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
     <!-- A note from the margin, taped onto the picture (D-43). -->
     <Grid x:Name="SceneNote" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,22,0" MaxWidth="236" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform><RotateTransform Angle="2"/></Grid.RenderTransform>
      <Border Background="{StaticResource NdPaperBrush}" CornerRadius="3" Padding="14,13,14,10" Effect="{StaticResource NdLiftShadow}">
       <StackPanel><TextBlock Text="НА ПОЛЯХ" FontSize="10" FontWeight="Bold" Foreground="#8A7A66" Margin="0,0,0,3"/><TextBlock x:Name="TrainerNote" Style="{StaticResource NdPaperNoteTextStyle}" TextAlignment="Left"/></StackPanel>
      </Border>
      <Border Width="58" Height="15" Background="#B8C4ABF0" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-7,0,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="-4"/></Border.RenderTransform></Border>
     </Grid>
     <StackPanel VerticalAlignment="Bottom" Margin="22,0,22,18">
      <TextBlock x:Name="LandscapeName" Foreground="{StaticResource NdTextBrush}" FontFamily="{StaticResource NdDisplayFont}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
      <WrapPanel x:Name="RouteChips" Margin="0,8,0,0"/>
      <TextBlock x:Name="RouteHintText" Visibility="Collapsed"/>
     </StackPanel>
    </Grid>
   </Border>
   <!-- Routes as postcards -->
   <StackPanel x:Name="RouteSelectionPanel" Grid.Row="1" Margin="0,10,14,0"><UniformGrid x:Name="RouteButtons" x:FieldModifier="public" Rows="1" Margin="0,0,-6,0"/></StackPanel>
   <!-- Team picker, in place of the scene: the plan stays in view and follows every click. -->
   <Border x:Name="PickerPanel" Grid.RowSpan="2" Visibility="Collapsed" Margin="0,0,14,0" Style="{StaticResource NdPanelStyle}" KeyboardNavigation.TabNavigation="Cycle">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,8">
      <TextBlock Text="Кто пойдёт?" FontFamily="{StaticResource NdDisplayFont}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,12,0"/>
      <Button x:Name="PickerAutoButton" DockPanel.Dock="Right" Content="✦ Подобрать лучших" Click="PickerAuto_Click" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Трое свободных: сначала подходящие маршруту, затем самые опытные" Margin="8,0,0,0"/>
      <TextBox x:Name="PickerSearchBox" Tag="Имя, кличка или номер" MinHeight="34" TextChanged="PickerFilterChanged" AutomationProperties.Name="Имя, кличка или номер" VerticalAlignment="Center"/>
     </DockPanel>
     <WrapPanel Grid.Row="1" Margin="0,0,0,2">
      <CheckBox x:Name="PickerRouteBox" Content="Подходят маршруту" Style="{StaticResource NdChipCheckStyle}" Checked="PickerFilterChanged" Unchecked="PickerFilterChanged" Margin="0,0,6,6"/>
      <CheckBox x:Name="PickerAvailableBox" Content="Свободны" IsChecked="True" Style="{StaticResource NdChipCheckStyle}" Checked="PickerFilterChanged" Unchecked="PickerFilterChanged" Margin="0,0,10,6"/>
      <TextBlock x:Name="PickerCountText" Style="{StaticResource CaptionTextStyle}" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
     </WrapPanel>
     <StackPanel Grid.Row="2" Margin="0,0,0,8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="PickerTypeBox" SelectionChanged="PickerFilterChanged" AutomationProperties.Name="Тип" Margin="0,0,6,0"/>
       <ComboBox x:Name="PickerTraitBox" Grid.Column="1" SelectionChanged="PickerFilterChanged" AutomationProperties.Name="Особенность" Margin="0,0,6,0"/>
       <ComboBox x:Name="PickerSortBox" Grid.Column="2" SelectionChanged="PickerFilterChanged" AutomationProperties.Name="Сортировка команды" Margin="0,0,6,0"><ComboBoxItem Content="Рекомендованные"/><ComboBoxItem Content="Высокий уровень"/><ComboBoxItem Content="Номер"/></ComboBox>
       <Button x:Name="PickerResetButton" Grid.Column="3" Content="Сбросить" ToolTip="Сбросить фильтры" Style="{StaticResource NdLinkButtonStyle}" Click="PickerReset_Click"/>
      </Grid>
      <TextBlock x:Name="PickerRouteHintText" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="2,6,0,0"/>
     </StackPanel>
     <ScrollViewer x:Name="PickerScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock x:Name="PickerEmptyText" Text="Никого не нашли. Измените фильтры." Visibility="Collapsed" Margin="2,12"/>
      <WrapPanel x:Name="PickerMembers" Margin="-4,0,0,0"/>
     </StackPanel></ScrollViewer>
     <Grid Grid.Row="4" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Клик добавляет и убирает. Команда справа меняется сразу." Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="2,0,8,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button x:Name="PickerPreviousButton" Content="‹" ToolTip="Предыдущая страница" AutomationProperties.Name="Предыдущая страница" MinWidth="34" Style="{StaticResource NdTileButtonStyle}" Click="PickerPrevious_Click"/>
       <TextBlock x:Name="PickerPageText" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"/>
       <Button x:Name="PickerNextButton" Content="›" ToolTip="Следующая страница" AutomationProperties.Name="Следующая страница" MinWidth="34" Style="{StaticResource NdTileButtonStyle}" Click="PickerNext_Click"/>
      </StackPanel>
      <Button x:Name="PickerCancelButton" Grid.Column="2" Content="Отмена" ToolTip="Вернуть команду, какой она была" Style="{StaticResource NdLinkButtonStyle}" Click="PickerCancel_Click" Margin="8,0,4,0"/>
      <Button x:Name="PickerDoneButton" Grid.Column="3" Content="Готово" Click="PickerDone_Click" MinWidth="96" MinHeight="42"/>
     </Grid>
    </Grid>
   </Border>
   <!-- The plan -->
   <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource NdPanelStyle}">
    <DockPanel>
     <StackPanel x:Name="PreparationFooter" DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button x:Name="StartButton" Content="Отправить команду" Click="StartButton_Click" MinHeight="54" FontSize="15"/>
      <TextBlock x:Name="PreviewText" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
     <StackPanel x:Name="ActionFooter" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,10,0,0">
      <Button x:Name="ClaimButton" Content="Забрать находки" Click="ClaimButton_Click" Visibility="Collapsed" MinHeight="54" FontSize="15"/>
      <Button x:Name="CancelButton" Content="Прервать поход" Click="CancelButton_Click" Style="{StaticResource NdDangerOutlineButtonStyle}" Visibility="Collapsed" HorizontalAlignment="Center"/>
      <Button x:Name="ContinueButton" Content="Продолжить" Click="Continue_Click" Visibility="Collapsed"/>
     </StackPanel>
     <ScrollViewer x:Name="ScenarioScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="ScenarioContent">
       <StackPanel x:Name="PreparationDetailsPanel">
        <DockPanel Margin="0,0,0,6">
         <Button x:Name="ChooseTeamButton" Content="Изменить" DockPanel.Dock="Right" Click="ChooseTeam_Click" Style="{StaticResource NdLinkButtonStyle}" Padding="6,5" Margin="0,0,-4,0"/>
         <Button x:Name="AutoTeamButton" Content="✦ Подобрать" DockPanel.Dock="Right" Click="AutoTeam_Click" Style="{StaticResource NdLinkButtonStyle}" Padding="6,5" ToolTip="Собрать лучшую свободную тройку для этого маршрута"/>
         <TextBlock x:Name="TeamHeading" Text="Команда 0/3" FontFamily="{StaticResource NdDisplayFont}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,0,0"/>
        </DockPanel>
        <UniformGrid x:Name="TeamSlots" Columns="1" Margin="0,0,0,6"/>
       </StackPanel>
       <StackPanel x:Name="PreparationPanel">
        <StackPanel x:Name="DifficultyGroup" Margin="0,0,0,10"><TextBlock Text="СЛОЖНОСТЬ" Style="{StaticResource NdPlanLabelStyle}"/>
         <ListBox x:Name="DifficultyBox" SelectionChanged="ChoiceChanged" Style="{StaticResource UiChoiceListStyle}" AutomationProperties.Name="Сложность похода"><ListBoxItem Content="Лёгкая" Tag="easy"/><ListBoxItem Content="Обычная" Tag="normal"/><ListBoxItem Content="Сложная" Tag="hard"/></ListBox>
        </StackPanel>
        <StackPanel x:Name="DurationGroup" Margin="0,0,0,10"><TextBlock Text="ДЛИТЕЛЬНОСТЬ" Style="{StaticResource NdPlanLabelStyle}"/>
         <ListBox x:Name="DurationBox" SelectionChanged="ChoiceChanged" Style="{StaticResource UiChoiceListStyle}" AutomationProperties.Name="Длительность похода"><ListBoxItem Content="30 мин" Tag="30"/><ListBoxItem Content="1,5 ч" Tag="90"/><ListBoxItem Content="3 ч" Tag="180"/><ListBoxItem Content="6 ч" Tag="360"/></ListBox>
        </StackPanel>
        <TextBlock x:Name="LootLabel" Text="Гарантированная добыча:" Style="{StaticResource NdPlanLabelStyle}"/>
        <UniformGrid x:Name="PreviewRewardCards" Columns="3" Margin="0,0,-6,0"/>
       </StackPanel>
       <StackPanel x:Name="TripPanel" Visibility="Collapsed">
        <StackPanel x:Name="TripHeader" Orientation="Horizontal"><TextBlock x:Name="TripGlyph" Text="&#xE930;" Style="{StaticResource NdGlyphStyle}" Foreground="{StaticResource NdLavenderBrush}" FontSize="22" Margin="0,0,8,0" Visibility="Collapsed"/><TextBlock x:Name="TripTitle" FontFamily="{StaticResource NdDisplayFont}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
        <TextBlock x:Name="TripTerms" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{StaticResource NdMutedBrush}"/>
        <UniformGrid x:Name="TripSlots" Columns="1" Margin="0,10,0,4"/>
        <TextBlock Visibility="Collapsed" x:Name="TripTeam" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}"/>
        <ProgressBar x:Name="TripProgress" Minimum="0" Maximum="1" Height="10" Margin="0,8,0,0"/>
        <StackPanel x:Name="TripTimeRow" Margin="0,8,0,4"><TextBlock x:Name="TripTime" TextWrapping="Wrap" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="TripReturnText" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/></StackPanel>
        <UniformGrid Visibility="Collapsed" x:Name="TripRewardCards" Columns="3" Margin="0,6,-6,0"/><TextBlock Visibility="Collapsed" x:Name="TripRewards" TextWrapping="Wrap"/>
       </StackPanel>
       <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Margin="0,12,0,0">
        <TextBlock Text="Экспедиция завершена" Style="{StaticResource SectionHeaderTextStyle}"/>
        <TextBlock Text="Обещанная добыча и опыт уже в запасах." Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,10"/>
        <UniformGrid Visibility="Collapsed" x:Name="ResultSlots" Columns="1" Margin="0,0,0,12"/><UniformGrid x:Name="ResultRewardCards" Columns="3" Margin="0,0,-6,12" Visibility="Collapsed"/><TextBlock x:Name="ResultExtrasText" TextWrapping="Wrap" FontSize="15"/><TextBlock x:Name="ResultText" TextWrapping="Wrap" Visibility="Collapsed"/>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <local:ConfirmationOverlay Grid.RowSpan="3" x:Name="LocalConfirmation" Visibility="Collapsed"/>
 </Grid>
</UserControl>
