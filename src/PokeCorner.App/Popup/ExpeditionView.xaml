<UserControl x:Class="PokeCorner.App.Popup.ExpeditionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PokeCorner.App.Popup" FontFamily="Segoe UI" FontSize="14">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/PokeCorner;component/Theme/NightDiary.xaml"/></ResourceDictionary.MergedDictionaries>
   <BitmapImage x:Key="NdMapImage" UriSource="/PokeCorner;component/Assets/NightDiary/map.png"/>
   <BitmapImage x:Key="NdBackpackImage" UriSource="/PokeCorner;component/Assets/NightDiary/backpack.png"/>
   <SolidColorBrush x:Key="CardBorderBrush" Color="#35304F"/>
   <SolidColorBrush x:Key="CardBackgroundBrush" Color="#16192B"/>
   <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#24223B"/>
   <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#101426"/>
   <SolidColorBrush x:Key="UiForestBrush" Color="#C4ABF0"/>
   <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource NdTextBrush}"/><Setter Property="FontSize" Value="14"/></Style>
   <Style x:Key="ScreenTitleTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource NdLavenderBrush}"/><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="Bold"/></Style>
   <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource NdLavenderBrush}"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
   <Style x:Key="CaptionTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource NdMutedBrush}"/><Setter Property="FontSize" Value="12"/></Style>
   <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource NdSurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource NdBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/></Style>
   <Style x:Key="SecondaryButtonStyle" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource NdTextBrush}"/><Setter Property="Background" Value="{StaticResource NdSurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource NdBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="36"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource NdLavenderBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource NdApricotBrush}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="UiPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Background" Value="{StaticResource NdApricotBrush}"/><Setter Property="Foreground" Value="#101426"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="MinHeight" Value="48"/>
    <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{StaticResource NdRaisedBrush}"/><Setter Property="Foreground" Value="{StaticResource NdMutedBrush}"/></Trigger></Style.Triggers></Style>
   <Style TargetType="Button" BasedOn="{StaticResource UiPrimaryButtonStyle}"/>
   <Style x:Key="NdLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource NdLavenderBrush}"/></Style>
   <Style x:Key="NdDangerOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#D9707E"/><Setter Property="Foreground" Value="#FF9AA5"/><Setter Property="Padding" Value="18,8"/></Style>
   <Style x:Key="NdGlyphStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="Foreground" Value="{StaticResource NdMutedBrush}"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,7,0"/></Style>
   <Style x:Key="NdRouteSelectedStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Background" Value="{StaticResource NdLavenderBrush}"/><Setter Property="Foreground" Value="#101426"/><Setter Property="FontWeight" Value="Bold"/></Style>
   <Style x:Key="UiChoiceListStyle" TargetType="ListBox"><Setter Property="FontSize" Value="12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></Setter.Value></Setter><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{StaticResource NdTextBrush}"/><Setter Property="Background" Value="{StaticResource NdSurfaceBrush}"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Padding" Value="2,8"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Choice" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource NdBorderBrush}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource NdLavenderBrush}"/><Setter Property="Foreground" Value="#101426"/><Setter Property="FontWeight" Value="Bold"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{StaticResource NdApricotBrush}"/><Setter TargetName="Choice" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter></Style>
   <Style TargetType="ScrollBar" BasedOn="{StaticResource NdScrollBarStyle}"/>
   <Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource NdSurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource NdTextBrush}"/><Setter Property="CaretBrush" Value="{StaticResource NdApricotBrush}"/><Setter Property="BorderBrush" Value="{StaticResource NdBorderBrush}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><Grid><ScrollViewer x:Name="PART_ContentHost"/><TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource NdMutedBrush}" Visibility="Collapsed" IsHitTestVisible="False"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource NdApricotBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{StaticResource NdLavenderBrush}"/><Setter Property="Background" Value="{StaticResource NdRaisedBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid><Border x:Name="PART_Track" CornerRadius="4" Background="{TemplateBinding Background}"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4" Background="{TemplateBinding Foreground}"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
   <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource NdTextBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Foreground and Padding are template-bound onto the ToggleButton on purpose: the stock
                             ButtonBase style sets Foreground to SystemColors.ControlText (black), and that setter
                             outranks the inherited value, so the closed box showed its selection in near-black on
                             the card. -->
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Foreground="{TemplateBinding Foreground}"
                                      Padding="{TemplateBinding Padding}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ClosedBox" Background="{StaticResource NdSurfaceBrush}"
                                            BorderBrush="{StaticResource NdBorderBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                               VerticalAlignment="Center" />
                                            <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="{StaticResource NdMutedBrush}"
                                                  Margin="8,0,2,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ClosedBox" Property="Background" Value="{StaticResource NdRaisedBrush}" />
                                            <Setter TargetName="ClosedBox" Property="BorderBrush" Value="{StaticResource NdMutedBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <Border Background="{StaticResource NdSurfaceBrush}" BorderBrush="{StaticResource NdBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="0,3" Margin="0,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="4" Opacity="0.5" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
   <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource NdTextBrush}"/><Setter Property="Background" Value="{StaticResource NdSurfaceBrush}"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="10,5"/></Style>
   <Style TargetType="CheckBox" BasedOn="{StaticResource NdCheckBoxStyle}"/> 
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="0,16,0,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="MarginArt" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed">
   <Grid x:Name="MarginArtLeft" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,8"><Viewbox Height="230" HorizontalAlignment="Center"><Canvas Width="90" Height="240"><Path Style="{StaticResource NdSketchStyle}" StrokeDashArray="2 5" Opacity="0.6" Data="M44,0 C30,60 60,110 42,160 S38,215 44,240" /><Path Style="{StaticResource NdSketchStyle}" Data="M36,26 c-3,0 -5,4 -5,9 c0,4 2,6 5,6 c3,0 5,-2 5,-6 c0,-5 -2,-9 -5,-9 z M36,44 m-3.5,0 a3.5,3 0 1 0 7,0 a3.5,3 0 1 0 -7,0 M52,58 c3,0 5,4 5,9 c0,4 -2,6 -5,6 c-3,0 -5,-2 -5,-6 c0,-5 2,-9 5,-9 z M52,76 m-3.5,0 a3.5,3 0 1 0 7,0 a3.5,3 0 1 0 -7,0 M38,96 c-3,0 -5,4 -5,9 c0,4 2,6 5,6 c3,0 5,-2 5,-6 c0,-5 -2,-9 -5,-9 z M38,114 m-3.5,0 a3.5,3 0 1 0 7,0 a3.5,3 0 1 0 -7,0 M54,130 c3,0 5,4 5,9 c0,4 -2,6 -5,6 c-3,0 -5,-2 -5,-6 c0,-5 2,-9 5,-9 z M54,148 m-3.5,0 a3.5,3 0 1 0 7,0 a3.5,3 0 1 0 -7,0 M34,166 c-3,0 -5,4 -5,9 c0,4 2,6 5,6 c3,0 5,-2 5,-6 c0,-5 -2,-9 -5,-9 z M34,184 m-3.5,0 a3.5,3 0 1 0 7,0 a3.5,3 0 1 0 -7,0 M50,200 c3,0 5,4 5,9 c0,4 -2,6 -5,6 c-3,0 -5,-2 -5,-6 c0,-5 2,-9 5,-9 z M50,218 m-3.5,0 a3.5,3 0 1 0 7,0 a3.5,3 0 1 0 -7,0" /></Canvas></Viewbox></Grid>
   <StackPanel x:Name="MarginArtRight" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,16">
    <Viewbox Height="120" HorizontalAlignment="Center">
     <Canvas Width="60" Height="80">
      <Path Style="{StaticResource NdSketchStyle}" Data="M20,10 A10,10 0 0 1 40,10 M15,14 H45 V20 H15 Z M18,20 L16,62 H44 L42,20 M14,62 H46 V70 H14 Z M24,22 V60 M36,22 V60" />
      <Path Style="{StaticResource NdSketchStyle}" Fill="#55FFB574" Stroke="#AAFFB574" Data="M30,50 C25,44 28,38 30,33 C32,38 35,44 30,50 Z" />
     </Canvas>
    </Viewbox>
    <TextBlock Style="{StaticResource NdMarginNoteStyle}" Text="Фонарь — в боковом кармане." MaxWidth="170" Margin="0,8,0,0" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform Angle="2" /></TextBlock.RenderTransform></TextBlock>
   </StackPanel>
  </Grid>
  <ScrollViewer x:Name="ScenarioScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="ScenarioContent" Margin="24,0">
    <DockPanel Margin="0,0,0,10" MaxWidth="968">
     <Image x:Name="HeaderSketch" Source="/PokeCorner;component/Assets/NightDiary/map.png" DockPanel.Dock="Right" Width="110" Height="56" Margin="16,0,0,0" IsHitTestVisible="False" Focusable="False"/>
     <Grid DockPanel.Dock="Right" Height="64" MaxWidth="560" IsHitTestVisible="False"><TextBlock x:Name="TrainerNote" FontFamily="{DynamicResource NdHandFont}" FontSize="26" Foreground="{StaticResource NdLavenderBrush}" Opacity="0.85" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" Padding="0,4,0,0" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform Angle="-2"/></TextBlock.RenderTransform></TextBlock></Grid>
     <StackPanel><TextBlock Text="Экспедиции" Style="{StaticResource ScreenTitleTextStyle}"/><TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
    </DockPanel>
    <Border x:Name="MessagePanel" MaxWidth="968" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,10">
     <DockPanel><TextBlock x:Name="MessageGlyph" Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FF9AA5" Margin="0,1,10,0" VerticalAlignment="Top" Visibility="Collapsed"/><StackPanel><TextBlock x:Name="MessageText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><TextBlock x:Name="MessageDetailText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource NdMutedBrush}" Visibility="Collapsed" /></StackPanel></DockPanel>
    </Border>
<Border x:Name="EncounterPanel" MaxWidth="968" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,8"><DockPanel>
      
      <Button x:Name="OpenEncounterButton" Content="Открыть встречу" Click="OpenEncounterButton_Click" DockPanel.Dock="Right" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}"/>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="В пути команда кого-то встретила" FontWeight="Bold"/><TextBlock Text="Кто это, узнаете во встрече" Style="{StaticResource CaptionTextStyle}"/></StackPanel>
     </DockPanel></Border>
    <StackPanel x:Name="RouteSelectionPanel" MaxWidth="968"><UniformGrid x:Name="RouteButtons" x:FieldModifier="public" Rows="1" Margin="0,0,-6,6" /></StackPanel>
    <Border x:Name="Landscape" ClipToBounds="True" Margin="-24,4,-24,12">
     <Grid x:Name="SceneFrame" Height="236"><Image x:Name="LandscapeImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Пейзаж выбранного маршрута" /><Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0.75,0.9"><GradientStop Color="#D0101426"/><GradientStop Color="#60101426" Offset="0.45"/><GradientStop Color="#00101426" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
      <Grid Margin="24,0" MaxWidth="968"><Border VerticalAlignment="Top" HorizontalAlignment="Left" Padding="0,18,40,18" Margin="0" MaxWidth="760"><StackPanel HorizontalAlignment="Left"><TextBlock x:Name="LandscapeName" Foreground="#F1EAF3" FontFamily="Georgia" FontWeight="Bold" FontSize="32"/><Border Height="1" Background="#B9AECF" Opacity="0.7" Margin="0,6,0,0"/><TextBlock x:Name="RouteHintText" Foreground="#F1EAF3" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></Grid>
     </Grid>
    </Border>
    <StackPanel x:Name="PreparationDetailsPanel"/>
    <StackPanel x:Name="TripPanel" MaxWidth="968" Visibility="Collapsed">
     <Border Padding="0" Margin="0,0,0,12"><StackPanel>
      <StackPanel x:Name="TripHeader" Orientation="Horizontal"><TextBlock x:Name="TripGlyph" Text="&#xE930;" Style="{StaticResource NdGlyphStyle}" Foreground="{StaticResource NdLavenderBrush}" FontSize="24" Margin="0,0,10,0" Visibility="Collapsed"/><TextBlock x:Name="TripTitle" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center"/></StackPanel>
      <TextBlock x:Name="TripTerms" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{StaticResource NdMutedBrush}" />
      <UniformGrid x:Name="TripSlots" Columns="3" Margin="0,12,0,8" />
      <TextBlock Visibility="Collapsed" x:Name="TripTeam" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
      <ProgressBar x:Name="TripProgress" Minimum="0" Maximum="1" Height="8" Margin="0,10,0,0" />
      <DockPanel x:Name="TripTimeRow" Margin="0,8,0,4"><TextBlock x:Name="TripReturnText" DockPanel.Dock="Right" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/><TextBlock x:Name="TripTime" TextWrapping="Wrap" FontSize="15" /></DockPanel>
      <UniformGrid Visibility="Collapsed" x:Name="TripRewardCards" Columns="2" Margin="0,4,0,4"/><TextBlock Visibility="Collapsed" x:Name="TripRewards" TextWrapping="Wrap" />
     </StackPanel></Border>

    </StackPanel>
    <StackPanel x:Name="ResultPanel" MaxWidth="968" Visibility="Collapsed" Margin="0,12,0,0">
     <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12"><StackPanel>
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE930;" Style="{StaticResource NdGlyphStyle}" Foreground="{StaticResource NdLavenderBrush}" FontSize="22" Margin="0,0,10,0"/><TextBlock Text="Экспедиция завершена" Style="{StaticResource SectionHeaderTextStyle}" FontSize="19" VerticalAlignment="Center"/></StackPanel>
      <TextBlock Text="Обещанная добыча и опыт уже в запасах." Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,10" />
      <UniformGrid Visibility="Collapsed" x:Name="ResultSlots" Columns="3" Margin="0,0,0,12"/><UniformGrid x:Name="ResultRewardCards" Columns="3" Margin="0,0,0,12" Visibility="Collapsed"/><TextBlock x:Name="ResultExtrasText" TextWrapping="Wrap" FontSize="15" /><TextBlock x:Name="ResultText" TextWrapping="Wrap" Visibility="Collapsed" />
     </StackPanel></Border>


    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <StackPanel x:Name="PreparationFooter" Grid.Row="1" Margin="24,0" MaxWidth="968" VerticalAlignment="Top">
   <DockPanel Margin="0,0,0,7">
    <Button x:Name="ChooseTeamButton" Content="Выбрать команду" DockPanel.Dock="Right" Click="ChooseTeam_Click" Style="{StaticResource NdLinkButtonStyle}"/>
    <TextBlock x:Name="TeamHeading" Text="Команда · 0 из 3" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center"/>
   </DockPanel>
   <UniformGrid x:Name="TeamSlots" Columns="3" Margin="0,0,0,8"/>
   <TextBlock x:Name="ContributionsText" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="218"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="PreparationPanel" Margin="0,0,16,0">
     <Grid x:Name="ChoicesGrid"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel x:Name="DifficultyGroup" Margin="0,0,8,8"><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="&#xE713;" Style="{StaticResource NdGlyphStyle}"/><TextBlock Text="Сложность"/></StackPanel>
       <ListBox x:Name="DifficultyBox" SelectionChanged="ChoiceChanged" Style="{StaticResource UiChoiceListStyle}" AutomationProperties.Name="Сложность похода"><ListBoxItem Content="Лёгкая" Tag="easy"/><ListBoxItem Content="Обычная" Tag="normal"/><ListBoxItem Content="Сложная" Tag="hard"/></ListBox>
      </StackPanel>
      <StackPanel x:Name="DurationGroup" Grid.Column="1" Margin="0,0,0,8"><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="&#xE823;" Style="{StaticResource NdGlyphStyle}"/><TextBlock Text="Длительность"/></StackPanel>
       <ListBox x:Name="DurationBox" SelectionChanged="ChoiceChanged" Style="{StaticResource UiChoiceListStyle}" AutomationProperties.Name="Длительность похода"><ListBoxItem Content="30 мин" Tag="30"/><ListBoxItem Content="1,5 ч" Tag="90"/><ListBoxItem Content="3 ч" Tag="180"/><ListBoxItem Content="6 ч" Tag="360"/></ListBox>
      </StackPanel>
     </Grid>
    </StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="StartButton" Content="Отправить команду" Click="StartButton_Click" MinHeight="50"/><TextBlock x:Name="PreviewText" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource CaptionTextStyle}" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource NdBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0"><DockPanel><TextBlock x:Name="LootLabel" Text="Гарантированная добыча:" Foreground="{StaticResource NdMutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/><UniformGrid x:Name="PreviewRewardCards" Columns="3"/></DockPanel></Border>
   </Grid>
  </StackPanel>
  <StackPanel x:Name="ActionFooter" Grid.Row="1" MaxWidth="968" Visibility="Collapsed" Margin="24,10,24,0" VerticalAlignment="Top">
   <Button x:Name="ClaimButton" Content="Забрать находки" Click="ClaimButton_Click" Visibility="Collapsed"/>
   <Button x:Name="CancelButton" Content="Прервать поход" Click="CancelButton_Click" Style="{StaticResource NdDangerOutlineButtonStyle}" Visibility="Collapsed" HorizontalAlignment="Right"/>
   <Button x:Name="ContinueButton" Content="Продолжить" Click="Continue_Click" Visibility="Collapsed"/>
  </StackPanel>
  <Grid x:Name="PickerPanel" Grid.RowSpan="2" MaxWidth="968" Visibility="Collapsed" Margin="24,0" Background="{StaticResource WindowBackgroundBrush}" KeyboardNavigation.TabNavigation="Cycle">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><Image Source="{StaticResource NdBackpackImage}" DockPanel.Dock="Right" Width="100" Height="54" Margin="12,0,0,0"/><StackPanel><TextBlock Text="Команда экспедиции" Style="{StaticResource ScreenTitleTextStyle}"/><TextBlock x:Name="PickerRouteHintText" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,8"/></StackPanel></DockPanel>
   <UniformGrid x:Name="PickerSlots" Grid.Row="1" Columns="3" Margin="0,0,0,10"/>
   <StackPanel Grid.Row="2">
    <TextBox x:Name="PickerSearchBox" Tag="Имя, кличка или номер" MinHeight="34" TextChanged="PickerFilterChanged" AutomationProperties.Name="Имя, кличка или номер" Margin="0,0,0,6"/>
    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <ComboBox x:Name="PickerTypeBox" SelectionChanged="PickerFilterChanged" AutomationProperties.Name="Тип" Margin="0,0,8,0"/>
     <ComboBox x:Name="PickerTraitBox" Grid.Column="1" SelectionChanged="PickerFilterChanged" AutomationProperties.Name="Особенность" Margin="0,0,8,0"/>
     <ComboBox x:Name="PickerSortBox" Grid.Column="2" SelectionChanged="PickerFilterChanged" AutomationProperties.Name="Сортировка команды"><ComboBoxItem Content="Рекомендованные"/><ComboBoxItem Content="Высокий уровень"/><ComboBoxItem Content="Номер"/></ComboBox>
    </Grid>
    <DockPanel Margin="0,0,0,8"><Button x:Name="PickerResetButton" Content="Сбросить" DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Click="PickerReset_Click" MinHeight="28" Padding="10,4"/>
     <StackPanel Orientation="Horizontal"><CheckBox x:Name="PickerAvailableBox" Content="Доступные" IsChecked="True" Checked="PickerFilterChanged" Unchecked="PickerFilterChanged" VerticalAlignment="Center" Margin="0,0,14,0"/>
     <CheckBox x:Name="PickerRouteBox" Content="Подходят маршруту" Checked="PickerFilterChanged" Unchecked="PickerFilterChanged" VerticalAlignment="Center"/></StackPanel>
    </DockPanel>
   </StackPanel>   <ScrollViewer x:Name="PickerScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock x:Name="PickerEmptyText" Text="Никого не нашли. Измените фильтры." Visibility="Collapsed" Margin="0,12"/>
    <WrapPanel x:Name="PickerMembers" />
   </StackPanel></ScrollViewer>
   <Grid Grid.Row="4" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="PickerCountText" FontWeight="Bold" AutomationProperties.LiveSetting="Polite"/><StackPanel Orientation="Horizontal">
     <Button x:Name="PickerPreviousButton" Content="Назад" Style="{StaticResource SecondaryButtonStyle}" Click="PickerPrevious_Click"/><TextBlock x:Name="PickerPageText" Margin="10,0" VerticalAlignment="Center"/><Button x:Name="PickerNextButton" Content="Дальше" Style="{StaticResource SecondaryButtonStyle}" Click="PickerNext_Click"/>
    </StackPanel></StackPanel>
    <Button x:Name="PickerCancelButton" Grid.Column="1" Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Click="PickerCancel_Click" Margin="10,0" MinWidth="90"/>
    <Button x:Name="PickerDoneButton" Grid.Column="2" Content="Готово" Click="PickerDone_Click" MinWidth="110"/>
   </Grid>
  </Grid>
  <local:ConfirmationOverlay Grid.RowSpan="2" x:Name="LocalConfirmation" Visibility="Collapsed"/>
 </Grid>
</UserControl>
