<Window x:Class="PokeCorner.App.Popup.SaveHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История сохранений" Width="660" Height="480"
        Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" MinWidth="480" MinHeight="350" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="История сохранений" Style="{StaticResource ScreenTitleTextStyle}"/>
            <TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>
        <ListBox x:Name="HistoryList" Grid.Row="1" SelectionChanged="SelectionChanged"
                 AutomationProperties.Name="Резервные копии: дата, коллекция, монеты и схема"
                 Background="{StaticResource CardBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                 BorderBrush="{StaticResource SecondaryTextBrush}" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,10"/></Style></ListBox.ItemContainerStyle>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button x:Name="RestoreButton" Content="Восстановить…" Click="Restore_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
