<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PokeCorner.Core\PokeCorner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Frozen v1 chain lookup for existing saves; canonical eligibility comes from RuntimePackage.props. -->
    <Content Include="..\PokeCorner.Core\PokeApi\OfflineStarterFallback.json"
             Link="Data\catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.1.3</Version>
    <AssemblyVersion>1.1.3.0</AssemblyVersion>
    <FileVersion>1.1.3.0</FileVersion>
    <!-- Ships as <InstallDir>\PokeCorner.exe. Nothing hardcodes the file name (restart and
         autostart both use Environment.ProcessPath), so this is purely cosmetic-but-required
         packaging: the shortcut target the user sees should not say "PokeCorner.App". -->
    <AssemblyName>PokeCorner</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Embeds the icon in the exe, which is where WPF takes a Window's default icon from —
         so every window (taskbar button included) gets it without any per-window Icon="…".
         The art is the same pokeball TrayIconService.DrawPlaceholderPokeBallIcon draws. -->
    <ApplicationIcon>PokeCorner.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\docs\design-v2\final\runtime-package.json" Link="Data\final\runtime-package.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="RuntimePackage.props" />
  <ItemGroup><Resource Include="..\..\docs\design-v2\final\assets\shop\evolution-stone.png" Link="Assets\UiSystem\evolution-stone.png" /></ItemGroup>
  <ItemGroup><Resource Include="..\..\docs\design-v2\final\assets\shop\care-booster.png" Link="Assets\UiSystem\care-booster.png"/><Resource Include="..\..\docs\design-v2\final\assets\shop\xp-potion.png" Link="Assets\UiSystem\xp-potion.png"/></ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\docs\design-v2\ui-system\assets\coin.png" Link="Assets\UiSystem\coin.png" />
    <Resource Include="..\..\docs\design-v2\ui-system\assets\care.png" Link="Assets\UiSystem\care.png" />
    <Resource Include="..\..\docs\design-v2\ui-system\assets\treat.png" Link="Assets\UiSystem\treat.png" />
    <Resource Include="..\..\docs\design-v2\ui-system\assets\nursery.png" Link="Assets\UiSystem\nursery.png" />
    <Resource Include="..\..\docs\design-v2\ui-system\assets\nursery-waiting.png" Link="Assets\UiSystem\nursery-waiting.png" />
    <Resource Include="..\..\docs\design-v2\ui-system\assets\nursery-ready.png" Link="Assets\UiSystem\nursery-ready.png" />
    <Resource Include="..\..\docs\design-v2\ui-system\assets\ball-closed.png" Link="Assets\UiSystem\ball-closed.png" />
    <Resource Include="..\..\docs\design-v2\ui-system\assets\ball-open.png" Link="Assets\UiSystem\ball-open.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\NightDiary\*.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
</Project>
