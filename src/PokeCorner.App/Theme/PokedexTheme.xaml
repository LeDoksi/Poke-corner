<!-- PokéCorner native palette: cream paper, forest controls and Nunito. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:theme="clr-namespace:PokeCorner.App.Theme">

    <!-- ===================== Color tokens ===================== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F8F4E9" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#E9E2D3" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EBE7D9" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F8F4E9" />
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#F7F4E8" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#C8C2B3" />

    <SolidColorBrush x:Key="AccentRedBrush" Color="#31694D" />
    <SolidColorBrush x:Key="AccentRedHoverBrush" Color="#24543D" />
    <SolidColorBrush x:Key="AccentGoldBrush" Color="#B17837" />
    <SolidColorBrush x:Key="AccentGoldHoverBrush" Color="#98642D" />
    <!-- Back-compat alias: kept so any XAML still asking for the old key resolves to the
         new gold rather than dangling. New code should use AccentGoldBrush. -->
    <SolidColorBrush x:Key="AccentYellowBrush" Color="#B17837" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#26352D" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#50614F" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#50614F" />
    <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="#D8D7CE" />
    <SolidColorBrush x:Key="OnForestTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#9B3833" />

    <SolidColorBrush x:Key="RarityCommonBrush" Color="#555D66" />
    <SolidColorBrush x:Key="RarityUncommonBrush" Color="#246A48" />
    <SolidColorBrush x:Key="RarityRareBrush" Color="#2A548A" />
    <SolidColorBrush x:Key="RarityLegendaryBrush" Color="#80521B" />

    <!-- ===================== Gradient tokens ===================== -->
    <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#31694D" Offset="0" />
        <GradientStop Color="#2F654D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#367657" Offset="0" />
        <GradientStop Color="#31694D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryButtonPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#24543D" Offset="0" />
        <GradientStop Color="#1E4935" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ProgressGoldBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFD86B" Offset="0" />
        <GradientStop Color="#D9A62A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressRoseBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF7086" Offset="0" />
        <GradientStop Color="#D42840" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressBlueBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7FB4FF" Offset="0" />
        <GradientStop Color="#3D6FCC" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressGreenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6FE7A3" Offset="0" />
        <GradientStop Color="#2FA45E" Offset="1" />
    </LinearGradientBrush>

    <!-- Sits behind the hero sprite: a warm pool of light so the pet reads as "on stage"
         rather than pasted onto a flat panel. -->
    <RadialGradientBrush x:Key="SpotlightBrush" GradientOrigin="0.5,0.55" Center="0.5,0.55" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#40F5C542" Offset="0" />
        <GradientStop Color="#1AE8384F" Offset="0.55" />
        <GradientStop Color="#000D1120" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="HeroCardBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#EEE7D7" Offset="0" />
        <GradientStop Color="#E9E2D3" Offset="1" />
    </LinearGradientBrush>

    <!-- KEYED: every window opts in with Style="{StaticResource AppWindowStyle}". An implicit
         style would do nothing, because WPF matches implicit styles against the EXACT runtime
         type and every window here is a Window SUBCLASS. (The implicit Button/TabItem/ComboBox
         styles below are fine: those elements ARE their exact target type.)
    
         Not applied to OverlayWindow or ProgressPanelWindow: both need a transparent surface. -->
    <Style x:Key="AppWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="{x:Static theme:BundledFont.Family}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- The single-purpose dialogs' chrome: onboarding, starter selection and ConfirmDialog.
         They keep AppWindowStyle's palette but would sit inside the stock OS title bar,
         which is what made them read as foreign next to AppMenuWindow's custom header.

         A shared Style rather than a header strip copied into each of the three windows —
         the strip is identical in all of them, and the only per-window difference is the
         Title, which the template binds.

         Simpler than AppMenuWindow's header on purpose: no minimize/maximize (all three are
         ResizeMode="NoResize"), and no close button either — each of these is dismissed by
         its own buttons (Пропустить / Выбрать / Отмена, plus Esc on ConfirmDialog), so an X
         would be a fourth way to say the same thing.

         WindowChrome, not WindowStyle="None" + AllowsTransparency, for the reason recorded in
         AppMenuWindow.xaml: transparency gives up hardware rendering and correct window
         behaviour. CaptionHeight="36" matches the strip's height and is what makes it draggable
         — the OS treats that band as the caption, so no DragMove handler is needed anywhere.
         ResizeBorderThickness="0" because none of these three resize. -->
    <Style x:Key="DialogWindowStyle" TargetType="Window" BasedOn="{StaticResource AppWindowStyle}">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                              CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{StaticResource WindowBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Same pokéball-plus-wordmark vocabulary as AppMenuWindow's brand
                                 strip, at dialog scale. -->
                            <StackPanel Grid.Row="0" Height="36" Orientation="Horizontal"
                                        Margin="14,0" VerticalAlignment="Center">
                                <Grid Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="{StaticResource AccentRedBrush}" StrokeThickness="2" />
                                    <Border Height="2" Background="{StaticResource AccentRedBrush}" VerticalAlignment="Center" />
                                    <Ellipse Width="6.5" Height="6.5" Fill="{StaticResource WindowBackgroundBrush}"
                                             Stroke="{StaticResource AccentRedBrush}" StrokeThickness="2"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>

                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter />
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Deliberately NO implicit `Style TargetType="TextBlock"` with a Foreground setter.
         Application-level implicit styles also hit the TextBlock that a ContentPresenter
         generates for string content, which would force button/checkbox captions to
         PrimaryText and break SecondaryButtonStyle's muted caption. Foreground is an
         inherited property, so the Window setter above already reaches every TextBlock. -->

    <!-- ===================== Typography helpers ===================== -->
    <Style x:Key="ScreenTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Margin" Value="2,0,0,6" />
    </Style>
    <Style x:Key="StatValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="StatLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style x:Key="MetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    </Style>
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===================== Surfaces ===================== -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="HeroCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{StaticResource HeroCardBrush}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Recessed well: the inverse of a card — used behind sprite thumbnails and stat
         readouts so they read as inset into the card rather than floating on it. -->
    <Style x:Key="WellStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="PillStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ===================== Type badges =====================
         One pill per PokeAPI type, ALWAYS carrying the type's name as text. A colour-only
         swatch was explicitly rejected: rarity gets away with a bare dot because there are
         four tiers, but there are 18 types and nobody reads "Rock" out of a shade of tan.

         Deliberately shaped UNLIKE the rarity pill even though both are PillStyle borders:
         rarity is [dot + label], a type is [label only] in a squarer, thicker-bordered pill.
         Two badge systems sitting on the same card need to differ by more than hue, or the
         type palette and the rarity-tier palette read as one vocabulary at a glance.

         Colours come from TypeDisplay (18 frozen brushes, one per PokeAPI type name) rather
         than from tokens here — see that class for why the external vocabulary lives in code.
         Bound as Foreground AND BorderBrush against the card surface, which keeps all 18
         legible; a filled pill would need per-type light/dark text to stay readable. -->
    <DataTemplate x:Key="TypeBadgeTemplate">
        <Border Style="{StaticResource PillStyle}" BorderThickness="1.4" CornerRadius="5"
                Padding="6,1.5" Margin="0,0,4,3"
                BorderBrush="{Binding Brush}"
                ToolTip="Тип покемона">
            <TextBlock Text="{Binding Label}" FontSize="9.5" FontWeight="SemiBold"
                       Foreground="{Binding Brush}" />
        </Border>
    </DataTemplate>

    <!-- Horizontal, wrapping: a two-type species must never clip its second badge. -->
    <ItemsPanelTemplate x:Key="TypeBadgePanelTemplate">
        <WrapPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!-- ===================== Buttons ===================== -->
    <!-- Unkeyed = the primary/CTA look, so every existing bare <Button Content="…"/> in the
         app keeps reading as the commit action. Ghost/secondary actions opt in explicitly
         via SecondaryButtonStyle. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnForestTextBrush}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#26352D" BlurRadius="9" ShadowDepth="2" Opacity="0.16" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryButtonPressedBrush}" />
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentGoldBrush}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource DisabledSurfaceBrush}" />
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}" />
                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            <Setter Property="Opacity" Value="0.65" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outline/ghost variant for routine-but-not-primary actions (release, skip, back).
         Not BasedOn the implicit style: it needs its own template so it never inherits the
         primary button shadow. -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="11"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.5"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource CardHoverBackgroundBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SecondaryTextBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Custom window chrome ===================== -->
    <!-- Minimize/maximize/close for the hand-drawn title bar that replaces the light OS one.
         Glyphs come from Segoe MDL2 Assets, the font the real Windows title bar uses.
         BorderBrush carries the hover colour, so the close button below needs only a one-line
         override rather than a second copy of this template. -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource CardHoverBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="7"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}" />
    </Style>

    <!-- ===================== Progress bars ===================== -->
    <!-- PART_Track + PART_Indicator are ProgressBar's TemplatePart contract: the control
         itself writes PART_Indicator.Width = PART_Track.ActualWidth * fraction on every
         Value change, so both names must exist and PART_Track must be the full-width
         element. The indicator is left-aligned inside the same Grid cell; the thin
         highlight Border on top of it is a static gloss, not a second progress element. -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ProgressGoldBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" />
                        <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}">
                            <Border CornerRadius="5,5,3,3" VerticalAlignment="Top" Height="3" Margin="2,1,2,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#59FFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Semantic variants. Each re-declares the template so it can carry a glow in its own
         accent color (an Effect's Color can't be TemplateBound from a shared template). -->
    <Style x:Key="CatchProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Foreground" Value="{StaticResource ProgressRoseBrush}" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" />
                        <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}">
                            <Border.Effect>
                                <DropShadowEffect Color="#E8384F" BlurRadius="10" ShadowDepth="0" Opacity="0.65" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EvolutionProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Foreground" Value="{StaticResource ProgressBlueBrush}" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" />
                        <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}">
                            <Border.Effect>
                                <DropShadowEffect Color="#5B9DFF" BlurRadius="10" ShadowDepth="0" Opacity="0.65" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TreatProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Foreground" Value="{StaticResource ProgressGreenBrush}" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" />
                        <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}">
                            <Border.Effect>
                                <DropShadowEffect Color="#4CD787" BlurRadius="10" ShadowDepth="0" Opacity="0.6" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GoldProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Foreground" Value="{StaticResource ProgressGoldBrush}" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" />
                        <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}">
                            <Border.Effect>
                                <DropShadowEffect Color="#F5C542" BlurRadius="10" ShadowDepth="0" Opacity="0.6" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row-level bar inside list cards: no glow (it would repeat once per row) and thinner,
         so it reads as metadata rather than a headline stat. -->
    <Style x:Key="SlimProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Foreground" Value="{StaticResource ProgressBlueBrush}" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
    </Style>


    <!-- ================= Progress concept icons ==================
         Catch / evolution / treat each get a glyph rather than being told apart by colour
         alone. Defined HERE so the desktop ProgressPanelWindow and the in-app "Прогресс" card
         render the SAME one. A ContentControl Style (markup only); the Viewbox lets a call site
         size it with Width/Height, and Foreground carries the tint.
    
         Every glyph is background-INDEPENDENT (nothing knocked out with a surface-coloured
         fill): they render on two different surfaces, and a knockout colour would show as a
         wrong-coloured patch on one of them. -->

    <Style x:Key="ProgressIconStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <!-- Catch: a pokéball. The centre button is a solid dot and the equator is drawn as two
         SEPARATE segments stopping short of it, rather than a full line plus a background-
         coloured knockout circle — same silhouette, no dependency on what's behind it. -->
    <Style x:Key="CatchIconStyle" TargetType="ContentControl" BasedOn="{StaticResource ProgressIconStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="16" Height="16">
                            <Ellipse Width="14.4" Height="14.4" StrokeThickness="1.7"
                                     Stroke="{TemplateBinding Foreground}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Path Fill="{TemplateBinding Foreground}"
                                  Data="M1.4,7.15 L5.3,7.15 L5.3,8.85 L1.4,8.85 Z
                                        M10.7,7.15 L14.6,7.15 L14.6,8.85 L10.7,8.85 Z
                                        M5.6,8 A2.4,2.4 0 1 0 10.4,8 A2.4,2.4 0 1 0 5.6,8 Z" />
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Evolution: a blocky upward arrow — the universal "levelling up" glyph, and legible
         down to the 11px the desktop panel draws it at, where a thin chevron would vanish. -->
    <Style x:Key="EvolutionIconStyle" TargetType="ContentControl" BasedOn="{StaticResource ProgressIconStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="16" Height="16">
                            <Path Fill="{TemplateBinding Foreground}" StrokeLineJoin="Round"
                                  Data="M8,1.2 L15,8.4 L11.3,8.4 L11.3,14.8 L4.7,14.8 L4.7,8.4 L1,8.4 Z" />
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Treat: a cookie. One EvenOdd Path — the chips are counter-wound holes punched out of
         the disc, so they read as chips against whatever surface is behind, with no second
         colour needed. -->
    <Style x:Key="TreatIconStyle" TargetType="ContentControl" BasedOn="{StaticResource ProgressIconStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="16" Height="16">
                            <Path Fill="{TemplateBinding Foreground}"
                                  Data="F0 M1,8 A7,7 0 1 0 15,8 A7,7 0 1 0 1,8 Z
                                        M4.6,6.4 A1.35,1.35 0 1 0 7.3,6.4 A1.35,1.35 0 1 0 4.6,6.4 Z
                                        M9.1,9.5 A1.35,1.35 0 1 0 11.8,9.5 A1.35,1.35 0 1 0 9.1,9.5 Z
                                        M5.7,10.7 A1.1,1.1 0 1 0 7.9,10.7 A1.1,1.1 0 1 0 5.7,10.7 Z
                                        M9.6,4.9 A1.05,1.05 0 1 0 11.7,4.9 A1.05,1.05 0 1 0 9.6,4.9 Z" />
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Filter pills ===================== -->
    <!-- A RadioButton restyled as one of the app's rarity pills: RadioButton already gives
         exactly-one-active-per-GroupName for free, so no mutual-exclusion bookkeeping in
         code-behind. The per-tier color arrives through Tag (a Brush), which is what the dot
         and the checked-state ring both render — one style serves all five pills.
         Two stacked Borders rather than a trigger that rewrites BorderBrush: the accent ring
         needs the Tag brush, and cross-fading opacity keeps the setters binding-free. -->
    <Style x:Key="FilterPillStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="BasePill" CornerRadius="9"
                                Background="{StaticResource WindowBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" />
                        <Border x:Name="AccentRing" CornerRadius="9" Opacity="0"
                                Background="{StaticResource CardHoverBackgroundBrush}"
                                BorderBrush="{TemplateBinding Tag}" BorderThickness="1.5" />
                        <StackPanel Orientation="Horizontal" Margin="9,3">
                            <Ellipse x:Name="Dot" Width="6" Height="6" Opacity="0.5" Margin="0,0,5,0"
                                     VerticalAlignment="Center" Fill="{TemplateBinding Tag}" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BasePill" Property="Background" Value="{StaticResource CardHoverBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="AccentRing" Property="Opacity" Value="1" />
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same pill look as FilterPillStyle, for an independent on/off CheckBox filter rather
         than a mutually-exclusive group — WPF styles are type-exact, so RadioButton's style
         can't be reused for CheckBox. -->
    <Style x:Key="FilterPillCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="BasePill" CornerRadius="9"
                                Background="{StaticResource WindowBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" />
                        <Border x:Name="AccentRing" CornerRadius="9" Opacity="0"
                                Background="{StaticResource CardHoverBackgroundBrush}"
                                BorderBrush="{TemplateBinding Tag}" BorderThickness="1.5" />
                        <StackPanel Orientation="Horizontal" Margin="9,3">
                            <Ellipse x:Name="Dot" Width="6" Height="6" Opacity="0.5" Margin="0,0,5,0"
                                     VerticalAlignment="Center" Fill="{TemplateBinding Tag}" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BasePill" Property="Background" Value="{StaticResource CardHoverBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="AccentRing" Property="Opacity" Value="1" />
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Text input =====================
         The app had no TextBox anywhere until the Pokédex search box and the nickname field,
         so an unstyled one would have rendered as a stock WHITE Win32 box in the middle of a
         screen. Deliberately shaped like FilterPillStyle's BasePill (same recessed
         background, same border brush, same 9px radius) so the search field reads as part of
         the same filter row it sits above, and takes the accent ring on focus the way a
         checked pill does. -->
    <Style x:Key="ThemedTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentGoldBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentGoldBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="9"
                            Background="{StaticResource WindowBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <!-- PART_ContentHost is TextBox's TemplatePart contract: the control
                             hosts its own text rendering inside whatever element carries this
                             name, so a template without it renders permanently blank. -->
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource CardHoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource CardHoverBackgroundBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentGoldBrush}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Star pin on a roster card. Both Fill and Stroke come from the bound card so the same
         single Path covers "pinned" (solid gold) and "not pinned" (hollow, muted outline). -->
    <Style x:Key="FavoriteToggleStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{StaticResource WindowBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="9" Width="30" Height="30">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource CardHoverBackgroundBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentGoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Tabs ===================== -->
    <!-- Full template override, not just Background/Foreground setters — WPF's default
         TabItem chrome renders the selected tab's background from a different internal
         element than a plain Setter can reach, leaving a stray white sliver behind the
         selected header text. Selected state = one step up the surface ladder plus a 3px
         accent rail, which reads as a segmented control rather than a flat filled block. -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="HeaderBorder" Background="Transparent" CornerRadius="10,10,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="SelectionRail" Height="3" CornerRadius="2,2,0,0" Margin="10,0,10,0"
                                VerticalAlignment="Bottom" Background="{StaticResource OnForestTextBrush}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource AccentRedBrush}" />
                            <Setter TargetName="SelectionRail" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource OnForestTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource AccentGoldBrush}" />
                            <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WPF's default TabControl chrome paints its content area with its own system-colour
         (light) background regardless of the Window's. This template removes that and adds the
         header rail: a Surface-tinted strip with a hairline the selected tab's accent bar sits on. -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource SurfaceBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- TabPanel only sizes to fit its items, not the full row width — this
                             Border fills the leftover header-row space behind it so that space
                             isn't left unpainted (defaulting to white) next to the tab buttons. -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" />
                        <TabPanel Grid.Row="0" IsItemsHost="True" Panel.ZIndex="1" Margin="6,6,6,0" />
                        <Border Grid.Row="1" Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== CheckBox ===================== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="19" Height="19" CornerRadius="6" VerticalAlignment="Center"
                                Background="{StaticResource WindowBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.5">
                            <Path x:Name="Check" Visibility="Collapsed" Stretch="Uniform" Margin="4"
                                  Data="M0,5 L4,9 L11,1" Stroke="{StaticResource WindowBackgroundBrush}"
                                  StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SecondaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentRedBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentRedBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Slider ===================== -->
    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse Fill="{StaticResource AccentRedBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#26352D" BlurRadius="8" ShadowDepth="2" Opacity="0.15" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Fill="{StaticResource WindowBackgroundBrush}" Margin="5.5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderFilledRepeatStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                            Background="{StaticResource AccentRedBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderEmptyRepeatStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="6" Background="Transparent" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                Background="{StaticResource WindowBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" />
                        <Track x:Name="PART_Track" Orientation="Horizontal">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFilledRepeatStyle}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderEmptyRepeatStyle}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ScrollBar ===================== -->
    <!-- Minimal overlay-style scrollbar instead of the light Aero one: no arrow buttons, a
         rounded thumb, transparent trough. -->
    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" CornerRadius="4" Margin="3,2"
                            Background="{StaticResource CardBorderBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource SecondaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="11" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="11" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== ToolTip ===================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="MaxWidth" Value="280" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,7">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Opacity="0.5" />
                        </Border.Effect>
                        <!-- A wrapping TextBlock, not a bare ContentPresenter: every tooltip here is a plain string,
                             and ContentPresenter renders a string into a TextBlock that does NOT wrap, so anything
                             longer than ~40 characters was clipped mid-word against the MaxWidth above. -->
                        <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ComboBox ===================== -->
    <!-- Same story as TabControl/TabItem above: ComboBox's default chrome (the closed-box
         display area and the dropdown Popup) paints its own system-color background that a
         plain Background/Foreground Setter can't fully reach, so this settings screen's mode
         picker used system chrome that clashed with the window. Minimal template covering
         just the closed-box display (a ToggleButton-free Border + ContentPresenter, since
         AppSettings' combos are never editable) and the dropdown Popup's ItemsPresenter. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="3,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- IsSelected before IsHighlighted: the later trigger wins when both
                             are true, so hovering the already-selected row still shows the
                             accent-red highlight rather than the quieter selected surface. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentGoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentRedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Foreground and Padding are template-bound onto the ToggleButton on purpose: the stock
                             ButtonBase style sets Foreground to SystemColors.ControlText (black), and that setter
                             outranks the inherited value, so the closed box showed its selection in near-black on
                             the card. -->
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Foreground="{TemplateBinding Foreground}"
                                      Padding="{TemplateBinding Padding}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ClosedBox" Background="{StaticResource CardBackgroundBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                               VerticalAlignment="Center" />
                                            <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="{StaticResource SecondaryTextBrush}"
                                                  Margin="8,0,2,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ClosedBox" Property="Background" Value="{StaticResource CardHoverBackgroundBrush}" />
                                            <Setter TargetName="ClosedBox" Property="BorderBrush" Value="{StaticResource SecondaryTextBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="0,3" Margin="0,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="4" Opacity="0.5" />
                                </Border.Effect>
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
