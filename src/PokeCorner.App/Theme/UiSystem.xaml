<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="UiPaperBrush" Color="#16192B" />
 <SolidColorBrush x:Key="UiForestBrush" Color="#C4ABF0" />
 <SolidColorBrush x:Key="UiInkBrush" Color="#F2ECFC" />
 <SolidColorBrush x:Key="UiSecondaryInkBrush" Color="#B9AECF" />
 <SolidColorBrush x:Key="UiBorderBrush" Color="#41415D" />
 <SolidColorBrush x:Key="UiDangerBrush" Color="#A85060" />
 <BitmapImage x:Key="UiCoinImage" UriSource="/PokeCorner;component/Assets/UiSystem/coin.png" />
 <BitmapImage x:Key="UiNurseryImage" UriSource="/PokeCorner;component/Assets/UiSystem/nursery.png" />
 <BitmapImage x:Key="UiNurseryWaitingImage" UriSource="/PokeCorner;component/Assets/UiSystem/nursery-waiting.png" />
 <BitmapImage x:Key="UiNurseryReadyImage" UriSource="/PokeCorner;component/Assets/UiSystem/nursery-ready.png" />
 <BitmapImage x:Key="UiBallClosedImage" UriSource="/PokeCorner;component/Assets/UiSystem/ball-closed.png" />
 <BitmapImage x:Key="UiBallOpenImage" UriSource="/PokeCorner;component/Assets/UiSystem/ball-open.png" />
 <Style x:Key="UiGreenProgressBarStyle" TargetType="ProgressBar">
  <Setter Property="Height" Value="9"/><Setter Property="Foreground" Value="#C4ABF0"/><Setter Property="Background" Value="#23253C"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid><Border x:Name="PART_Track" CornerRadius="5" Background="{TemplateBinding Background}"/><Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/></Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="UiHeaderButtonStyle" TargetType="Button">
  <Setter Property="MinHeight" Value="40" /><Setter Property="Padding" Value="6" />
  <Setter Property="Foreground" Value="{StaticResource UiSecondaryInkBrush}" />
  <Setter Property="FontWeight" Value="Bold" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2B2D47" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource UiForestBrush}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <DataTemplate x:Key="UiSettingsHeaderTemplate">
  <Grid>
   <Path x:Name="HeaderGear" Width="22" Height="22" Stretch="Uniform" Stroke="{StaticResource UiSecondaryInkBrush}" StrokeThickness="1.8"
        Data="M15 12 A3 3 0 1 1 9 12 A3 3 0 1 1 15 12 M9 3L10 2H14L15 5 18 6 21 7V11L19 12 18 15 19 18 16 21 13 20 10 21 8 22 5 19 6 16 5 13 3 11 4 7 7 6Z" />
   <StackPanel x:Name="HeaderBack" Orientation="Horizontal" Visibility="Collapsed"><Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource UiForestBrush}" StrokeThickness="1.8" Data="M10 2L2 10 10 18 M2 10H21"/><TextBlock Text="Назад" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
  </Grid>
  <DataTemplate.Triggers><DataTrigger Binding="{Binding}" Value="К разделам"><Setter TargetName="HeaderGear" Property="Visibility" Value="Collapsed"/><Setter TargetName="HeaderBack" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
 </DataTemplate>
 <DataTemplate x:Key="UiEncounterHeaderTemplate">
  <StackPanel Orientation="Horizontal">
   <Grid Width="22" Height="22" Margin="0,0,6,0">
    <Ellipse Stroke="{StaticResource UiForestBrush}" StrokeThickness="1.8" Margin="2" />
    <Path Data="M2 11H8 M14 11H20" Stroke="{StaticResource UiForestBrush}" StrokeThickness="1.8" />
    <Ellipse Width="6" Height="6" Stroke="{StaticResource UiForestBrush}" StrokeThickness="1.8" />
   </Grid>
   <TextBlock Text="{Binding}" VerticalAlignment="Center" />
  </StackPanel>
 </DataTemplate>
 <Style x:Key="UiPrimaryButtonStyle" TargetType="Button">
  <Setter Property="MinHeight" Value="48" />
  <Setter Property="Padding" Value="16,9" />
  <Setter Property="FontWeight" Value="Bold" />
  <Setter Property="Foreground" Value="#101426" />
  <Setter Property="Background" Value="#FFB574" />
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFC690" /></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E89E5E" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#F2ECFC" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="#23253C" /><Setter Property="Foreground" Value="#B9AECF" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style x:Key="UiDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource UiPrimaryButtonStyle}">
  <Setter Property="Background" Value="{StaticResource UiDangerBrush}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#B9606F"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#8F4552"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource UiInkBrush}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="#23253C"/><Setter Property="Foreground" Value="#B9AECF"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="UiChoiceListStyle" TargetType="ListBox">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
  <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
  <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter>
  <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
   <Setter Property="Margin" Value="0,5,6,0"/><Setter Property="Padding" Value="10,7"/><Setter Property="MinHeight" Value="36"/><Setter Property="Foreground" Value="{StaticResource UiSecondaryInkBrush}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Surface" Background="Transparent" CornerRadius="9" BorderBrush="{StaticResource UiBorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2B2D47"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource UiForestBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource UiInkBrush}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style></Setter.Value></Setter>
 </Style>
 <Style x:Key="UiContentTabsStyle" TargetType="TabControl">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
   <ContentPresenter ContentSource="SelectedContent" />
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="UiShellTabsStyle" TargetType="TabControl">
  <Style.Resources>
   <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource UiSecondaryInkBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
     <Border x:Name="Surface" CornerRadius="8,8,0,0" Background="Transparent" Padding="8,9">
      <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2B2D47" /></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource UiForestBrush}" /><Setter Property="Foreground" Value="White" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#F2ECFC" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </Style.Resources>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
   <Grid Background="{StaticResource UiPaperBrush}">
    <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource UiBorderBrush}" BorderThickness="0,0,0,1" />
    <UniformGrid IsItemsHost="True" Rows="1" Margin="20,6,20,0" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" />
    <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
