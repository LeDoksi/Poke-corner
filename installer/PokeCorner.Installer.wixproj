<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>PokeCorner</OutputName>
    <OutputType>Package</OutputType>
    <!-- x64 so the harvested components are 64-bit and may legally live under
         ProgramFiles64Folder (C:\Program Files). Without this every component is
         32-bit and ICE80 rejects the package. Matches the win-x64 publish. -->
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Where Product.wxs harvests the app payload from. Must be produced by the
         `dotnet publish` step in installer/README.md BEFORE building this project. -->
    <DefineConstants>PublishDir=$(MSBuildProjectDirectory)\..\publish</DefineConstants>
    <!-- ICE38/43/57 all fire on the same known false positive: they assume a component
         owning a ProgramMenuFolder/DesktopFolder shortcut must be per-USER and therefore
         want an HKCU key path. This package is deliberately perMachine (ALLUSERS=1), where
         those directories resolve to the All Users profile and an HKLM key path is the
         correct choice. Making the ICEs happy would mean shipping per-user shortcuts from
         an elevated per-machine install, which is the actual bug. Verified by installing:
         shortcuts land in the All Users Start Menu / Public Desktop and uninstall cleanly. -->
    <SuppressIces>ICE38;ICE43;ICE57</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <!-- util:PermissionEx, used to make the Data folder writable by standard users. -->
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
